    <!-- Rewards Modal Overlay -->
    <div id="rewardsModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md transform scale-95 modal-content overflow-hidden flex flex-col max-h-[85vh]">
            
            <!-- Modal Header -->
            <div class="bg-orange-50 p-6 flex justify-between items-center border-b border-orange-100">
                <div>
                    <h3 class="text-xl font-bold text-slate-900">Member Rewards</h3>
                    <p class="text-xs font-bold text-orange-600 uppercase tracking-wide mt-1">Balance: <span id="rewardsBalance"><%= user.points || '0' %></span> Pts</p>
                </div>
                <button onclick="toggleModal('rewardsModal')" class="text-slate-400 hover:text-slate-700 bg-white p-2 rounded-full shadow-sm"><i class="ph-bold ph-x"></i></button>
            </div>

            <!-- Modal Body (Scrollable) -->
            <div id="rewardsList" class="p-6 overflow-y-auto space-y-4">
                <p id="rewardsLoading" class="text-sm text-slate-500 text-center">Loading rewards...</p>
            </div>
            </div>
            
            <!-- modal footer removed per user request -->
        </div>
    </div>

    <script type="application/json" id="tx-data"><%- JSON.stringify(transactions || []) %></script>
        <!-- Wallet Transactions Modal -->
        <div id="walletTransactionsModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
            <div class="bg-white rounded-[1rem] shadow-2xl w-full max-w-3xl transform scale-95 modal-content overflow-hidden max-h-[80vh]">
                <div class="flex items-center justify-between p-4 border-b border-slate-100">
                    <h3 class="text-lg font-bold">All Wallet Transactions</h3>
                    <button onclick="toggleModal('walletTransactionsModal')" class="text-slate-400 hover:text-slate-700 p-2 rounded-full"><i class="ph-bold ph-x"></i></button>
                </div>
                <div class="p-4 overflow-y-auto" style="max-height:60vh">
                    <div id="walletTxContainer" class="space-y-2">
                        <!-- transactions will be rendered here -->
                    </div>
                </div>
                <div class="p-4 border-t border-slate-100 bg-slate-50 flex items-center justify-center">
                    <div id="walletTxPagination" class="flex gap-2 items-center"></div>
                </div>
            </div>
        </div>
    <script>
        // Set Current Date
        const dateOptions = { weekday: 'short', month: 'short', day: 'numeric' };
        document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', dateOptions);

        // Toggle Modal Logic (smoother)
        function toggleModal(modalID){
            const modal = document.getElementById(modalID);
            if(!modal) return;
            const content = modal.querySelector('.modal-content');
            const open = !modal.classList.contains('hidden');

            if(!open){
                modal.classList.remove('hidden');
                // allow browser to apply layout
                requestAnimationFrame(()=>{
                    modal.classList.remove('opacity-0');
                    if(content){ content.style.transform = 'translateY(0) scale(1)'; content.style.opacity = '1'; }
                    document.body.classList.add('modal-open');
                    // if opening rewards modal, fetch latest rewards and balance
                    try{ if(modalID === 'rewardsModal' && typeof fetchRewards === 'function') fetchRewards(); }catch(e){/*ignore*/}
                });
            } else {
                modal.classList.add('opacity-0');
                if(content){ content.style.transform = 'translateY(6px) scale(.98)'; content.style.opacity = '0'; }
                document.body.classList.remove('modal-open');
                setTimeout(()=> modal.classList.add('hidden'), 300);
            }
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.id === 'topupModal') {
                toggleModal('topupModal');
            }
            if (event.target.id === 'rewardsModal') {
                toggleModal('rewardsModal');
            }
            if (event.target.id === 'walletTransactionsModal') {
                toggleModal('walletTransactionsModal');
            }
        }

        // Small helpers for top-up modal and 3D card modal
        function updatePresetButtons(selectedVal){
            const presets = [20,50,100];
            presets.forEach(v => {
                const btn = document.querySelector('button[data-amount="' + v + '"]');
                if(!btn) return;
                if(Number(selectedVal) === v){
                    btn.classList.remove('border-slate-200','text-slate-600');
                    btn.classList.add('border-fresh-500','bg-fresh-50','text-fresh-700','border-2','shadow-sm');
                } else {
                    btn.classList.remove('border-fresh-500','bg-fresh-50','text-fresh-700','border-2','shadow-sm');
                    btn.classList.add('border-slate-200','text-slate-600');
                }
            });
        }

        function setAmount(val){
            const el = document.getElementById('topupAmount');
            const preview = document.getElementById('confirmAmount');
            const numeric = Number(val) || 0;
            if(el){ el.value = numeric.toFixed(2); }
            if(preview){ preview.textContent = numeric.toFixed(2); }
            updatePresetButtons(numeric);
        }

        // when user types a custom amount, clear presets unless it's exact match
        (function attachTopupAmountInput(){
            const el = document.getElementById('topupAmount');
            if(!el) return;
            el.addEventListener('input', function(){
                const v = Number(el.value) || 0;
                const presets = [20,50,100];
                if(presets.includes(Math.round(v)) || presets.includes(v)){
                    // if it matches a preset exactly (allow integer), highlight it
                    updatePresetButtons(v);
                } else {
                    // clear selections
                    updatePresetButtons(null);
                }
                const preview = document.getElementById('confirmAmount');
                if(preview) preview.textContent = (Number(el.value) ? Number(el.value).toFixed(2) : '0.00');
            });

            // initialize preset button state from input's current value
            const initial = Number(el.value) || null;
            updatePresetButtons(initial);
            // ensure preview shows initial amount
            const preview = document.getElementById('confirmAmount');
            if(preview) preview.textContent = (initial ? Number(initial).toFixed(2) : '0.00');
        })();

        // Select a provider (make button active) but don't submit immediately
        function selectProvider(method){
            const input = document.getElementById('payment_method_input');
            const providers = ['paypal','nets','stripe'];
            providers.forEach(p => {
                const btn = document.getElementById('provider-' + p);
                if(!btn) return;
                if(p === method){
                    btn.classList.remove('border-slate-200','text-slate-600');
                    btn.classList.add('border-fresh-500','bg-fresh-50','text-fresh-700');
                } else {
                    btn.classList.remove('border-fresh-500','bg-fresh-50','text-fresh-700');
                    btn.classList.add('border-slate-200','text-slate-600');
                }
            });
            if(input) input.value = method;
        }

        // Validate provider selected on form submit, otherwise prevent
        (function attachTopupValidation(){
            const form = document.getElementById('topupForm');
            if(!form) return;
            form.addEventListener('submit', function(e){
                const method = document.getElementById('payment_method_input')?.value || '';
                if(!method){
                    e.preventDefault();
                    alert('Please choose a payment provider (PayPal, NETS, or Stripe) before confirming.');
                    return false;
                }
                // Optionally disable the submit button to prevent double-submit
                const btn = form.querySelector('button[type="submit"]');
                if(btn){ btn.disabled = true; btn.classList.add('opacity-60','cursor-not-allowed'); }
                return true;
            });
        })();

        // open/close handlers for the 3D card modal referenced by the page
        function openCardModal(){
            const modal = document.getElementById('card3DModal');
            if(!modal) return;
            modal.classList.remove('hidden');
            setTimeout(()=> modal.classList.remove('opacity-0'), 10);
        }

        function closeCardModal(){
            const modal = document.getElementById('card3DModal');
            if(!modal) return;
            modal.classList.add('opacity-0');
            setTimeout(()=> modal.classList.add('hidden'), 300);
        }

        // Initialize Simple Chart using real transactions data
        (function(){
            const txs = JSON.parse(document.getElementById('tx-data')?.textContent || '[]');
            const days = 7;
            const now = new Date();
            const labels = [];
            const dataPoints = new Array(days).fill(0);

            // build labels = last 7 days (oldest -> newest)
            for (let i = days - 1; i >= 0; i--) {
                const d = new Date(now);
                d.setDate(now.getDate() - i);
                labels.push(d.toLocaleDateString(undefined, { weekday: 'short' }));
            }

            // accumulate spending amounts (PAYMENT) into buckets
            txs.forEach(tx => {
                const created = new Date(tx.createdAt || tx.created_at || tx.created_at);
                if (isNaN(created)) return;
                const diffDays = Math.floor((now - created) / (1000 * 60 * 60 * 24));
                if (diffDays < 0 || diffDays >= days) return;
                const idx = days - 1 - diffDays; // map diff to index
                const amt = Number(tx.amount || 0) || 0;
                // count only payments as spending; treat TOP_UP as income (ignore)
                if (String(tx.type || '').toUpperCase() === 'PAYMENT') dataPoints[idx] += Math.abs(amt);
            });

            const ctx = document.getElementById('spendingChart').getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 150);
            gradient.addColorStop(0, 'rgba(34, 197, 94, 0.35)');
            gradient.addColorStop(1, 'rgba(34, 197, 94, 0.02)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Spending',
                        data: dataPoints,
                        borderColor: '#22c55e',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#22c55e',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        fill: true,
                        tension: 0.36
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { backgroundColor: '#1e293b', padding: 10, cornerRadius: 8, displayColors: false }
                    },
                    animation: { duration: 900, easing: 'easeOutQuart' },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#94a3b8' } },
                        y: { display: true, grid: { display: false }, beginAtZero: true }
                    }
                }
            });
        })();

        // Wallet 'View All' pagination and modal
        (function(){
            const btn = document.getElementById('walletViewAllBtn');
            const modalId = 'walletTransactionsModal';
            const container = document.getElementById('walletTxContainer');
            const paginationEl = document.getElementById('walletTxPagination');

            if(!btn) return;

            btn.addEventListener('click', async function(){
                toggleModal(modalId);
                await loadPage(1);
            });

            async function loadPage(page){
                const per = 5;
                try{
                    const resp = await fetch('/api/wallet/transactions?page=' + page + '&per=' + per, { credentials: 'same-origin' });
                    if(!resp.ok) throw new Error('Failed to fetch');
                    const payload = await resp.json();
                    renderTransactions(payload.transactions || []);
                    renderPagination(Math.max(1, Math.ceil((payload.total || 0) / per)), page);
                }catch(err){
                    container.innerHTML = '<p class="text-sm text-slate-500">Unable to load transactions.</p>';
                    paginationEl.innerHTML = '';
                    console.error('wallet.tx.load', err);
                }
            }

            function renderTransactions(txns){
                if(!txns || !txns.length){
                    container.innerHTML = '<p class="text-sm text-slate-500">No transactions found.</p>';
                    return;
                }
                container.innerHTML = '';
                // create elements but animate them in with a small stagger for premium feel
                txns.forEach((tx, idx) => {
                    const div = document.createElement('div');
                    div.className = 'tx-item flex items-center justify-between group hover:bg-slate-50 p-3 -mx-3 rounded-2xl transition-all border border-transparent hover:border-slate-100 card-elevated';
                    const left = document.createElement('div');
                    const title = document.createElement('p');
                    title.className = 'text-sm font-bold text-slate-900';
                    title.textContent = tx.description || tx.type || 'Transaction';
                    const meta = document.createElement('p');
                    meta.className = 'text-xs text-slate-500';
                    const date = new Date(tx.createdAt || tx.created_at || Date.now());
                    meta.textContent = date.toLocaleString() + (tx.reference_id ? ' • Ref: ' + tx.reference_id : '');
                    left.appendChild(title);
                    left.appendChild(meta);

                    const right = document.createElement('div');
                    right.className = 'text-right';
                    const amt = Number(tx.amount || 0);
                    const isTopUp = String(tx.type || '').toUpperCase() === 'TOP_UP';
                    const p = document.createElement('p');
                    p.className = 'text-sm font-bold ' + (isTopUp ? 'text-green-600' : 'text-rose-600');
                    p.textContent = (isTopUp ? '+' : '-') + '$' + Math.abs(amt).toFixed(2);
                    right.appendChild(p);

                    div.appendChild(left);
                    div.appendChild(right);
                    container.appendChild(div);

                    // staggered enter
                    window.requestAnimationFrame(()=>{
                        setTimeout(()=> div.classList.add('enter'), idx * 60);
                    });
                });
            }

            function renderPagination(totalPages, active){
                paginationEl.innerHTML = '';
                if(totalPages <= 1) return;

                // previous
                const prev = document.createElement('button');
                prev.className = 'px-3 py-1 rounded bg-white border';
                prev.textContent = 'Prev';
                prev.disabled = active <= 1;
                prev.onclick = () => loadPage(Math.max(1, active - 1));
                paginationEl.appendChild(prev);

                // numbered pages (limit to 7 buttons)
                const maxButtons = 7;
                let start = Math.max(1, active - Math.floor(maxButtons/2));
                let end = Math.min(totalPages, start + maxButtons - 1);
                if(end - start + 1 < maxButtons) start = Math.max(1, end - maxButtons + 1);

                for(let i = start; i <= end; i++){
                    const b = document.createElement('button');
                    b.className = 'px-3 py-1 rounded ' + (i === active ? 'bg-fresh-600 text-white' : 'bg-white border');
                    b.textContent = String(i);
                    b.onclick = () => loadPage(i);
                    paginationEl.appendChild(b);
                }

                // next
                const next = document.createElement('button');
                next.className = 'px-3 py-1 rounded bg-white border';
                next.textContent = 'Next';
                next.disabled = active >= totalPages;
                next.onclick = () => loadPage(Math.min(totalPages, active + 1));
                paginationEl.appendChild(next);
            }
        })();
    </script>

    <script>
        // Apply loyalty progress widths (set from server-side data attribute)
        document.addEventListener('DOMContentLoaded', function(){
            document.querySelectorAll('.loyalty-progress').forEach(function(el){
                var v = Number(el.getAttribute('data-progress') || 0);
                el.style.width = Math.max(0, Math.min(100, v)) + '%';
            });
        });
    </script>

    <script>
        // Rewards modal: fetch list and redeem
        async function fetchRewards(){
            const container = document.getElementById('rewardsList');
            const loading = document.getElementById('rewardsLoading');
            if(loading) loading.textContent = 'Loading rewards...';
            try{
                const resp = await fetch('/api/loyalty/rewards', { credentials: 'same-origin' });
                if(!resp.ok) throw new Error('Failed to fetch rewards');
                const payload = await resp.json();
                const points = (payload.points != null) ? payload.points : (payload.user && payload.user.points) || 0;
                const rewards = payload.rewards || [];
                const rb = document.getElementById('rewardsBalance'); if(rb) rb.textContent = Number(points).toLocaleString();
                const main = document.getElementById('loyaltyPointsValue'); if(main) main.textContent = Number(points).toLocaleString();
                renderRewards(rewards, points);
            }catch(err){
                console.error('fetchRewards', err);
                if(loading) loading.textContent = 'Unable to load rewards.';
                if(container) container.innerHTML = '<p class="text-sm text-slate-500 text-center">Unable to load rewards.</p>';
            }
        }

        function renderRewards(rewards, points){
            const container = document.getElementById('rewardsList');
            if(!container) return;
            container.innerHTML = '';
            if(!rewards || rewards.length === 0){
                container.innerHTML = '<p class="text-sm text-slate-500 text-center">No active rewards.</p>';
                return;
            }
            rewards.forEach(r => {
                const cost = Number(r.cost || r.points_cost || r.points || 0);
                const item = document.createElement('div');
                item.className = 'flex items-center gap-4 p-4 border border-slate-100 rounded-2xl hover:border-orange-200 hover:bg-orange-50/30 transition-colors group';

                const iconWrap = document.createElement('div');
                iconWrap.className = 'w-12 h-12 rounded-xl flex items-center justify-center text-2xl flex-shrink-0';
                // choose icon and color by reward type or provided icon
                const iconType = (r.icon || r.type || (r.slug || '')).toString().toLowerCase();
                let iconClass = 'ph-fill ph-gift';
                let bgClass = 'bg-slate-100 text-slate-700';
                if(iconType.includes('delivery') || iconType.includes('truck')){ iconClass = 'ph-fill ph-truck'; bgClass = 'bg-blue-100 text-blue-600'; }
                else if(iconType.includes('wallet') || iconType.includes('credit')){ iconClass = 'ph-fill ph-wallet'; bgClass = 'bg-fresh-100 text-fresh-600'; }
                else if(iconType.includes('off') || iconType.includes('discount') || iconType.includes('tag')){ iconClass = 'ph-fill ph-tag'; bgClass = 'bg-orange-100 text-orange-600'; }
                else if(iconType.includes('platinum') || iconType.includes('crown') || iconType.includes('status')){ iconClass = 'ph-fill ph-crown'; bgClass = 'bg-purple-100 text-purple-600'; }
                iconWrap.className += ' ' + bgClass;
                iconWrap.innerHTML = '<i class="' + iconClass + '"></i>';

                const info = document.createElement('div');
                info.className = 'flex-1';
                const title = document.createElement('h4');
                title.className = 'font-bold text-slate-900 text-sm';
                title.textContent = r.title || r.name || 'Reward';
                const desc = document.createElement('p');
                desc.className = 'text-xs text-slate-500';
                desc.textContent = r.description || '';
                info.appendChild(title); info.appendChild(desc);

                const btn = document.createElement('button');
                btn.className = 'px-4 py-2 rounded-lg text-xs font-bold transition-colors';
                btn.textContent = Number(cost).toLocaleString() + ' Pts';
                if(cost > Number(points)){
                    btn.classList.add('bg-slate-200','text-slate-400','cursor-not-allowed');
                    btn.disabled = true;
                } else {
                    btn.classList.add('bg-slate-900','text-white');
                    btn.addEventListener('click', function(){ redeemReward(r.id, btn); });
                }

                item.appendChild(iconWrap);
                item.appendChild(info);
                item.appendChild(btn);
                container.appendChild(item);
            });
        }

        async function redeemReward(rewardId, btn){
            if(!confirm('Claim this reward now?')) return;
            btn.disabled = true; const orig = btn.textContent; btn.textContent = 'Processing...';
            try{
                const resp = await fetch('/api/loyalty/redeem', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rewardId })
                });
                const payload = await resp.json();
                if(!resp.ok){
                    alert(payload.message || 'Unable to redeem reward.');
                    btn.disabled = false; btn.textContent = orig; return;
                }
                // update balances displayed
                const newPts = payload.points != null ? payload.points : payload.newPoints;
                if(newPts != null){
                    const rb = document.getElementById('rewardsBalance'); if(rb) rb.textContent = Number(newPts).toLocaleString();
                    const main = document.getElementById('loyaltyPointsValue'); if(main) main.textContent = Number(newPts).toLocaleString();
                }
                alert(payload.message || 'Reward claimed!');
                await fetchRewards();
            }catch(err){
                console.error('redeemReward', err);
                alert('Unable to redeem reward at this time.');
                btn.disabled = false; btn.textContent = orig;
            }
        }
    </script>

</body>
</html>