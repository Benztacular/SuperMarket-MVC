<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My FreshWallet | Dashboard</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Chart.js for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        fresh: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        }
                    },
                    animation: {
                        'spin-slow': 'spin 3s linear infinite',
                        'enter-card': 'enterCard 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards',
                    },
                    keyframes: {
                        enterCard: {
                            '0%': { transform: 'scale(0.5) rotateY(-180deg)', opacity: '0' },
                            '100%': { transform: 'scale(1) rotateY(0deg)', opacity: '1' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        .credit-card-gradient {
            background: linear-gradient(135deg, #16a34a 0%, #14532d 100%);
        }
        
        /* Smooth modal transition */
        :root{
            --primary: #16a34a;
            --primary-600: #16a34a;
            --glass: rgba(255,255,255,0.6);
            --card-shadow: 0 10px 30px rgba(20,20,20,0.08);
            --soft-shadow: 0 6px 20px rgba(16,24,40,0.06);
        }

        .modal-content {
            transition: transform 280ms cubic-bezier(.2,.9,.3,1), opacity 220ms linear;
            transform-origin: center top;
            will-change: transform, opacity;
        }

        /* Modal backdrop smoother */
        .fixed.inset-0.bg-slate-900\/40 {
            transition: background-color 300ms ease, opacity 300ms ease;
            backdrop-filter: blur(6px);
        }

        /* 3D Card Styles */
        .perspective-container {
            perspective: 1000px;
        }
        
        .card-3d-wrapper {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.1s; /* Quick response for mouse movement */
        }
        
        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            border-radius: 2rem;
            overflow: hidden;
        }

        .card-back {
            transform: rotateY(180deg);
            background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
        }

        .is-flipped {
            transform: rotateY(180deg) !important;
            transition: transform 0.6s !important;
        }

        /* Shine Effect */
        .shine {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0) 60%, rgba(255,255,255,0) 100%);
            z-index: 20;
            pointer-events: none;
        }

        /* Transactions list - smoother hover and entrance */
        .tx-item{ opacity: 0; transform: translateY(6px) scale(.995); transition: transform 320ms cubic-bezier(.2,.9,.3,1), opacity 220ms ease; }
        .tx-item.enter{ opacity: 1; transform: translateY(0) scale(1); }

        /* Polished buttons */
        .btn-primary{ background: linear-gradient(180deg,var(--primary-600), #14532d); color: white; box-shadow: 0 8px 24px rgba(22,83,42,0.12); }
        .card-elevated{ box-shadow: var(--card-shadow); }

        /* Credit-card styles */
        .card-chip{ width:48px; height:36px; border-radius:6px; background: linear-gradient(180deg,#ffd27a,#ffb84d); box-shadow: inset 0 -3px 6px rgba(0,0,0,0.06); }
        .card-number{ letter-spacing:4px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, 'Roboto Mono', 'Segoe UI Mono', monospace; font-size:1.05rem; }
        .card-logo{ width:58px; height:34px; border-radius:8px; background: rgba(255,255,255,0.12); display:inline-flex; align-items:center; justify-content:center; }
        
        /* Premium Membership Badge Styles */
        @keyframes shimmer {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }
        
        .membership-badge-shimmer {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                90deg,
                transparent 0%,
                rgba(255, 255, 255, 0.15) 45%,
                rgba(255, 255, 255, 0.25) 50%,
                rgba(255, 255, 255, 0.15) 55%,
                transparent 100%
            );
            background-size: 200% 100%;
            animation: shimmer 3s linear infinite;
            pointer-events: none;
            border-radius: 2rem;
        }
        
        .membership-badge-glow {
            box-shadow: 
                0 10px 40px rgba(0, 0, 0, 0.2),
                0 0 0 1px rgba(255, 255, 255, 0.1),
                inset 0 1px 0 rgba(255, 255, 255, 0.2),
                inset 0 -1px 0 rgba(0, 0, 0, 0.1);
        }
        
        .membership-tier-icon {
            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen p-4 md:p-8">

    <!-- HEADER -->
    <%- include('partials/header', { 
        user: (typeof user !== 'undefined' ? user : null), 
        cartCount: (typeof cartCount !== 'undefined' ? cartCount : 0), 
        isAdmin: (typeof isAdmin !== 'undefined' ? isAdmin : false),
        messages: (typeof messages !== 'undefined' ? messages : {}) 
    }) %>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto">

        <!-- Content Grid -->
        <div class="space-y-6">
            
            <!-- Welcome Row -->
            <div class="flex items-center justify-between">
                <h1 class="text-2xl font-bold text-slate-900">Overview</h1>
                <p class="text-sm font-medium text-slate-500 bg-white px-3 py-1 rounded-lg border border-slate-200 shadow-sm" id="currentDate">Oct 24, 2023</p>
            </div>

            <!-- Top Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Main Wallet Card (credit-card style) -->
                <div class="col-span-1 md:col-span-2 credit-card-gradient rounded-[2rem] p-6 text-white shadow-2xl shadow-fresh-900/20 relative overflow-hidden group min-h-[220px] transform transition-transform hover:scale-[1.01] hover:shadow-fresh-900/30">
                    <!-- Decorative Circles -->
                    <div class="absolute -right-8 -top-8 w-56 h-56 bg-white/8 rounded-full blur-3xl"></div>
                    <div class="absolute -left-8 -bottom-8 w-44 h-44 bg-black/8 rounded-full blur-2xl"></div>

                    <div class="absolute inset-0 bg-gradient-to-b from-black/0 to-black/5 opacity-40 pointer-events-none"></div>

                    <div class="relative z-10">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="card-chip"></div>
                                <div>
                                    <div class="text-xs text-fresh-100 font-medium opacity-90 uppercase">FreshMart Wallet</div>
                                    <div class="text-[11px] text-white/80">
                                        <% 
                                        const memberTier = (membership || 'Free').toLowerCase();
                                        const tierBadge = memberTier.includes('freshplus') ? '💎 FreshPlus Member' : 
                                                         memberTier.includes('standard') ? '⭐ Standard Member' : 
                                                         '🌱 Free Account';
                                        %>
                                        <%= tierBadge %>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="card-logo"><i class="ph-fill ph-wallet text-lg"></i></div>
                            </div>
                        </div>

                        <div class="mt-6">
                            <p class="text-fresh-100 text-xs font-medium mb-1 opacity-90 uppercase">Total Balance</p>
                            <h2 class="text-5xl font-bold tracking-tight">$<%= (wallet && wallet.balance != null) ? Number(wallet.balance).toFixed(2) : '0.00' %></h2>
                        </div>

                        <div class="mt-6 flex items-center justify-between">
                            <div>
                                <div class="card-number text-white/95">•••• •••• •••• <%= (user && user.cardLast4) ? user.cardLast4 : '6769' %></div>
                                <div class="flex items-center gap-6 mt-3 text-sm">
                                    <div>
                                        <p class="text-xs text-white/75 uppercase">Card Holder</p>
                                        <p class="font-medium uppercase"><%= user.username || 'User' %></p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-white/75 uppercase">Expires</p>
                                        <p class="font-medium"><%= user.cardExp || '09/34' %></p>
                                    </div>
                                </div>
                            </div>

                            <div class="flex-shrink-0">
                                <div onclick="toggleModal('topupModal')" role="button" tabindex="0" class="px-4 py-2 rounded-lg btn-primary cursor-pointer select-none">
                                    <i class="ph-bold ph-plus-circle mr-2"></i> Add Money
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Points & Rewards Card -->
                <% 
                const loyaltyTier = (loyalty && loyalty.tier) ? String(loyalty.tier).toLowerCase() : 'bronze';
                const isBronze = loyaltyTier === 'bronze';
                const isSilver = loyaltyTier === 'silver';
                const isGold = loyaltyTier === 'gold';
                
                // Tier-specific styling (namespaced to avoid collisions)
                const loyaltyTierGradient = isGold ? 'bg-gradient-to-br from-yellow-500 via-amber-400 to-yellow-600' : 
                                    isSilver ? 'bg-gradient-to-br from-slate-400 via-gray-300 to-slate-500' : 
                                    'bg-gradient-to-br from-orange-700 via-amber-600 to-orange-800';
                const loyaltyTierIcon = isGold ? 'ph-crown' : isSilver ? 'ph-medal' : 'ph-shield';
                const loyaltyTierBgColor = isGold ? 'bg-yellow-50' : isSilver ? 'bg-slate-50' : 'bg-orange-50';
                const loyaltyTierTextColor = isGold ? 'text-yellow-700' : isSilver ? 'text-slate-700' : 'text-orange-700';
                const loyaltyTierAccent = isGold ? 'text-yellow-600' : isSilver ? 'text-slate-600' : 'text-orange-600';
                const loyaltyProgressColor = isGold ? 'bg-gradient-to-r from-yellow-500 to-amber-500' : 
                                     isSilver ? 'bg-gradient-to-r from-slate-400 to-gray-500' : 
                                     'bg-gradient-to-r from-orange-600 to-amber-600';
                const nextTierName = isBronze ? 'Silver' : isSilver ? 'Gold' : 'Max Tier';
                %>
                
                <div class="bg-white rounded-[2rem] p-6 border border-slate-200 shadow-lg hover:shadow-xl transition-all relative overflow-hidden group">
                    <!-- Decorative gradient corner -->
                    <div class="absolute top-0 right-0 w-48 h-48 <%= loyaltyTierGradient %> rounded-bl-[100%] opacity-10 -z-0 blur-2xl"></div>
                    <div class="absolute -top-6 -right-6 w-32 h-32 <%= loyaltyTierGradient %> rounded-full opacity-5"></div>

                    <div class="relative z-10">
                        <!-- Header with tier badge -->
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <div class="w-10 h-10 rounded-xl <%= loyaltyTierGradient %> flex items-center justify-center text-white shadow-lg">
                                    <i class="ph-fill <%= loyaltyTierIcon %> text-xl"></i>
                                </div>
                                <div>
                                    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Loyalty Points</span>
                                </div>
                            </div>
                            <div class="px-3 py-1 rounded-full <%= loyaltyTierBgColor %> border-2 border-current/10">
                                <span class="text-xs font-bold <%= loyaltyTierTextColor %> uppercase tracking-wide"><%= (loyalty && loyalty.tier) ? loyalty.tier : 'Bronze' %></span>
                            </div>
                        </div>

                        <!-- Points display -->
                        <div class="mb-4">
                            <h3 class="text-4xl font-bold <%= loyaltyTierAccent %> mb-1"><span id="loyaltyPointsValue"><%= (loyalty && loyalty.points != null) ? Number(loyalty.points).toLocaleString() : '0' %></span></h3>
                            <p class="text-sm font-medium text-slate-500">Total Points Earned</p>
                        </div>

                        <!-- Progress section -->
                        <div class="space-y-3">
                            <div class="flex items-center justify-between text-xs font-bold">
                                <div class="flex items-center gap-1.5">
                                    <div class="w-2 h-2 rounded-full <%= loyaltyTierGradient %>"></div>
                                    <span class="text-slate-600"><%= (loyalty && loyalty.tier) ? loyalty.tier : 'Bronze' %> Tier</span>
                                </div>
                                <% if (!isGold) { %>
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-slate-400">Next:</span>
                                        <span class="<%= loyaltyTierAccent %>"><%= nextTierName %></span>
                                        <span class="text-slate-400">(<%= (loyalty && loyalty.nextThreshold) ? Number(loyalty.nextThreshold).toLocaleString() : '5,000' %>)</span>
                                    </div>
                                <% } else { %>
                                    <span class="text-yellow-600 flex items-center gap-1">
                                        <i class="ph-fill ph-check-circle"></i>
                                        Max Tier Achieved
                                    </span>
                                <% } %>
                            </div>
                            
                            <% const progressWidth = (loyalty && typeof loyalty.progress === 'number') ? loyalty.progress : 0; %>
                            <div class="relative">
                                <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden shadow-inner">
                                    <div class="<%= loyaltyProgressColor %> h-3 rounded-full loyalty-progress shadow-sm transition-all duration-500" data-progress="<%= progressWidth %>"></div>
                                </div>
                                <div class="absolute -top-1 left-0 w-full flex justify-between px-1 pointer-events-none">
                                    <div class="w-1 h-5 bg-slate-300 rounded-full"></div>
                                    <% if (!isGold) { %>
                                        <div class="w-1 h-5 bg-slate-300 rounded-full"></div>
                                    <% } %>
                                </div>
                            </div>

                            <div class="text-[11px] text-slate-500 text-center font-medium">
                                <% if (!isGold) { %>
                                    <%= Math.max(0, (loyalty.nextThreshold || 5000) - (loyalty.points || 0)).toLocaleString() %> points to <%= nextTierName %>
                                <% } else { %>
                                    You've reached the highest tier!
                                <% } %>
                            </div>
                        </div>

                        <!-- Action button -->
                        <div class="mt-4">
                            <button onclick="toggleModal('rewardsModal')" class="w-full py-3 <%= loyaltyTierGradient %> text-white rounded-xl font-bold text-sm shadow-lg hover:shadow-xl transition-all active:scale-95 flex items-center justify-center gap-2">
                                <i class="ph-fill ph-gift"></i>
                                <span>View Rewards</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lower Section -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Recent Transactions -->
                <div class="lg:col-span-2 bg-white rounded-[2rem] border border-slate-200 shadow-sm p-8">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-lg font-bold text-slate-900">Recent Transactions</h3>
                        <button id="walletViewAllBtn" class="text-sm font-semibold text-fresh-600 hover:text-fresh-700 hover:bg-fresh-50 px-3 py-1 rounded-lg transition-colors">View All</button>
                    </div>

                    <div class="space-y-2">
                        <% if (transactions && transactions.length > 0) { %>
                            <% transactions.forEach(function(txn) { %>
                                <div class="flex items-center justify-between group hover:bg-slate-50 p-3 -mx-3 rounded-2xl transition-all cursor-pointer border border-transparent hover:border-slate-100">
                                    <div>
                                        <p class="text-sm font-bold text-slate-900"><%= txn.description || txn.type || 'Transaction' %></p>
                                        <p class="text-xs text-slate-500"><%= new Date(txn.createdAt || txn.created_at).toLocaleString() %> <% if(txn.reference_id){ %>• Ref: <%= txn.reference_id %><% } %></p>
                                    </div>
                                    <div class="text-right">
                                        <% const amt = Number(txn.amount || 0); %>
                                        <% const isTopUp = String(txn.type || '').toUpperCase() === 'TOP_UP'; %>
                                        <p class="text-sm font-bold <%= isTopUp ? 'text-green-600' : 'text-rose-600' %>"><%= (isTopUp ? '+' : '-') %>$<%= Math.abs(amt).toFixed(2) %></p>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-slate-400 text-sm text-center py-4">No recent transactions found.</p>
                        <% } %>
                    </div>
                </div>

                <!-- Right Column: Methods & Chart -->
                <div class="space-y-6">
                    <!-- Premium Membership Badge Card -->
                    <% 
                    const membershipLower = (membership || 'Free').toLowerCase();
                    const isFreshPlus = membershipLower.includes('freshplus');
                    const isStandard = membershipLower.includes('standard');
                    const isFree = !isFreshPlus && !isStandard;
                    
                    // Tier-specific styling
                    const bgGradient = isFreshPlus ? 'bg-gradient-to-br from-amber-600 via-yellow-500 to-amber-700' : 
                                      isStandard ? 'bg-gradient-to-br from-blue-600 via-indigo-500 to-blue-700' : 
                                      'bg-gradient-to-br from-slate-600 via-slate-500 to-slate-700';
                    const tierIcon = isFreshPlus ? 'ph-crown' : isStandard ? 'ph-star' : 'ph-leaf';
                    const tierName = isFreshPlus ? 'FreshPlus' : isStandard ? 'Standard' : 'Free';
                    const tierTagline = isFreshPlus ? 'Premium Membership' : isStandard ? 'Standard Benefits' : 'Basic Access';
                    %>
                    
                    <div class="<%= bgGradient %> membership-badge-glow rounded-[2rem] shadow-2xl p-6 text-white relative overflow-hidden transform transition-all hover:scale-[1.02] hover:shadow-2xl">
                        <!-- Shimmer Effect -->
                        <div class="membership-badge-shimmer"></div>
                        
                        <!-- Decorative Elements -->
                        <div class="absolute -right-12 -top-12 w-48 h-48 bg-white/10 rounded-full blur-3xl"></div>
                        <div class="absolute -left-8 -bottom-8 w-32 h-32 bg-black/10 rounded-full blur-2xl"></div>
                        
                        <!-- Badge Content -->
                        <div class="relative z-10">
                            <!-- Header -->
                            <div class="flex items-center justify-between mb-6">
                                <div class="flex items-center gap-2">
                                    <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center membership-tier-icon">
                                        <i class="ph-fill <%= tierIcon %> text-2xl"></i>
                                    </div>
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest opacity-90 font-bold">Membership</div>
                                        <div class="text-xs font-medium opacity-75"><%= tierTagline %></div>
                                    </div>
                                </div>
                                <% if (isFreshPlus) { %>
                                    <div class="px-3 py-1 rounded-full bg-white/20 backdrop-blur-sm border border-white/30 animate-pulse">
                                        <span class="text-[10px] font-bold uppercase tracking-wider">RECOMMENDED</span>
                                    </div>
                                <% } %>
                            </div>
                            
                            <!-- Tier Name -->
                            <div class="mb-6">
                                <h2 class="text-3xl font-bold tracking-tight mb-1"><%= tierName %></h2>
                                <div class="flex items-center gap-2">
                                    <div class="h-1 w-12 bg-white/40 rounded-full"></div>
                                    <div class="h-1 w-6 bg-white/25 rounded-full"></div>
                                </div>
                            </div>
                            
                            <!-- Benefits Preview -->
                            <div class="space-y-2 mb-6 text-sm">
                                <% if (isFreshPlus) { %>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-fill ph-check-circle text-white/90"></i>
                                        <span class="opacity-90">Unlimited Free Standard Delivery</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-fill ph-check-circle text-white/90"></i>
                                        <span class="opacity-90">$5 Off Priority Delivery</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-fill ph-check-circle text-white/90"></i>
                                        <span class="opacity-90">2.5x LinkPoints on every order</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-fill ph-check-circle text-white/90"></i>
                                        <span class="opacity-90">5% discount on all orders</span>
                                    </div>
                                <% } else if (isStandard) { %>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-fill ph-check-circle text-white/90"></i>
                                        <span class="opacity-90">Free delivery above $40</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-fill ph-check-circle text-white/90"></i>
                                        <span class="opacity-90">1x LinkPoints on every order</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-fill ph-check-circle text-white/90"></i>
                                        <span class="opacity-90">2% discount on orders above $30</span>
                                    </div>
                                <% } else { %>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-fill ph-check-circle text-white/90"></i>
                                        <span class="opacity-90">0.25x LinkPoints on every order</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-fill ph-check-circle text-white/90"></i>
                                        <span class="opacity-90">Free delivery above $80</span>
                                    </div>
                                <% } %>
                            </div>
                            
                            <!-- Action Button -->
                            <% if (!isFreshPlus) { %>
                                <button onclick="window.location.href='/wallet/membership/upgrade'" class="w-full py-3 bg-white/20 hover:bg-white/30 backdrop-blur-sm border border-white/30 rounded-xl font-bold text-sm transition-all active:scale-95 flex items-center justify-center gap-2">
                                    <i class="ph-bold ph-arrow-up-right"></i>
                                    <span>Upgrade to <%= isStandard ? 'FreshPlus' : 'Premium' %></span>
                                </button>
                            <% } else { %>
                                <button onclick="window.location.href='/wallet/membership/manage'" class="w-full py-3 bg-white/20 hover:bg-white/30 backdrop-blur-sm border border-white/30 rounded-xl font-bold text-sm transition-all active:scale-95 flex items-center justify-center gap-2">
                                    <i class="ph-bold ph-gear"></i>
                                    <span>Manage Membership</span>
                                </button>
                            <% } %>
                        </div>
                    </div>

                    <!-- Spending Chart -->
                    <div class="bg-white rounded-[2rem] border border-slate-200 shadow-sm p-6">
                         <div class="flex items-center justify-between mb-2">
                             <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wide">Spending</h3>
                             <span class="text-xs font-bold text-red-500 bg-red-50 px-2 py-0.5 rounded-md">+12%</span>
                         </div>
                         <div class="h-32">
                             <canvas id="spendingChart"></canvas>
                         </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- 3D Card Expanded Modal -->
    <div id="card3DModal" class="fixed inset-0 bg-slate-900/90 backdrop-blur-md z-[60] hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        <button onclick="closeCardModal()" class="absolute top-8 right-8 text-white/50 hover:text-white transition-colors z-[70]">
            <i class="ph-bold ph-x text-4xl"></i>
        </button>
        
        <div class="w-full max-w-xl aspect-[1.586/1] perspective-container cursor-pointer" id="tiltContainer">
            <div id="interactiveCard" class="card-3d-wrapper relative" onclick="flipCard(event)">
                
