    <!-- Top Up Modal Overlay -->
    <div id="topupModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
                <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md transform scale-95 modal-content overflow-hidden">
            
            <!-- Modal Header -->
            <div class="bg-white p-6 pb-2 flex justify-between items-center">
                <h3 class="text-xl font-bold text-slate-900">Add Money</h3>
                <button onclick="toggleModal('topupModal')" class="text-slate-400 hover:text-slate-700 bg-slate-100 hover:bg-slate-200 p-2 rounded-full transition-colors"><i class="ph-bold ph-x"></i></button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 pt-2">
                <form action="/wallet/topup" method="post" id="topupForm">
                    <p class="text-sm text-slate-500 mb-4">Instantly top up your FreshWallet using your linked method.</p>

                    <div class="grid grid-cols-3 gap-3 mb-4">
                        <button type="button" data-amount="20" onclick="setAmount(20)" class="py-3 rounded-2xl border border-slate-200 font-bold text-slate-600 hover:border-fresh-500 hover:bg-fresh-50 hover:text-fresh-700 transition-all active:scale-95">$20</button>
                        <button type="button" data-amount="50" onclick="setAmount(50)" class="py-3 rounded-2xl border-2 border-fresh-500 bg-fresh-50 font-bold text-fresh-700 active:scale-95 shadow-sm">$50</button>
                        <button type="button" data-amount="100" onclick="setAmount(100)" class="py-3 rounded-2xl border border-slate-200 font-bold text-slate-600 hover:border-fresh-500 hover:bg-fresh-50 hover:text-fresh-700 transition-all active:scale-95">$100</button>
                    </div>

                    <div class="relative mb-4">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-xl font-bold text-slate-400">$</span>
                        <input id="topupAmount" name="amount" type="number" step="0.01" class="w-full bg-slate-50 border-transparent hover:bg-slate-100 focus:bg-white border-2 focus:border-fresh-500 rounded-2xl py-4 pl-8 pr-4 text-xl font-bold text-slate-900 focus:outline-none transition-all placeholder:text-slate-300" placeholder="Custom" value="50.00">
                    </div>

                    <div class="mb-4">
                        <label class="text-xs font-bold text-slate-500 uppercase mb-2 block">Pay From</label>
