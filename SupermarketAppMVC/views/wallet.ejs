<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My FreshWallet | Dashboard</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Chart.js for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        fresh: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        }
                    },
                    animation: {
                        'spin-slow': 'spin 3s linear infinite',
                        'enter-card': 'enterCard 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards',
                    },
                    keyframes: {
                        enterCard: {
                            '0%': { transform: 'scale(0.5) rotateY(-180deg)', opacity: '0' },
                            '100%': { transform: 'scale(1) rotateY(0deg)', opacity: '1' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        .credit-card-gradient {
            background: linear-gradient(135deg, #16a34a 0%, #14532d 100%);
        }
        
        /* Smooth modal transition */
        .modal-content {
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        /* 3D Card Styles */
        .perspective-container {
            perspective: 1000px;
        }
        
        .card-3d-wrapper {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.1s; /* Quick response for mouse movement */
        }
        
        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            border-radius: 2rem;
            overflow: hidden;
        }

        .card-back {
            transform: rotateY(180deg);
            background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
        }

        .is-flipped {
            transform: rotateY(180deg) !important;
            transition: transform 0.6s !important;
        }

        /* Shine Effect */
        .shine {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0) 60%, rgba(255,255,255,0) 100%);
            z-index: 20;
            pointer-events: none;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen p-4 md:p-8">

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto">

        <!-- Content Grid -->
        <div class="space-y-6">
            
            <!-- Welcome Row -->
            <div class="flex items-center justify-between">
                <h1 class="text-2xl font-bold text-slate-900">Overview</h1>
                <p class="text-sm font-medium text-slate-500 bg-white px-3 py-1 rounded-lg border border-slate-200 shadow-sm" id="currentDate">Oct 24, 2023</p>
            </div>

            <!-- Top Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Main Wallet Card (Clickable Trigger) -->
                <div onclick="openCardModal()" class="col-span-1 md:col-span-2 credit-card-gradient rounded-[2rem] p-8 text-white shadow-2xl shadow-fresh-900/20 relative overflow-hidden group min-h-[220px] flex flex-col justify-between cursor-pointer transform transition-transform hover:scale-[1.01] hover:shadow-fresh-900/30">
                    <!-- Decorative Circles -->
                    <div class="absolute -right-10 -top-10 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
                    <div class="absolute -left-10 -bottom-10 w-48 h-48 bg-black/10 rounded-full blur-2xl"></div>
                    
                    <!-- Click hint overlay -->
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors z-0"></div>
                    <div class="absolute top-4 right-4 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 z-20">
                        <i class="ph-bold ph-arrows-out-simple"></i> Expand
                    </div>

                    <div class="relative z-10 flex justify-between items-start">
                        <div>
                            <p class="text-fresh-100 text-sm font-medium mb-1 opacity-80">Total Balance</p>
                            <h2 class="text-5xl font-bold tracking-tight">$<%= user.balance || '0.00' %></h2>
                        </div>
                        <div class="bg-white/20 backdrop-blur-md p-2.5 rounded-xl border border-white/10">
                            <i class="ph-fill ph-wallet text-2xl"></i>
                        </div>
                    </div>
                    
                    <div class="relative z-10 flex items-end justify-between mt-6">
                        <div class="flex gap-3 pointer-events-none">
                            <div class="bg-white text-fresh-800 px-5 py-2.5 rounded-xl text-sm font-bold shadow-lg flex items-center gap-2">
                                <i class="ph-bold ph-plus-circle"></i> Add Money
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-fresh-200 uppercase tracking-wider mb-1">Card Holder</p>
                            <p class="font-mono font-medium tracking-widest text-lg uppercase"><%= user.name || 'User' %></p>
                        </div>
                    </div>
                </div>

                <!-- Points & Rewards Card -->
                <div class="bg-white rounded-[2rem] p-6 border border-slate-200 shadow-sm flex flex-col justify-between relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-40 h-40 bg-orange-50 rounded-bl-[100%] -z-0"></div>
                    
                    <div class="relative z-10">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="w-8 h-8 rounded-full bg-orange-100 flex items-center justify-center text-orange-500">
                                <i class="ph-fill ph-star text-lg"></i>
                            </div>
                            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Loyalty Points</span>
                        </div>
                        <h3 class="text-3xl font-bold text-slate-900 mt-2"><%= user.points || '0' %></h3>
                        <p class="text-sm text-slate-500">FreshMart Rewards</p>
                    </div>

                    <div class="relative z-10 mt-6">
                        <div class="flex justify-between text-xs font-bold text-slate-400 mb-1">
                            <span>Silver</span>
                            <span class="text-orange-500">Gold</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2 mb-4 overflow-hidden">
                            <div class="bg-orange-500 h-2 rounded-full" style="width: 85%"></div>
                        </div>
                        <button onclick="toggleModal('rewardsModal')" class="w-full py-2.5 border-2 border-orange-100 bg-orange-50/50 rounded-xl text-sm font-bold text-orange-600 hover:bg-orange-100 hover:border-orange-200 transition-all active:scale-95">
                            View Rewards
                        </button>
                    </div>
                </div>
            </div>

            <!-- Lower Section -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Recent Transactions -->
                <div class="lg:col-span-2 bg-white rounded-[2rem] border border-slate-200 shadow-sm p-8">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-lg font-bold text-slate-900">Recent Transactions</h3>
                        <button class="text-sm font-semibold text-fresh-600 hover:text-fresh-700 hover:bg-fresh-50 px-3 py-1 rounded-lg transition-colors">View All</button>
                    </div>

                    <div class="space-y-2">
                        <% if (transactions && transactions.length > 0) { %>
                            <% transactions.forEach(function(txn) { %>
                                <div class="flex items-center justify-between group hover:bg-slate-50 p-3 -mx-3 rounded-2xl transition-all cursor-pointer border border-transparent hover:border-slate-100">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-2xl bg-<%= txn.color %>-50 text-<%= txn.color %>-600 flex items-center justify-center text-xl shadow-sm border border-<%= txn.color %>-100">
                                            <i class="ph-fill <%= txn.icon %>"></i>
                                        </div>
                                        <div>
                                            <p class="text-sm font-bold text-slate-900"><%= txn.title %></p>
                                            <p class="text-xs text-slate-500"><%= txn.date %> <% if(txn.id) { %>• <%= txn.id %><% } %></p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-bold <%= txn.type === 'income' ? 'text-green-600' : 'text-slate-900' %>"><%= txn.amount %></p>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-slate-400 text-sm text-center py-4">No recent transactions found.</p>
                        <% } %>
                    </div>
                </div>

                <!-- Right Column: Methods & Chart -->
                <div class="space-y-6">
                    <!-- Linked Card -->
                    <div class="bg-white rounded-[2rem] border border-slate-200 shadow-sm p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wide">Linked Method</h3>
                            <button class="text-fresh-600 hover:bg-fresh-50 p-1.5 rounded-lg transition-colors"><i class="ph-bold ph-gear"></i></button>
                        </div>
                        
                        <div class="bg-slate-900 text-white p-5 rounded-2xl shadow-lg relative overflow-hidden mb-4 group cursor-pointer transition-transform hover:scale-[1.02]">
                            <div class="absolute right-0 top-0 h-24 w-24 bg-white/5 rounded-full blur-2xl"></div>
                            <div class="flex justify-between items-start mb-6">
                                <i class="ph-fill ph-bank text-white/70 text-2xl"></i>
                                <span class="font-bold italic text-white/90">VISA</span>
                            </div>
                            <div class="text-lg font-mono tracking-widest mb-1 text-shadow">•••• 4242</div>
                            <div class="flex justify-between text-[10px] text-slate-400 uppercase tracking-wider font-bold">
                                <span>Debit</span>
                                <span>09/25</span>
                            </div>
                        </div>
                        
                        <button class="w-full py-2.5 border border-dashed border-slate-300 rounded-xl text-sm font-bold text-slate-500 hover:border-fresh-500 hover:text-fresh-600 hover:bg-fresh-50 transition-all flex items-center justify-center gap-2">
                            <i class="ph-bold ph-plus"></i> Add New Card
                        </button>
                    </div>

                    <!-- Spending Chart -->
                    <div class="bg-white rounded-[2rem] border border-slate-200 shadow-sm p-6">
                         <div class="flex items-center justify-between mb-2">
                             <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wide">Spending</h3>
                             <span class="text-xs font-bold text-red-500 bg-red-50 px-2 py-0.5 rounded-md">+12%</span>
                         </div>
                         <div class="h-32">
                             <canvas id="spendingChart"></canvas>
                         </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- 3D Card Expanded Modal -->
    <div id="card3DModal" class="fixed inset-0 bg-slate-900/90 backdrop-blur-md z-[60] hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        <button onclick="closeCardModal()" class="absolute top-8 right-8 text-white/50 hover:text-white transition-colors z-[70]">
            <i class="ph-bold ph-x text-4xl"></i>
        </button>
        
        <div class="w-full max-w-xl aspect-[1.586/1] perspective-container cursor-pointer" id="tiltContainer">
            <div id="interactiveCard" class="card-3d-wrapper relative" onclick="flipCard(event)">
                
                <!-- Front Face -->
                <div class="card-face credit-card-gradient text-white shadow-2xl p-10 flex flex-col justify-between border border-white/10 relative">
                    <div class="shine"></div>
                    
                    <!-- Decorative BG -->
                    <div class="absolute -right-20 -top-20 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="absolute -left-20 -bottom-20 w-60 h-60 bg-black/10 rounded-full blur-2xl pointer-events-none"></div>

                    <!-- Top Row -->
                    <div class="flex justify-between items-start relative z-10">
                        <div class="flex items-center gap-3">
                            <div class="bg-white/20 p-2 rounded-lg backdrop-blur-sm">
                                <i class="ph-fill ph-plant text-3xl"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-xl tracking-wide">FreshMart</h3>
                                <p class="text-xs text-fresh-100 uppercase tracking-wider">Wallet</p>
                            </div>
                        </div>
                        <i class="ph-fill ph-contactless-payment text-4xl opacity-80"></i>
                    </div>

                    <!-- Chip & Number -->
                    <div class="relative z-10">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-14 h-10 bg-gradient-to-br from-yellow-200 to-yellow-500 rounded-lg border border-yellow-600/30 flex items-center justify-center">
                                <div class="w-full h-[1px] bg-yellow-600/40 my-1 absolute top-1/2 -translate-y-1/2"></div>
                                <div class="h-full w-[1px] bg-yellow-600/40 mx-1 absolute left-1/2 -translate-x-1/2"></div>
                            </div>
                            <i class="ph-bold ph-wifi-high rotate-90 text-2xl opacity-60"></i>
                        </div>
                        <h2 class="font-mono text-3xl md:text-4xl font-medium tracking-widest text-shadow-sm">
                            <%= user.cardNumber || '0000 0000 0000 0000' %>
                        </h2>
                    </div>

                    <!-- Bottom Info -->
                    <div class="flex justify-between items-end relative z-10">
                        <div>
                            <p class="text-[10px] text-fresh-200 uppercase tracking-widest mb-1">Card Holder</p>
                            <p class="font-mono text-lg font-medium tracking-wider uppercase"><%= user.name || 'User' %></p>
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] text-fresh-200 uppercase tracking-widest mb-1">Expires</p>
                            <p class="font-mono text-lg font-medium tracking-wider"><%= user.cardExp || '00/00' %></p>
                        </div>
                    </div>
                </div>

                <!-- Back Face -->
                <div class="card-face card-back text-white shadow-2xl flex flex-col justify-between py-8 border border-white/5 relative">
                    
                    <!-- Magnetic Strip -->
                    <div class="w-full h-14 bg-black mt-4"></div>

                    <div class="px-8 relative z-10">
                        <div class="flex justify-between items-center mb-2">
                             <p class="text-[10px] text-slate-400 max-w-[200px] leading-tight">
                                This card is issued by FreshMart Financial Services. Use of this card is subject to the cardholder agreement.
                             </p>
                        </div>
                        
                        <!-- Signature & CVV -->
                        <div class="flex items-center gap-4">
                            <div class="h-10 flex-1 bg-white/10 flex items-center px-4 font-handwriting text-slate-300 italic">
                                <%= user.name || 'Sign Here' %>
                            </div>
                            <div class="h-10 w-16 bg-white text-slate-900 font-mono font-bold flex items-center justify-center text-lg italic rounded-sm">
                                482
                            </div>
                        </div>
                        <p class="text-[10px] text-slate-400 text-right mt-1 uppercase tracking-wider">CVV / CVC</p>
                    </div>

                    <div class="px-8 flex justify-between items-end">
                        <div class="flex items-center gap-2">
                             <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center">
                                 <i class="ph-fill ph-globe text-xl text-slate-400"></i>
                             </div>
                             <div>
                                 <p class="text-[10px] text-slate-400">Customer Support</p>
                                 <p class="text-xs font-bold">+1-800-FRESH-PAY</p>
                             </div>
                        </div>
                        <i class="ph-fill ph-qr-code text-4xl text-slate-500"></i>
                    </div>
                </div>

            </div>
            
            <p class="text-white/40 text-center mt-12 animate-pulse text-sm font-medium tracking-wide">
                <i class="ph-bold ph-mouse-simple"></i> Move mouse to tilt • Click to flip
            </p>
        </div>
    </div>

    <!-- Top Up Modal Overlay -->
    <div id="topupModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md transform scale-95 modal-content overflow-hidden">
            
            <!-- Modal Header -->
            <div class="bg-white p-6 pb-2 flex justify-between items-center">
                <h3 class="text-xl font-bold text-slate-900">Add Money</h3>
                <button onclick="toggleModal('topupModal')" class="text-slate-400 hover:text-slate-700 bg-slate-100 hover:bg-slate-200 p-2 rounded-full transition-colors"><i class="ph-bold ph-x"></i></button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 pt-2">
                <p class="text-sm text-slate-500 mb-6">Instantly top up your FreshWallet using your linked method.</p>
                
                <div class="grid grid-cols-3 gap-3 mb-6">
                    <button class="py-3 rounded-2xl border border-slate-200 font-bold text-slate-600 hover:border-fresh-500 hover:bg-fresh-50 hover:text-fresh-700 transition-all active:scale-95">$20</button>
                    <button class="py-3 rounded-2xl border-2 border-fresh-500 bg-fresh-50 font-bold text-fresh-700 active:scale-95 shadow-sm">$50</button>
                    <button class="py-3 rounded-2xl border border-slate-200 font-bold text-slate-600 hover:border-fresh-500 hover:bg-fresh-50 hover:text-fresh-700 transition-all active:scale-95">$100</button>
                </div>

                <div class="relative mb-6">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-xl font-bold text-slate-400">$</span>
                    <input type="number" class="w-full bg-slate-50 border-transparent hover:bg-slate-100 focus:bg-white border-2 focus:border-fresh-500 rounded-2xl py-4 pl-8 pr-4 text-xl font-bold text-slate-900 focus:outline-none transition-all placeholder:text-slate-300" placeholder="Custom" value="50.00">
                </div>

                <div class="flex items-center justify-between p-3 border border-slate-200 rounded-2xl mb-8 cursor-pointer hover:border-fresh-500 hover:bg-fresh-50/30 transition-colors group">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-7 bg-slate-800 rounded-lg flex items-center justify-center text-white text-[10px] font-bold shadow-sm">VISA</div>
                        <div class="flex flex-col">
                            <span class="text-xs font-bold text-slate-500 uppercase">From</span>
                            <span class="text-sm font-bold text-slate-900">Chase Debit **** 4242</span>
                        </div>
                    </div>
                    <i class="ph-bold ph-caret-down text-slate-400 group-hover:text-fresh-600"></i>
                </div>

                <button class="w-full bg-fresh-600 hover:bg-fresh-700 text-white py-4 rounded-2xl font-bold text-lg shadow-xl shadow-fresh-500/20 transition-all transform active:scale-[0.98] flex items-center justify-center gap-2">
                    <i class="ph-bold ph-check-circle"></i> Confirm & Add $50.00
                </button>
            </div>
        </div>
    </div>

    <!-- Rewards Modal Overlay -->
    <div id="rewardsModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md transform scale-95 modal-content overflow-hidden flex flex-col max-h-[85vh]">
            
            <!-- Modal Header -->
            <div class="bg-orange-50 p-6 flex justify-between items-center border-b border-orange-100">
                <div>
                    <h3 class="text-xl font-bold text-slate-900">Member Rewards</h3>
                    <p class="text-xs font-bold text-orange-600 uppercase tracking-wide mt-1">Balance: <%= user.points || '0' %> Pts</p>
                </div>
                <button onclick="toggleModal('rewardsModal')" class="text-slate-400 hover:text-slate-700 bg-white p-2 rounded-full shadow-sm"><i class="ph-bold ph-x"></i></button>
            </div>

            <!-- Modal Body (Scrollable) -->
            <div class="p-6 overflow-y-auto space-y-4">
                
                <!-- Reward Item -->
                <div class="flex items-center gap-4 p-4 border border-slate-100 rounded-2xl hover:border-orange-200 hover:bg-orange-50/30 transition-colors group">
                    <div class="w-12 h-12 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center text-2xl flex-shrink-0">
                        <i class="ph-fill ph-tag"></i>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-900 text-sm">$5 Off Fresh Produce</h4>
                        <p class="text-xs text-slate-500">Min. spend $30</p>
                    </div>
                    <button class="bg-slate-900 text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-fresh-600 transition-colors">
                        500 Pts
                    </button>
                </div>

                <!-- Reward Item -->
                <div class="flex items-center gap-4 p-4 border border-slate-100 rounded-2xl hover:border-orange-200 hover:bg-orange-50/30 transition-colors group">
                    <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-2xl flex-shrink-0">
                        <i class="ph-fill ph-truck"></i>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-900 text-sm">Free Delivery Voucher</h4>
                        <p class="text-xs text-slate-500">Valid for 30 days</p>
                    </div>
                    <button class="bg-slate-900 text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-fresh-600 transition-colors">
                        1,200 Pts
                    </button>
                </div>

                <!-- Reward Item -->
                <div class="flex items-center gap-4 p-4 border border-slate-100 rounded-2xl hover:border-orange-200 hover:bg-orange-50/30 transition-colors group">
                    <div class="w-12 h-12 rounded-xl bg-fresh-100 text-fresh-600 flex items-center justify-center text-2xl flex-shrink-0">
                        <i class="ph-fill ph-wallet"></i>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-900 text-sm">$20 Wallet Credit</h4>
                        <p class="text-xs text-slate-500">Auto-added to balance</p>
                    </div>
                    <button class="bg-slate-900 text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-fresh-600 transition-colors">
                        2,500 Pts
                    </button>
                </div>

                 <!-- Reward Item -->
                 <div class="flex items-center gap-4 p-4 border border-slate-100 rounded-2xl hover:border-orange-200 hover:bg-orange-50/30 transition-colors group opacity-60">
                    <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-2xl flex-shrink-0">
                        <i class="ph-fill ph-crown"></i>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-900 text-sm">Platinum Status (1 Year)</h4>
                        <p class="text-xs text-slate-500">2x points on all orders</p>
                    </div>
                    <button class="bg-slate-200 text-slate-400 px-4 py-2 rounded-lg text-xs font-bold cursor-not-allowed">
                        20,000 Pts
                    </button>
                </div>

            </div>
            
            <div class="p-4 border-t border-slate-100 bg-slate-50">
                <button onclick="toggleModal('rewardsModal')" class="w-full py-3 text-sm font-bold text-slate-500 hover:text-slate-800 transition-colors">Close Rewards</button>
            </div>
        </div>
    </div>

    <script>
        // Set Current Date
        const dateOptions = { weekday: 'short', month: 'short', day: 'numeric' };
        document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', dateOptions);

        // Toggle Modal Logic
        function toggleModal(modalID){
            const modal = document.getElementById(modalID);
            // Use class selector to find the inner content div
            const content = modal.querySelector('.modal-content');
            
            if(modal.classList.contains('hidden')){
                modal.classList.remove('hidden');
                // Small delay to allow display:block to apply before opacity transition
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    content.classList.remove('scale-95');
                    content.classList.add('scale-100');
                }, 10);
            } else {
                modal.classList.add('opacity-0');
                content.classList.remove('scale-100');
                content.classList.add('scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            }
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.id === 'topupModal') {
                toggleModal('topupModal');
            }
            if (event.target.id === 'rewardsModal') {
                toggleModal('rewardsModal');
            }
        }

        // --- 3D CARD ANIMATION LOGIC ---

        function openCardModal() {
            const modal = document.getElementById('card3DModal');
            const card = document.getElementById('interactiveCard');
            
            modal.classList.remove('hidden');
            
            // Add entry animation class
            card.style.animation = 'enterCard 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards';

            setTimeout(() => {
                modal.classList.remove('opacity-0');
                // Remove animation after it's done so we can tilt manually
                setTimeout(() => {
                    card.style.animation = 'none';
                }, 1000);
            }, 10);
        }

        function closeCardModal() {
            const modal = document.getElementById('card3DModal');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                // Reset flip state
                document.getElementById('interactiveCard').classList.remove('is-flipped');
                document.getElementById('interactiveCard').style.transform = 'rotateY(0deg) rotateX(0deg)';
            }, 300);
        }

        function flipCard(event) {
            // Prevent flip if dragging (optional refinement, but simple click is fine here)
            const card = document.getElementById('interactiveCard');
            card.classList.toggle('is-flipped');
        }

        // Tilt Logic
        const container = document.getElementById('tiltContainer');
        const card = document.getElementById('interactiveCard');

        container.addEventListener('mousemove', (e) => {
            // If flipped, don't do the tilt logic to prevent confusion or complex math
            if(card.classList.contains('is-flipped')) return;

            const rect = container.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            // Calculate center
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            // Calculate rotation (max 20 degrees)
            const rotateX = ((y - centerY) / centerY) * -20; 
            const rotateY = ((x - centerX) / centerX) * 20;

            card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        container.addEventListener('mouseleave', () => {
            if(card.classList.contains('is-flipped')) return;
            card.style.transform = `rotateX(0deg) rotateY(0deg)`;
        });

        // --- END 3D LOGIC ---

        // Initialize Simple Chart
        const ctx = document.getElementById('spendingChart').getContext('2d');
        // Gradient for chart
        const gradient = ctx.createLinearGradient(0, 0, 0, 150);
        gradient.addColorStop(0, 'rgba(34, 197, 94, 0.5)'); // fresh-500
        gradient.addColorStop(1, 'rgba(34, 197, 94, 0.0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['M', 'T', 'W', 'T', 'F', 'S', 'S'],
                datasets: [{
                    label: 'Spending',
                    data: [12, 45, 22, 18, 65, 80, 40],
                    borderColor: '#22c55e',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#22c55e',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        padding: 10,
                        titleFont: { family: '"Plus Jakarta Sans", sans-serif' },
                        bodyFont: { family: '"Plus Jakarta Sans", sans-serif' },
                        cornerRadius: 8,
                        displayColors: false
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 10, family: '"Plus Jakarta Sans", sans-serif' }, color: '#94a3b8' }
                    },
                    y: {
                        display: false,
                        grid: { display: false },
                        min: 0
                    }
                }
            }
        });
    </script>
</body>
</html>