                            <button id="provider-stripe" type="button" onclick="selectProvider('stripe')" class="w-full py-3 rounded-2xl border border-slate-200 font-bold text-slate-600 hover:border-fresh-500 hover:bg-fresh-50 hover:text-fresh-700 transition-all active:scale-95 flex items-center justify-center gap-3">
                                <img src="/images/stripe-logo.png" alt="Stripe" class="h-6" onerror="this.style.display='none'" />
