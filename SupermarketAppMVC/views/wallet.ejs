                    <button type="submit" class="w-full bg-fresh-600 hover:bg-fresh-700 text-white py-4 rounded-2xl font-bold text-lg shadow-xl shadow-fresh-500/20 transition-all transform active:scale-[0.98] flex items-center justify-center gap-2">
                        <i class="ph-bold ph-check-circle"></i> Confirm & Add $<span id="confirmAmount">50.00</span>
                    </button>
