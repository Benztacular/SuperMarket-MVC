<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirm Membership</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #f0fdf4 0%, #d1fae5 100%);
      min-height: 100vh;
    }

    .plan-card {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      position: relative;
      overflow: hidden;
    }

    .plan-card::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
      animation: pulse 3s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 0.5; }
      50% { transform: scale(1.1); opacity: 0.8; }
    }

    .payment-btn {
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .payment-btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }

    .payment-btn:hover::before {
      width: 300px;
      height: 300px;
    }

    .payment-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    .payment-btn:active {
      transform: translateY(0);
    }

    .feature-item {
      display: flex;
      align-items: start;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .feature-item:last-child {
      border-bottom: none;
    }

    .checkmark {
      width: 20px;
      height: 20px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .secure-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 8px;
      font-size: 0.875rem;
      color: #166534;
      margin-top: 20px;
    }

    .payment-card {
      background: white;
      border: 2px solid transparent;
      transition: all 0.3s ease;
    }

    .payment-card:hover {
      border-color: #10b981;
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.1);
    }

    .price-tag {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      border-radius: 12px;
      padding: 20px;
      margin: 20px 0;
    }

    @media (max-width: 768px) {
      .plan-card {
        margin-bottom: 24px;
      }
    }
  </style>
</head>
<body>
  <main class="container max-w-5xl mx-auto py-12 px-4">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-block mb-4">
        <span class="text-emerald-600 text-5xl">✓</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-emerald-900 mb-3">
        Complete Your Membership
      </h1>
      <p class="text-lg text-emerald-700/80">
        You're one step away from exclusive benefits
      </p>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
      
      <!-- Plan Details Card (Left) -->
      <div class="md:col-span-3">
        <div class="plan-card p-8 rounded-2xl shadow-2xl text-white relative">
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-6">
              <div>
                <h3 class="text-2xl font-bold mb-2"><%= plan && plan.plan_name ? plan.plan_name : 'Membership' %></h3>
                <span class="badge"><%= (period === 'yearly' ? 'Yearly' : 'Monthly') + ' Plan' %></span>
              </div>
              <div class="text-right">
                <div class="text-sm opacity-80 mb-1">Total</div>
                <div class="text-4xl font-extrabold">S$<%= Number(plan.price || 0).toFixed(2) %></div>
                <div class="text-sm opacity-80">/<%= (period === 'yearly' ? 'year' : 'month') %></div>
              </div>
            </div>

            <div class="price-tag">
              <div class="text-sm opacity-90 mb-2">Your Investment</div>
              <div class="flex items-baseline gap-2">
                <span class="text-5xl font-extrabold">S$<%= Number(plan.price || 0).toFixed(2) %></span>
                <span class="text-xl opacity-80">/<%= (period === 'yearly' ? 'yr' : 'mo') %></span>
              </div>
              <div class="text-sm opacity-75 mt-2">Billed <%= (period === 'yearly' ? 'yearly' : 'monthly') %> • Cancel anytime</div>
            </div>

            <div class="mt-8">
              <h4 class="text-lg font-semibold mb-4 opacity-90">What's Included:</h4>
              <div class="space-y-1">
                <div class="feature-item">
                  <div class="checkmark">
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold">Unlimited Free Standard Delivery</div>
                    <div class="text-sm opacity-75">On all orders, no minimum spend</div>
                  </div>
                </div>

                <div class="feature-item">
                  <div class="checkmark">
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold">$5.00 Off Priority Delivery</div>
                    <div class="text-sm opacity-75">Get your orders faster</div>
                  </div>
                </div>

                <div class="feature-item">
                  <div class="checkmark">
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold">2× LinkPoints on Every Order</div>
                    <div class="text-sm opacity-75">Earn rewards twice as fast</div>
                  </div>
                </div>

                <div class="feature-item">
                  <div class="checkmark">
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold">10% Discount on Eligible Orders</div>
                    <div class="text-sm opacity-75">Save on every purchase</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Methods Card (Right) -->
      <div class="md:col-span-2">
            <div class="payment-card p-6 rounded-2xl shadow-lg sticky top-6">
          <h4 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
            Choose Payment
          </h4>

            <div class="space-y-3">
            <!-- PayPal -->
            <form method="POST" action="/membership/pay/paypal">
              <input type="hidden" name="planId" value="<%= plan.id %>">
              <input type="hidden" name="period" value="<%= period %>">
              <input type="hidden" name="cartTotal" value="<%= Number(plan.price || 0).toFixed(2) %>">
              <button type="submit" class="payment-btn w-full py-4 bg-[#0070ba] hover:bg-[#005a94] rounded-xl text-white font-bold flex items-center justify-center gap-3 shadow-md">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944 3.72a.77.77 0 0 1 .76-.653h8.41c2.347 0 3.958.515 4.784 1.53.826 1.015.97 2.502.428 4.42-.542 1.918-1.44 3.33-2.694 4.234-1.254.904-2.863 1.356-4.827 1.356h-2.05a.641.641 0 0 0-.633.74l-.617 3.922-.019.123a.32.32 0 0 1-.317.27z"/>
                </svg>
                Pay with PayPal
              </button>
            </form>

            <!-- Stripe -->
            <form method="POST" action="/membership/pay/stripe">
              <input type="hidden" name="planId" value="<%= plan.id %>">
              <input type="hidden" name="period" value="<%= period %>">
              <input type="hidden" name="cartTotal" value="<%= Number(plan.price || 0).toFixed(2) %>">
              <button type="submit" class="payment-btn w-full py-4 bg-[#6772E5] hover:bg-[#5469d4] rounded-xl text-white font-bold flex items-center justify-center gap-3 shadow-md">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697 0 12.165 0 9.667 0 7.589.654 6.104 1.872 4.56 3.147 3.757 4.992 3.757 7.218c0 4.039 2.467 5.76 6.476 7.219 2.585.92 3.445 1.574 3.445 2.583 0 .98-.84 1.545-2.354 1.545-1.875 0-4.965-.921-6.99-2.109l-.9 5.555C5.175 22.99 8.385 24 11.714 24c2.641 0 4.843-.624 6.328-1.813 1.664-1.305 2.525-3.236 2.525-5.732 0-4.128-2.524-5.851-6.594-7.305h.003z"/>
                </svg>
                Pay with Stripe
              </button>
            </form>

            <!-- NETS QR -->
            <form method="POST" action="/membership/pay/nets">
              <input type="hidden" name="planId" value="<%= plan.id %>">
              <input type="hidden" name="period" value="<%= period %>">
              <input type="hidden" name="cartTotal" value="<%= Number(plan.price || 0).toFixed(2) %>">
              <button type="submit" class="payment-btn w-full py-4 bg-[#ED1C24] hover:bg-[#d1191f] rounded-xl text-white font-bold flex items-center justify-center gap-3 shadow-md">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M3 4h18v4H3V4zm0 6h18v2H3v-2zm0 4h18v2H3v-2zm0 4h18v4H3v-4z"/>
                </svg>
                Pay with NETS QR
              </button>
            </form>
          </div>

          <!-- Security Badge -->
          <div class="secure-badge mt-6">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <div>
              <div class="font-semibold">Secure Payment</div>
              <div class="text-xs text-emerald-600">256-bit SSL encryption</div>
            </div>
          </div>

          <div class="mt-6 pt-6 border-t border-gray-200 text-center text-xs text-gray-500">
            By completing this purchase, you agree to our Terms of Service
          </div>
        </div>
      </div>
    </div>

    <!-- Trust Indicators -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
      <div class="p-6 bg-white rounded-xl shadow-sm">
        <div class="text-3xl mb-2">🔒</div>
        <h5 class="font-semibold text-gray-900 mb-1">Secure Payment</h5>
        <p class="text-sm text-gray-600">Your data is protected with industry-standard encryption</p>
      </div>
      <div class="p-6 bg-white rounded-xl shadow-sm">
        <div class="text-3xl mb-2">↻</div>
        <h5 class="font-semibold text-gray-900 mb-1">Cancel Anytime</h5>
        <p class="text-sm text-gray-600">No long-term commitment, cancel with one click</p>
      </div>
      <div class="p-6 bg-white rounded-xl shadow-sm">
        <div class="text-3xl mb-2">💬</div>
        <h5 class="font-semibold text-gray-900 mb-1">24/7 Support</h5>
        <p class="text-sm text-gray-600">We're here to help whenever you need assistance</p>
      </div>
    </div>
  </main>
</body>
</html>