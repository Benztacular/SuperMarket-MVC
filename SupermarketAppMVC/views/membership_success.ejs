<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Membership Activated</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial; background: linear-gradient(180deg,#ecfccb 0%,#f0fdf4 100%); min-height:100vh }
  </style>
</head>
<body class="flex items-center justify-center p-6">
  <div class="max-w-xl w-full bg-white rounded-2xl shadow-xl p-8 text-center">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-50 mx-auto">
      <svg class="w-12 h-12 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
      </svg>
    </div>

    <h1 class="mt-6 text-2xl font-extrabold text-gray-900">Membership Activated</h1>
    <p class="mt-2 text-sm text-gray-600">Thank you — your membership is now active.</p>

    <div class="mt-6 bg-emerald-50 rounded-lg p-4 text-left">
      <div class="flex justify-between items-center">
        <div class="text-sm text-gray-700">Plan</div>
        <div class="font-semibold text-gray-900"><%= (plan && plan.plan_name) ? plan.plan_name : '—' %></div>
      </div>
      <div class="mt-2 flex justify-between items-center">
        <div class="text-sm text-gray-700">Billing</div>
        <div class="font-semibold text-gray-900"><%= (period === 'yearly' ? 'Yearly' : (period === 'monthly' ? 'Monthly' : (period || 'One-time'))) %></div>
      </div>
      <div class="mt-2 flex justify-between items-center">
        <div class="text-sm text-gray-700">Amount</div>
        <div class="font-semibold text-gray-900">S$<%= (typeof amount !== 'undefined' ? Number(amount).toFixed(2) : (plan && plan.price ? Number(plan.price).toFixed(2) : '0.00')) %></div>
      </div>
      <% if (typeof subscriptionId !== 'undefined' && subscriptionId) { %>
        <div class="mt-3 text-xs text-gray-600">Subscription ID: <span class="font-mono text-xs"><%= subscriptionId %></span></div>
      <% } %>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/shopping" class="w-full sm:w-auto inline-block py-3 px-6 bg-emerald-600 text-white rounded-lg font-semibold">Back to Shopping</a>
      <a href="/membership" class="w-full sm:w-auto inline-block py-3 px-6 border border-emerald-600 text-emerald-600 rounded-lg">View Membership</a>
    </div>

    <p class="mt-4 text-xs text-gray-500">You will be redirected back to shopping in <span id="count">5</span> seconds.</p>
  </div>

  <script>
    // auto-redirect countdown
    (function(){
      let n = 5;
      const el = document.getElementById('count');
      if (!el) return;
      const t = setInterval(()=>{
        n--; el.textContent = String(n);
        if (n <= 0) { clearInterval(t); window.location.href = '/shopping'; }
      }, 1000);
    })();
  </script>
</body>
</html>
