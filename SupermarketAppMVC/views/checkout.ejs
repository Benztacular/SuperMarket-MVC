<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Confirm Payment - FreshMart</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">

  <!-- Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* --- MODERN FRESH THEME VARIABLES --- */
    :root {
      /* Brand Colors */
      --brand-primary: #10b981; /* Fresh Mint Green */
      --brand-primary-dark: #059669;
      --brand-primary-light: #d1fae5;
      --brand-dark: #0f172a;    /* Deep Slate */
      
      /* UI Colors */
      --bg-body: #f1f5f9;       /* Light Gray Blue */
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      
      /* Spacing & Shapes */
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 24px;
      
      /* Effects */
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
      --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.01);
      --shadow-button: 0 10px 15px -3px rgba(16, 185, 129, 0.3);
      --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body { 
      background-color: var(--bg-body); 
      font-family: 'Inter', sans-serif; 
      color: var(--text-main); 
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--brand-dark);
      font-weight: 700;
      letter-spacing: -0.025em;
    }

    a { text-decoration: none; color: inherit; transition: var(--transition); }

    /* --- LAYOUT UTILS --- */
    .cart-page {
      padding-top: 1.25rem;
      padding-bottom: 5rem;
      max-width: 1200px;
    }

    /* --- REVERTED STEPPER DESIGN --- */
    .checkout-stepper {
      display: flex;
      justify-content: center;
      margin-bottom: 2rem;
      position: relative;
    }
    .step-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-muted);
      font-weight: 500;
      font-size: 0.9rem;
      position: relative;
      z-index: 2;
    }
    .step-item.active {
      color: var(--brand-dark);
      font-weight: 700;
    }
    .step-item.completed {
      color: var(--brand-primary);
    }
    .step-circle {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #e2e8f0;
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      transition: all 0.3s;
    }
    .step-item.active .step-circle {
      background: var(--brand-dark);
      color: white;
      box-shadow: 0 0 0 4px rgba(30, 41, 59, 0.1);
    }
    .step-item.completed .step-circle {
      background: var(--brand-primary);
      color: white;
    }
    .step-divider {
      width: 60px;
      height: 2px;
      background: #e2e8f0;
      margin: 0 1rem;
      align-self: center;
    }
    .step-item.completed + .step-divider {
      background: var(--brand-primary);
    }

    /* --- GRID SYSTEM --- */
    .checkout-grid {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 28px;
      align-items: start;
    }

    /* --- CARDS & FORMS --- */
    .section-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      margin-bottom: 1.5rem;
    }

    .card-header-custom {
      padding: 1.5rem;
      border-bottom: 1px solid var(--border-color);
      background: #fafafa;
    }

    /* Address Selection Cards */
    .address-card {
      position: relative;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1rem;
      cursor: pointer;
      transition: var(--transition);
      background: #fff;
    }

    .address-card:hover {
      border-color: #cbd5e1;
      transform: translateY(-1px);
    }

    /* When selected */
    .address-card.active {
      border-color: var(--brand-primary);
      background-color: #f0fdf4;
    }
    
    .address-card.active .form-check-input {
      background-color: var(--brand-primary);
      border-color: var(--brand-primary);
    }

    /* Custom Form Inputs */
    .form-control, .form-select {
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.75rem 1rem;
      font-size: 0.95rem;
      transition: var(--transition);
      background-color: #fcfcfc;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
      background-color: #fff;
    }

    .form-label {
      font-weight: 500;
      color: var(--text-main);
      font-size: 0.85rem;
      margin-bottom: 0.4rem;
    }

    /* --- REVERTED SUMMARY CARD DESIGN --- */
    .confirm-summary {
      position: sticky;
      top: 110px;
    }

    .summary-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      padding: 1.75rem !important;
    }

    .summary-card h5 { 
      font-size: 1.1rem; 
      margin-bottom: 1.5rem; 
      padding-bottom: 1rem; 
      border-bottom: 1px dashed var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .summary-items { margin-bottom: 0.75rem; }
    
    .summary-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      font-size: 0.95rem;
      padding: 8px 0;
    }

    .summary-item-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .summary-thumb {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      object-fit: cover;
      background: #f1f5f9;
      border: 1px solid var(--border-color);
    }

    .summary-meta .name { font-weight: 600; color: var(--text-main); font-size: 0.9rem; line-height: 1.2; }
    .summary-meta .qty { font-size: 0.8rem; color: var(--text-muted); }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 1rem;
      font-size: 0.95rem;
      color: var(--text-muted);
    }

    .summary-row.total { 
      font-weight: 700; 
      color: var(--brand-dark); 
      font-size: 1.25rem; 
      margin-top: 1.5rem; 
      padding-top: 1rem; 
      border-top: 1px solid var(--border-color);
      align-items: center;
    }

    .summary-note { 
      font-size: 0.8rem; 
      color: var(--text-muted); 
      margin-top: 1.5rem; 
      text-align: center;
      line-height: 1.5;
      background: #f8fafc;
      padding: 1rem;
      border-radius: 12px;
      border: 1px solid #f1f5f9;
    }

    /* --- BUTTONS --- */
    .btn-custom-black {
      background: var(--brand-dark);
      color: white;
      border-radius: var(--radius-md);
      padding: 0.8rem 1.5rem;
      font-weight: 600;
      border: none;
      transition: var(--transition);
    }
    .btn-custom-black:hover {
      background: #000;
      transform: translateY(-1px);
    }

    .btn-custom-outline {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      border-radius: var(--radius-md);
      padding: 0.8rem 1.5rem;
      font-weight: 600;
      transition: var(--transition);
    }
    .btn-custom-outline:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    /* Actions area similar to original layout */
    .btn-actions { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 12px; }

    .btn-confirm-pay {
      background: var(--brand-dark);
      border: none;
      color: #fff;
      padding: 16px;
      border-radius: 12px;
      font-weight: 600;
      width: 100%;
      font-size: 1rem;
      transition: all 0.2s;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .btn-confirm-pay:hover {
      background: black;
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(0,0,0,0.15);
      color: #fff;
    }

    .btn-back {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      padding: 12px;
      border-radius: 12px;
      width: 100%;
      font-weight: 500;
      text-align: center;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-back:hover {
      background: #f1f5f9;
      color: var(--text-main);
      border-color: #cbd5e1;
    }

    /* --- RESPONSIVE --- */
    @media (max-width: 992px) {
      .checkout-grid { grid-template-columns: 1fr; }
      .confirm-summary { position: static; margin-top: 1rem; width: 100%; }
      .step-divider { width: 30px; margin: 0 0.5rem; }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="container cart-page">
    
    <!-- REVERTED Progress Stepper -->
    <div class="checkout-stepper">
      <div class="step-item completed">
        <div class="step-circle"><i data-lucide="check" style="width: 14px;"></i></div>
        <span>Shopping Cart</span>
      </div>
      <div class="step-divider"></div>
      <div class="step-item active">
        <div class="step-circle">2</div>
        <span>Checkout</span>
      </div>
      <div class="step-divider"></div>
      <div class="step-item">
        <div class="step-circle">3</div>
        <span>Payment</span>
      </div>
    </div>

    <!-- Main Layout -->
    <div class="checkout-grid">
      
      <!-- LEFT COLUMN -->
      <div class="main-col">
        <% const rows = (cartItems || items || []);
           function price(n){ const v = Number(n||0); return isFinite(v) ? v.toFixed(2) : '0.00'; }
           const sum = rows.reduce((s, it)=> s + Number(it.price||0)*Number(it.quantity||0), 0);
        %>

        <div class="d-flex align-items-baseline justify-content-between mb-4">
          <h2 class="mb-0">Shipping Details</h2>
          <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3"><%= rows.length %> items</span>
        </div>

        <% if ((addresses || []).length) { %>
          <form id="addressSelectForm" action="/delivery-addresses/select" method="POST" class="section-card">
            <div class="card-header-custom d-flex align-items-center justify-content-between">
              <div>
                <h5 class="mb-0">Saved Addresses</h5>
                <small class="text-muted fw-medium">Pick one for delivery</small>
              </div>
              <div>
                <button type="button" id="openAddAddress" class="btn-custom-outline">Add address</button>
              </div>
            </div>
            
            <div class="p-4">
              <div class="d-flex flex-column gap-3">
                <% addresses.forEach(addr => { const isSelected = Number(selectedAddressId) === Number(addr.id); %>
                  <label class="address-card d-flex align-items-start gap-3 <%= isSelected ? 'active' : '' %>"> 
                    <input type="radio" name="address_id" value="<%= addr.id %>" class="form-check-input mt-1" <%= isSelected ? 'checked' : '' %>>
                    <div class="flex-grow-1">
                      <div class="d-flex justify-content-between align-items-start">
                        <span class="fw-bold text-dark"><%= addr.recipient_name %></span>
                        <% if (addr.is_default) { %><span class="badge bg-success-subtle text-success border border-success-subtle">Default</span><% } %>
                      </div>
                      <div class="text-muted small mt-1">+<%= addr.contact_number %></div>
                      <div class="text-muted small mt-1"><%= addr.block_number %> <%= addr.street_name %> <%= addr.unit_number %>, <%= addr.postal_code %>, <%= addr.country %></div>
                    </div>
                  </label>
                <% }) %>
              </div>
            </div>
          </form>

          <!-- Shipping method selector (driven by DB) -->
          <div class="section-card mt-3">
            <div class="card-header-custom d-flex align-items-center justify-content-between">
              <div>
                <h5 class="mb-0">Shipping Method</h5>
                <small class="text-muted">Choose delivery speed</small>
              </div>
            </div>
            <div class="p-4">
              <% if ((shippingMethods || []).length) { %>
                <div class="d-flex flex-column gap-3">
                  <% shippingMethods.forEach(sm => { 
                    const isShipSelected = Number(selectedShippingMethodId) === Number(sm.id); 
                    const methodName = String(sm.method_name || '').toLowerCase();
                    const isStandard = methodName.includes('standard');
                    const isPriority = methodName.includes('priority');
                    const originalPrice = Number(sm.price || 0);
                    let displayPrice = originalPrice;
                    let showFree = false;
                    
                    if (typeof membership !== 'undefined' && membership) {
                      if (isStandard && (membership.free_standard_delivery || (total >= Number(membership.free_delivery_threshold || 0)))) {
                        displayPrice = 0;
                        showFree = true;
                      }
                      if (isPriority && Number(membership.priority_delivery_discount || 0) > 0) {
                        displayPrice = Math.max(0, originalPrice - Number(membership.priority_delivery_discount));
                      }
                    }
                  %>
                    <label class="address-card d-flex align-items-center justify-content-between <%= isShipSelected ? 'active' : '' %>"> 
                      <div>
                        <strong><%= sm.method_name || 'Shipping' %></strong>
                        <% if (sm.estimated_days) { %>
                          <div class="text-muted small">Est. <%= sm.estimated_days %></div>
                        <% } %>
                      </div>
                      <div class="text-end d-flex align-items-center gap-2">
                        <div>
                          <% if (showFree && displayPrice === 0) { %>
                            <div class="fw-bold text-decoration-line-through text-muted small">$<%= originalPrice.toFixed(2) %></div>
                            <span class="badge bg-success">Free delivery</span>
                          <% } else if (displayPrice < originalPrice) { %>
                            <div class="text-decoration-line-through text-muted small">$<%= originalPrice.toFixed(2) %></div>
                            <div class="fw-bold text-success">$<%= displayPrice.toFixed(2) %></div>
                          <% } else { %>
                            <div class="fw-bold">$<%= displayPrice.toFixed(2) %></div>
                          <% } %>
                        </div>
                        <input type="radio" name="shipping_method" value="<%= sm.id %>" data-price="<%= displayPrice.toFixed(2) %>" data-original="<%= originalPrice.toFixed(2) %>" data-free="<%= showFree ? '1' : '0' %>" <%= isShipSelected ? 'checked' : '' %> />
                      </div>
                    </label>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-muted">No shipping methods available.</div>
              <% } %>
            </div>
          </div>

        <% } else { %>
          <div class="section-card">
            <div class="card-header-custom">
              <h5 class="mb-1">New Delivery Address</h5>
              <p class="text-muted small mb-0">Enter details below to ship to a new location.</p>
            </div>

            <div class="p-4">
              <form id="inlineAddressForm" action="/delivery-addresses" method="POST" class="row g-3" onsubmit="return validateAddress(this)">
                <div class="col-md-6">
                  <label class="form-label">Recipient name</label>
                  <input type="text" name="recipient_name" class="form-control" placeholder="e.g. John Doe" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Contact number</label>
                  <input type="text" name="contact_number" class="form-control" placeholder="e.g. 98765432" inputmode="numeric" pattern="^\d{8}$" maxlength="8" title="Enter exactly 8 digits" required>
                  
                </div>
                
                <div class="col-12"><hr class="text-muted opacity-25 my-1"></div>

                <div class="col-md-4">
                  <label class="form-label">Block / House No.</label>
                  <input type="text" name="block_number" class="form-control" placeholder="e.g. 123 or 123A" pattern="^(?:\d{3}[A-Za-z]?|[A-Za-z]{3})$" maxlength="4" title="Enter 3 digits optionally followed by 1 letter, or 3 letters" required>
                  
                </div>
                <div class="col-md-8">
                  <label class="form-label">Street name</label>
                  <input type="text" name="street_name" class="form-control" placeholder="e.g. Orchard Road" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Unit number</label>
                  <input type="text" name="unit_number" class="form-control" placeholder="#12-34" pattern="^#?\d{2}-\d{2}$" maxlength="6" title="Format: 12-34 or #12-34" required>
                  
                </div>
                <div class="col-md-3">
                  <label class="form-label">Postal code</label>
                  <input type="text" name="postal_code" class="form-control" placeholder="e.g. 520123" inputmode="numeric" pattern="^\d{6}$" maxlength="6" title="Enter exactly 6 digits" required>
                  
                </div>
                <div class="col-md-3">
                  <label class="form-label">Country</label>
                  <select name="country" class="form-select">
                    <option value="Singapore" selected>Singapore</option>
                  </select>
                  
                </div>
                <div class="col-12 mt-4">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="is_default" value="1" id="setDefault">
                    <label class="form-check-label small text-muted pt-1" for="setDefault">
                      Save this address as default for future orders
                    </label>
                  </div>
                </div>
                <div class="col-12 mt-3">
                  <button type="submit" class="btn-custom-black w-100">Save Address & Continue</button>
                </div>
              </form>
            </div>
          </div>
        <% } %>
      </div>

        <!-- RIGHT COLUMN: REVERTED SUMMARY -->
      <div class="confirm-summary">
        <div class="summary-card" data-subtotal="<%= price(sum) %>" data-shipping="<%= Number(shippingFee || 0).toFixed(2) %>" data-discount="<%= Number(discountAmount || 0).toFixed(2) %>">
          <h5>Order Details <i data-lucide="receipt" style="width: 18px; color: #94a3b8;"></i></h5>
          
          <div class="summary-items">
            <% if ((cartItems || rows || items || []).length) {
                 const summaryRows = (cartItems || rows || items || []);
                 summaryRows.forEach(it => { %>
              <div class="summary-item">
                <div class="summary-item-left">
                  <% if (it.image) { %>
                    <img src="/images/<%= it.image %>" alt="<%= it.productName %>" class="summary-thumb">
                  <% } else { %>
                    <div class="summary-thumb d-flex align-items-center justify-content-center text-muted small">Img</div>
                  <% } %>
                  <div class="summary-meta">
                    <div class="name"><%= it.productName %></div>
                    <div class="qty">Qty: <%= it.quantity %></div>
                  </div>
                </div>
                <div class="fw-medium text-secondary">$<%= price(Number(it.price||0)*Number(it.quantity||0)) %></div>
              </div>
            <% }) } %>
          </div>
          
          <div class="summary-row">
            <span>Subtotal</span>
            <span>$<%= price(sum) %></span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span>
              <% if (originalShippingFee && originalShippingFee > shippingFee) { %>
                <span class="text-muted text-decoration-line-through small">$<%= Number(originalShippingFee).toFixed(2) %></span>
                <span class="text-success fw-bold ms-2">$<span id="shippingCost"><%= Number(shippingFee || 0).toFixed(2) %></span></span>
              <% } else { %>
                <span class="text-success fw-bold">$<span id="shippingCost"><%= Number(shippingFee || 0).toFixed(2) %></span></span>
              <% } %>
            </span>
          </div>
          <!-- Prominent Coupon Widget -->
          <div class="coupon-widget" aria-live="polite">
            <div class="coupon-top d-flex align-items-center justify-content-between">
              <div class="coupon-hint small text-muted d-flex align-items-center gap-2">
                <span class="coupon-hint-text">Have a code? Apply it here</span>
                <div class="coupon-badge-inline">My Codes</div>
                <span class="coupon-hint-msg visually-hidden ms-2" aria-live="polite" style="font-weight:600;color:#10b981;"></span>
              </div>
            </div>

            <div class="coupon-input-row d-flex align-items-center">
              <input id="couponCodeInput" class="coupon-input form-control" placeholder="Enter coupon code" aria-label="Coupon code" />
              <button id="applyCouponBtn" class="coupon-apply-btn btn btn-custom-black">Apply</button>
            </div>

            <div id="couponMessage" class="coupon-message small mt-2" style="display:none"></div>

            <div id="appliedCouponChip" class="coupon-chip d-flex align-items-center" style="display:none">
              <div class="chip-code" id="appliedCouponCode">CODE</div>
              <div class="chip-amount text-success" id="appliedCouponAmount">- $0.00</div>
              <a href="#" id="removeCoupon" class="chip-remove" aria-label="Remove coupon">&times;</a>
            </div>
          </div>
          <% if (discountAmount && discountAmount > 0) { %>
          <div class="summary-row">
            <span>Membership Discount</span>
            <span class="text-success fw-bold">-$<%= Number(discountAmount).toFixed(2) %></span>
          </div>
          <% } %>

          <div class="summary-row total">
            <span>Total</span>
            <span style="font-size: 1.5rem;">$<span id="totalCost"><%= Number((typeof totalWithShippingAdjusted !== 'undefined' ? totalWithShippingAdjusted : totalWithShipping) || (sum + (shippingFee || 0))).toFixed(2) %></span></span>
          </div>

          <div class="btn-actions">
            <a href="/cart" class="btn-back">Modify Cart</a>
            <div class="d-flex justify-content-end mt-2">
              <a href="/cart/pay" class="btn-confirm-pay" style="width: 100%;">Proceed To Payment</a>
            </div>
          </div>

          <div class="summary-note">
            <div style="display:flex; justify-content:center; gap:8px; margin-bottom:8px; opacity:0.6;">
               <i data-lucide="lock" style="width:14px"></i> <strong>Secure Checkout</strong>
            </div>
            By completing payment, you accept our Terms & Conditions.
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Add Address Modal (hidden) -->
  <div class="modal fade" id="addrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Add Delivery Address</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="modalAddressForm" class="row g-3" onsubmit="return validateAddress(this)">
            <div class="col-md-6">
              <label class="form-label">Recipient name</label>
              <input type="text" name="recipient_name" class="form-control" placeholder="e.g. John Doe" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Contact number</label>
              <input type="text" name="contact_number" class="form-control" placeholder="e.g. 98765432" inputmode="numeric" pattern="^\d{8}$" maxlength="8" title="Enter exactly 8 digits" required>
              
            </div>
            <div class="col-12"><hr class="text-muted opacity-25 my-1"></div>
            <div class="col-md-4">
              <label class="form-label">Block / House No.</label>
              <input type="text" name="block_number" class="form-control" placeholder="e.g. 123 or 123A" pattern="^(?:\d{3}[A-Za-z]?|[A-Za-z]{3})$" maxlength="4" title="Enter 3 digits optionally followed by 1 letter, or 3 letters" required>
              
            </div>
            <div class="col-md-8">
              <label class="form-label">Street name</label>
              <input type="text" name="street_name" class="form-control" placeholder="e.g. Orchard Road" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Unit number</label>
              <input type="text" name="unit_number" class="form-control" placeholder="#12-34" pattern="^#?\d{2}-\d{2}$" maxlength="6" title="Format: 12-34 or #12-34" required>
              
            </div>
            <div class="col-md-3">
              <label class="form-label">Postal code</label>
              <input type="text" name="postal_code" class="form-control" placeholder="e.g. 520123" inputmode="numeric" pattern="^\d{6}$" maxlength="6" title="Enter exactly 6 digits" required>
              
            </div>
            <div class="col-md-3">
              <label class="form-label">Country</label>
              <select name="country" class="form-select">
                <option value="Singapore" selected>Singapore</option>
                <option value="Malaysia">Malaysia</option>
                <option value="Other">Other</option>
              </select>
              
            </div>
            <div class="col-12 mt-2">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="is_default" value="1" id="modalDefault">
                <label class="form-check-label small text-muted" for="modalDefault">Save this address as default</label>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-custom-outline" data-bs-dismiss="modal">Cancel</button>
          <button id="modalSaveBtn" type="button" class="btn-custom-black">Save Address & Continue</button>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <style>
    /* Premium Coupon Widget Design */
    .coupon-widget{ 
      position: relative;
      border: none;
      background: linear-gradient(145deg, #ffffff 0%, #f8fffe 100%); 
      padding: 28px; 
      border-radius: 20px; 
      margin-top: 24px; 
      margin-bottom: 24px;
      box-shadow: 
        0 10px 40px -10px rgba(16, 185, 129, 0.15),
        0 0 0 1px rgba(16, 185, 129, 0.08),
        inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
      overflow: hidden;
    }

    .coupon-widget::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #10b981 0%, #059669 100%);
    }
    
    .coupon-top{ 
      margin-bottom: 20px; 
      padding-bottom: 16px;
      border-bottom: 2px dashed rgba(16, 185, 129, 0.15);
    }
    
    .coupon-hint {
      font-size: 0.95rem;
      color: #475569;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .coupon-hint::before {
      content: '🎟️';
      font-size: 1.2rem;
    }
    
    .coupon-badge-inline{ 
      background: linear-gradient(135deg, #10b981 0%, #059669 100%); 
      color: white; 
      padding: 10px 20px; 
      border-radius: 25px; 
      font-weight: 700; 
      font-size: 0.8rem; 
      cursor: pointer;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      animation: pulse-glow 2.5s ease-in-out infinite;
      box-shadow: 
        0 4px 15px rgba(16, 185, 129, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.3);
      letter-spacing: 0.8px;
      text-transform: uppercase;
      position: relative;
      overflow: hidden;
    }

    .coupon-badge-inline::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }

    .coupon-badge-inline:hover::before {
      width: 300px;
      height: 300px;
    }
    
    .coupon-badge-inline:hover {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      transform: translateY(-2px) scale(1.05);
      animation: none;
      box-shadow: 
        0 8px 25px rgba(16, 185, 129, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }

    .coupon-badge-inline:active {
      transform: translateY(0) scale(1.02);
    }
    
    @keyframes pulse-glow {
      0%, 100% {
        box-shadow: 
          0 4px 15px rgba(16, 185, 129, 0.3),
          inset 0 1px 0 rgba(255, 255, 255, 0.3);
      }
      50% {
        box-shadow: 
          0 4px 15px rgba(16, 185, 129, 0.3),
          0 0 0 10px rgba(16, 185, 129, 0),
          inset 0 1px 0 rgba(255, 255, 255, 0.3);
      }
    }
    
    .coupon-input-row{ 
      gap: 14px; 
      margin-top: 20px;
    }
    
    .coupon-input{ 
      padding: 16px 18px; 
      font-size: 0.95rem; 
      border-radius: 14px; 
      border: 2px solid #e2e8f0; 
      box-shadow: 
        0 2px 8px rgba(0, 0, 0, 0.04),
        inset 0 1px 2px rgba(0, 0, 0, 0.02);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      flex: 1;
      font-weight: 500;
      color: #1e293b;
      background: #ffffff;
    }

    .coupon-input::placeholder {
      color: #94a3b8;
      font-weight: 400;
    }
    
    .coupon-input:focus {
      outline: none;
      border-color: #10b981;
      box-shadow: 
        0 0 0 4px rgba(16, 185, 129, 0.12),
        0 2px 8px rgba(16, 185, 129, 0.15),
        inset 0 1px 2px rgba(0, 0, 0, 0.02);
      transform: translateY(-1px);
    }
    
    .coupon-apply-btn{ 
      padding: 16px 28px; 
      border-radius: 14px; 
      background: linear-gradient(135deg, #047857 0%, #065f46 100%); 
      border: none; 
      color: #fff; 
      font-weight: 700;
      font-size: 0.95rem;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 
        0 4px 12px rgba(6, 95, 70, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
      letter-spacing: 0.3px;
      cursor: pointer;
    }
    
    .coupon-apply-btn:hover:not([disabled]) {
      background: linear-gradient(135deg, #065f46 0%, #064e3b 100%);
      transform: translateY(-2px);
      box-shadow: 
        0 6px 20px rgba(6, 95, 70, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }

    .coupon-apply-btn:active:not([disabled]) {
      transform: translateY(0);
      box-shadow: 
        0 2px 8px rgba(6, 95, 70, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }
    
    .coupon-apply-btn[disabled]{ 
      opacity: 0.6; 
      cursor: not-allowed;
      transform: none;
      box-shadow: 0 2px 8px rgba(6, 95, 70, 0.2);
    }
    
    .coupon-message{ 
      color: #dc2626; 
      margin-top: 14px;
      padding: 12px 16px;
      background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 500;
      border-left: 4px solid #dc2626;
      box-shadow: 0 2px 8px rgba(220, 38, 38, 0.1);
    }
    
    .coupon-chip{ 
      margin-top: 18px; 
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(16, 185, 129, 0.08) 100%); 
      border: 2px solid rgba(16, 185, 129, 0.3); 
      padding: 14px 18px; 
      border-radius: 14px; 
      gap: 14px; 
      display: inline-flex;
      align-items: center;
      box-shadow: 
        0 4px 12px rgba(16, 185, 129, 0.15),
        inset 0 1px 0 rgba(255, 255, 255, 0.5);
      animation: slideDown 0.3s ease-out;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .chip-code{ 
      font-weight: 700; 
      color: #064e3b; 
      margin-right: 14px;
      font-size: 0.95rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    
    .chip-amount{ 
      font-weight: 700; 
      margin-right: 10px;
      font-size: 1rem;
      color: #059669;
    }
    
    .chip-remove{ 
      color: #dc2626; 
      font-weight: 700; 
      text-decoration: none; 
      margin-left: 14px;
      font-size: 1.1rem;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(220, 38, 38, 0.1);
      border: 1px solid rgba(220, 38, 38, 0.2);
    }
    
    .chip-remove:hover {
      background: rgba(220, 38, 38, 0.2);
      transform: scale(1.15) rotate(90deg);
      box-shadow: 0 2px 8px rgba(220, 38, 38, 0.3);
    }

    .chip-remove:active {
      transform: scale(1.05) rotate(90deg);
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    lucide.createIcons();
    // Global validation helper used by inline and modal address forms
    function validateAddress(form) {
      if (!form) return false;
      const clear = (el) => { if (el && typeof el.setCustomValidity === 'function') el.setCustomValidity(''); };
      ['contact_number','block_number','unit_number','postal_code','country'].forEach(name => clear(form.elements[name]));

      const contact = (form.contact_number && form.contact_number.value || '').trim();
      const block = (form.block_number && form.block_number.value || '').trim();
      const unit = (form.unit_number && form.unit_number.value || '').trim();
      const postal = (form.postal_code && form.postal_code.value || '').trim();
      const country = (form.country && form.country.value || '').trim();

      let valid = true;
      if (!/^\d{8}$/.test(contact)) {
        if (form.contact_number && typeof form.contact_number.setCustomValidity === 'function') form.contact_number.setCustomValidity('Contact number must be exactly 8 digits');
        valid = false;
      }
      if (!/^(?:\d{3}[A-Za-z]?|[A-Za-z]{3})$/.test(block)) {
        if (form.block_number && typeof form.block_number.setCustomValidity === 'function') form.block_number.setCustomValidity('Block must be 3 digits optionally followed by 1 letter, or 3 letters');
        valid = false;
      }
      if (!/^#?\d{2}-\d{2}$/.test(unit)) {
        if (form.unit_number && typeof form.unit_number.setCustomValidity === 'function') form.unit_number.setCustomValidity('Unit must follow format 12-34 or #12-34');
        valid = false;
      }
      if (!/^\d{6}$/.test(postal)) {
        if (form.postal_code && typeof form.postal_code.setCustomValidity === 'function') form.postal_code.setCustomValidity('Postal code must be exactly 6 digits');
        valid = false;
      }
      if (country && country.toLowerCase() !== 'singapore') {
        if (form.country && typeof form.country.setCustomValidity === 'function') form.country.setCustomValidity('Country must be Singapore');
        valid = false;
      }

      // Use browser reporting when available so messages appear inline
      if (typeof form.reportValidity === 'function') {
        return form.reportValidity();
      }

      if (!valid) {
        const msgs = [];
        if (!/^\d{8}$/.test(contact)) msgs.push('Contact number must be exactly 8 digits');
        if (!/^(?:\d{3}[A-Za-z]?|[A-Za-z]{3})$/.test(block)) msgs.push('Block must be 3 digits optionally followed by 1 letter, or 3 letters');
        if (!/^#?\d{2}-\d{2}$/.test(unit)) msgs.push('Unit must follow format 12-34 or #12-34');
        if (!/^\d{6}$/.test(postal)) msgs.push('Postal code must be exactly 6 digits');
        if (country && country.toLowerCase() !== 'singapore') msgs.push('Country must be Singapore');
        alert(msgs.join('\n'));
        return false;
      }
      // ensure country is normalized
      if (form.country) form.country.value = 'Singapore';
      return true;
    }
    (function(){
      // address selection via AJAX to avoid flash messages
      const addressForm = document.getElementById('addressSelectForm');
      if (addressForm){
        addressForm.querySelectorAll('input[name="address_id"]').forEach(function(radio){
          radio.addEventListener('change', function(e){
            const id = e.target.value;
            fetch(addressForm.action, {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
              body: new URLSearchParams({ address_id: id }).toString()
            }).then(function(resp){
              if (resp.ok) {
                addressForm.querySelectorAll('label.address-card').forEach(function(lbl){ lbl.classList.remove('active'); });
                const input = addressForm.querySelector('input[value="'+id+'"]');
                if (input){ input.checked = true; input.closest('label.address-card').classList.add('active'); }
              }
            }).catch(function(){ /* ignore errors */ });
          });
        });
      }

      // shipping selection and totals update
      const shippingRadios = Array.from(document.querySelectorAll('input[name="shipping_method"]'));
      const shippingCostEl = document.getElementById('shippingCost');
      const totalCostEl = document.getElementById('totalCost');
      const summaryCard = document.querySelector('.summary-card');
      const subtotal = summaryCard ? parseFloat(summaryCard.dataset.subtotal || '0') : 0;
      const discountAmount = summaryCard ? parseFloat(summaryCard.dataset.discount || '0') : 0;
      let couponDiscount = 0;
      let appliedCoupon = null;

      function updateShipping(evt){
        const checked = document.querySelector('input[name="shipping_method"]:checked');
        const ship = checked ? parseFloat(checked.dataset.price || '0') : 0;
        if (shippingCostEl) shippingCostEl.textContent = ship.toFixed(2);
        if (totalCostEl) totalCostEl.textContent = (subtotal + ship - discountAmount - couponDiscount).toFixed(2);

        // toggle active card styling
        const allLabels = document.querySelectorAll('label.address-card input[name="shipping_method"]');
        allLabels.forEach((inp) => {
          const lbl = inp.closest('label.address-card');
          if (!lbl) return;
          if (inp === checked) lbl.classList.add('active');
          else lbl.classList.remove('active');
        });

        if (evt && checked) {
          const body = new URLSearchParams({ shipping_method_id: checked.value }).toString();
          fetch('/shipping/select', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body
          }).catch(() => {});
        }
      }

      // Coupon apply/remove handlers
      const couponInput = document.getElementById('couponCodeInput');
      const applyCouponBtn = document.getElementById('applyCouponBtn');
      const couponMessageEl = document.getElementById('couponMessage');
      const appliedChip = document.getElementById('appliedCouponChip');
      const appliedCodeEl = document.getElementById('appliedCouponCode');
      const appliedAmountEl = document.getElementById('appliedCouponAmount');
      const removeCouponLink = document.getElementById('removeCoupon');

      if (applyCouponBtn && couponInput) {
        applyCouponBtn.addEventListener('click', function (e) {
          e.preventDefault();
          const code = (couponInput.value || '').trim();
          if (!code) { alert('Please enter a coupon code'); return; }
          applyCouponBtn.disabled = true;
          applyCouponBtn.textContent = 'Applying...';
          fetch('/api/coupons/apply', {
            method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ code })
          }).then(r => r.json()).then(json => {
            applyCouponBtn.disabled = false;
            // Ensure the My Codes badge stays visible regardless of outcome
            const promoButton = document.querySelector('.coupon-badge-inline');
            if (promoButton) promoButton.style.display = '';

            if (!json || !json.success) {
              applyCouponBtn.textContent = 'Apply';
              const msg = (json && json.message) ? json.message : 'Failed to apply coupon';
              if (json && typeof json.amountNeeded !== 'undefined') {
                const short = Number(json.amountNeeded || 0).toFixed(2);
                const shortMsg = msg + '. You need $' + short + ' more to use this coupon.';
                if (couponMessageEl) { couponMessageEl.style.display = ''; couponMessageEl.textContent = shortMsg; couponMessageEl.style.color = '#c2410c'; }
                else return alert(shortMsg);
                return;
              }
              if (couponMessageEl) { couponMessageEl.style.display = ''; couponMessageEl.textContent = msg; couponMessageEl.style.color = '#b91c1c'; }
              else return alert(msg);
              return;
            }
            couponDiscount = Number(json.discount || 0);
            appliedCoupon = json.coupon || null;
            // show applied chip
            if (appliedChip && appliedCodeEl && appliedAmountEl && appliedCoupon) {
              appliedCodeEl.textContent = appliedCoupon.code || appliedCoupon.code || appliedCoupon.code;
              appliedAmountEl.textContent = '- $' + Number(couponDiscount).toFixed(2);
              appliedChip.style.display = '';
            }
            // hide any message and disable input
            if (couponMessageEl) { couponMessageEl.style.display = 'none'; couponMessageEl.textContent = ''; }
            if (couponInput) couponInput.disabled = true;
            applyCouponBtn.textContent = 'Applied';
            // keep My Codes visible after successful apply as well
            if (promoButton) promoButton.style.display = '';
            updateShipping();
          }).catch(err => {
            console.error('apply coupon err', err);
            applyCouponBtn.disabled = false;
            applyCouponBtn.textContent = 'Apply';
            // ensure badge stays visible on network error too
            try { const promoButton = document.querySelector('.coupon-badge-inline'); if (promoButton) promoButton.style.display = ''; } catch(e){}
            alert('Failed to apply coupon');
          });
        });
      }

      if (removeCouponLink) {
        removeCouponLink.addEventListener('click', function (e) {
          e.preventDefault();
            fetch('/api/coupons/remove', { method: 'POST', credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json()).then(json => {
            couponDiscount = 0; appliedCoupon = null;
            if (appliedChip && appliedCodeEl && appliedAmountEl) { appliedChip.style.display = 'none'; appliedCodeEl.textContent = ''; appliedAmountEl.textContent = '- $0.00'; }
            // Re-enable input and button for new coupon
            if (couponInput) { couponInput.disabled = false; couponInput.value = ''; couponInput.focus(); }
            if (applyCouponBtn) { applyCouponBtn.disabled = false; applyCouponBtn.textContent = 'Apply'; }
            if (couponMessageEl) { couponMessageEl.style.display = 'none'; couponMessageEl.textContent = ''; }
            // make sure My Codes is visible after removal
            try { const promoButton = document.querySelector('.coupon-badge-inline'); if (promoButton) promoButton.style.display = ''; } catch(e){}
            updateShipping();
          }).catch(err => { console.error('remove coupon err', err); couponDiscount = 0; appliedCoupon = null; if (couponInput) { couponInput.disabled = false; couponInput.value = ''; } if (applyCouponBtn) { applyCouponBtn.disabled = false; applyCouponBtn.textContent = 'Apply'; } updateShipping(); });
        });
      }
      if (shippingRadios.length){
        shippingRadios.forEach(r=> {
          r.addEventListener('change', updateShipping);
          const lbl = r.closest('label.address-card');
          if (lbl) {
            lbl.addEventListener('click', () => { r.checked = true; updateShipping(); });
          }
        });
        updateShipping();
      } else {
        if (shippingCostEl) shippingCostEl.textContent = '0.00';
        if (totalCostEl) totalCostEl.textContent = (subtotal - discountAmount).toFixed(2);
      }

      // modal handling: show modal and submit via AJAX, append new address on success
      const openBtn = document.getElementById('openAddAddress');
      const addrModalEl = document.getElementById('addrModal');
      let bsModal = null;
      if (addrModalEl) bsModal = new bootstrap.Modal(addrModalEl);
      if (openBtn && bsModal){
        openBtn.addEventListener('click', function(){ bsModal.show(); });
      }

      const saveBtn = document.getElementById('modalSaveBtn');
      if (saveBtn){
        saveBtn.addEventListener('click', function(){
          const form = document.getElementById('modalAddressForm');
            // validate modal form before submitting
            if (!validateAddress(form)) { return; }
            const fd = new FormData(form);
          // prefer JSON response from server; fall back to appending locally
          fetch('/delivery-addresses', { method:'POST', credentials:'same-origin', body: new URLSearchParams(fd) })
            .then(resp => {
              const ct = resp.headers.get('content-type') || '';
              if (ct.indexOf('application/json') !== -1) return resp.json();
              if (resp.ok) return { ok: true, fallback: true };
              throw new Error('save-failed');
            }).then(data => {
              const container = addressForm && addressForm.querySelector('.d-flex.flex-column');
              if (container){
                // if server returned JSON with id and fields, use them
                let id = String(Date.now());
                let recipient = form.recipient_name.value || 'New';
                let contact = form.contact_number.value || '';
                let block = form.block_number.value || '';
                let street = form.street_name.value || '';
                let unit = form.unit_number.value || '';
                let postal = form.postal_code.value || '';
                let country = form.country.value || '';
                if (data && data.id){ id = data.id; recipient = data.recipient_name || recipient; contact = data.contact_number || contact; block = data.block_number || block; street = data.street_name || street; unit = data.unit_number || unit; postal = data.postal_code || postal; country = data.country || country; }
                const label = document.createElement('label');
                label.className = 'address-card d-flex align-items-start gap-3 active';
                label.innerHTML = `<input type="radio" name="address_id" value="${id}" class="form-check-input mt-1" checked>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start"><span class="fw-bold text-dark">${recipient}</span></div>
                    <div class="text-muted small mt-1">+${contact}</div>
                    <div class="text-muted small mt-1">${block} ${street} ${unit}, ${postal}, ${country}</div>
                  </div>`;
                // unselect others
                container.querySelectorAll('label.address-card').forEach(function(l){ l.classList.remove('active'); const inp = l.querySelector('input[name="address_id"]'); if (inp) inp.checked = false; });
                container.appendChild(label);
                    const available = [];
                    const redeemed = [];
                    coupons.forEach(coupon => {
                      const used = Number(coupon.times_used || 0) > 0 || (coupon.user_status && (
                        String(coupon.user_status).toLowerCase() === 'exhausted' ||
                        String(coupon.user_status).toLowerCase() === 'used' ||
                        String(coupon.user_status).toLowerCase() === 'redeemed'
                      ));
                      if (used) redeemed.push(coupon); else available.push(coupon);
                    });

                    let html = '';
                    const renderCard = (coupon) => {
                      const code = coupon.coupon_code || '';
                      const desc = coupon.description || 'Discount coupon';
                      const isUsed = Number(coupon.times_used || 0) > 0 || (coupon.user_status && (
                        String(coupon.user_status).toLowerCase() === 'exhausted' ||
                        String(coupon.user_status).toLowerCase() === 'used' ||
                        String(coupon.user_status).toLowerCase() === 'redeemed'
                      ));
                      const usedClass = isUsed ? 'used' : '';
                      const badgeText = isUsed ? 'Used' : (coupon.is_global ? 'Global' : 'Personal');

                      let discountText = '';
                      if (coupon.discount_type === 'PERCENTAGE') discountText = `${coupon.discount_value}% OFF`;
                      else if (coupon.discount_type === 'FIXED') discountText = `$${Number(coupon.discount_value || 0).toFixed(2)} OFF`;

                      const minSpend = coupon.min_spend ? `Min: $${Number(coupon.min_spend).toFixed(2)}` : '';
                      const freeDelivery = coupon.is_free_delivery ? 'Free Delivery' : '';

                      return `
                        <div class="coupon-card ${usedClass}" data-code="${code}" data-used="${isUsed}">
                          <span class="coupon-badge">${badgeText}</span>
                          <div class="coupon-code">${code}</div>
                          <div class="coupon-description">${desc}</div>
                          <div class="coupon-details">
                            ${discountText ? `<div class="coupon-detail-item"><i data-lucide="tag" style="width: 14px;"></i> ${discountText}</div>` : ''}
                            ${minSpend ? `<div class="coupon-detail-item"><i data-lucide="shopping-cart" style="width: 14px;"></i> ${minSpend}</div>` : ''}
                            ${freeDelivery ? `<div class="coupon-detail-item"><i data-lucide="truck" style="width: 14px;"></i> ${freeDelivery}</div>` : ''}
                          </div>
                        </div>
                      `;
                    };

                    available.forEach(c => { html += renderCard(c); });
                    if (available.length && redeemed.length) html += `<div class="empty-coupons text-center py-2" style="opacity:0.7">Redeemed / Expired</div>`;
                    redeemed.forEach(c => { html += renderCard(c); });
              }
              if (bsModal) bsModal.hide();
            }).catch(()=>{ if (bsModal) bsModal.hide(); });
        });
      }

      // ensure address + shipping selection is saved before navigating to pay page
      const proceedBtn = document.querySelector('.btn-confirm-pay');
      if (proceedBtn) {
        proceedBtn.addEventListener('click', function(ev){
          ev.preventDefault();

          const addrRadios = document.querySelectorAll('input[name="address_id"]');
          const addrChecked = document.querySelector('input[name="address_id"]:checked');
          if (addrRadios.length && !addrChecked) {
            alert('Please select a delivery address before proceeding to payment.');
            return;
          }

          const shipRadios = document.querySelectorAll('input[name="shipping_method"]');
          const shipChecked = document.querySelector('input[name="shipping_method"]:checked');
          if (shipRadios.length && !shipChecked) {
            alert('Please select a shipping method before proceeding to payment.');
            return;
          }

          // Save selections (address then shipping) before navigating to payment
          const tasks = [];
          if (addrChecked) {
            tasks.push(fetch('/delivery-addresses/select', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
              body: new URLSearchParams({ address_id: addrChecked.value }).toString()
            }).catch(() => {}));
          }

          if (shipChecked) {
            tasks.push(fetch('/shipping/select', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
              body: new URLSearchParams({ shipping_method_id: shipChecked.value }).toString()
            }).catch(() => {}));
          }

          Promise.all(tasks).then(() => { window.location = '/cart/pay'; }).catch(() => { window.location = '/cart/pay'; });
        });
      }
    })();
  </script>

  <!-- Coupon Modal -->
  <div id="couponModal" class="modal fade" tabindex="-1" aria-labelledby="couponModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
        <div class="modal-header" style="border-bottom: 1px solid #e2e8f0; padding: 1.5rem;">
          <h5 class="modal-title" id="couponModalLabel" style="font-weight: 700; color: var(--brand-dark); font-size: 1.25rem;">
            <i data-lucide="ticket" style="width: 20px; height: 20px; margin-right: 8px;"></i>
            Your Coupons
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="couponModalBody" style="padding: 1rem; max-height: 400px; overflow-y: auto;">
          <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Loading your coupons...</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .coupon-card {
      background: linear-gradient(135deg, #f0fdf4 0%, #d1fae5 100%);
      border: 2px solid #10b981;
      border-radius: 12px;
      padding: 1rem;
      margin-bottom: 0.75rem;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
      overflow: hidden;
    }
    .coupon-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(16, 185, 129, 0.2);
      border-color: #059669;
    }
    .coupon-card.used {
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      border-color: #cbd5e1;
      opacity: 0.6;
      cursor: not-allowed;
    }
    .coupon-card.used:hover {
      transform: none;
      box-shadow: none;
    }
    .coupon-code {
      font-size: 1.1rem;
      font-weight: 700;
      color: #059669;
      font-family: 'Courier New', monospace;
      letter-spacing: 1px;
      margin-bottom: 0.5rem;
    }
    .coupon-card.used .coupon-code {
      color: #64748b;
    }
    .coupon-description {
      font-size: 0.9rem;
      color: #0f172a;
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }
    .coupon-card.used .coupon-description {
      color: #64748b;
    }
    .coupon-details {
      display: flex;
      gap: 1rem;
      font-size: 0.8rem;
      color: #64748b;
      margin-top: 0.5rem;
      flex-wrap: wrap;
    }
    .coupon-detail-item {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .coupon-badge {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      background: #10b981;
      color: white;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .coupon-card.used .coupon-badge {
      background: #94a3b8;
    }
    .empty-coupons {
      text-align: center;
      padding: 3rem 1rem;
      color: #64748b;
    }
    .empty-coupons i {
      width: 64px;
      height: 64px;
      margin-bottom: 1rem;
      opacity: 0.3;
    }
  </style>

  <script>
    (function() {
      const promoButton = document.querySelector('.coupon-badge-inline');
      const couponModal = document.getElementById('couponModal');
      const couponModalBody = document.getElementById('couponModalBody');
      const couponCodeInput = document.getElementById('couponCodeInput');
      
      if (!promoButton || !couponModal) return;

      let bsCouponModal = null;
      if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
        bsCouponModal = new bootstrap.Modal(couponModal);
      }

      // client-side flash/toast utility (keeps layout intact)
      function showFlash(message, type='success'){
        try {
          let container = document.querySelector('.client-flash-container');
          if (!container) {
            container = document.createElement('div');
            container.className = 'client-flash-container';
            container.setAttribute('aria-live','polite');
            Object.assign(container.style, { position: 'fixed', top: '18px', right: '18px', zIndex: 1080 });
            document.body.appendChild(container);
          }
          const el = document.createElement('div');
          el.className = 'client-flash-item';
          el.textContent = message;
          Object.assign(el.style, {
            background: type==='error' ? '#fee2e2' : '#ecfdf5',
            color: type==='error' ? '#991b1b' : '#065f46',
            padding: '10px 14px',
            marginTop: '8px',
            borderRadius: '8px',
            boxShadow: '0 6px 18px rgba(0,0,0,0.08)',
            fontWeight: 600,
            minWidth: '200px'
          });
          container.appendChild(el);
          setTimeout(()=>{ el.style.transition='opacity 240ms ease'; el.style.opacity = '0'; setTimeout(()=>{ try{ container.removeChild(el); }catch(e){} }, 260); }, 3000);
        } catch(e) { console.error('showFlash err', e); }
      }

      // Make My Codes badge clickable
      promoButton.style.cursor = 'pointer';
      promoButton.addEventListener('click', function(e) {
        e.preventDefault();
        if (!bsCouponModal) return;

        // Show loading state
        couponModalBody.innerHTML = `
          <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Loading your coupons...</p>
          </div>
        `;

        // Fetch user coupons
        fetch('/api/user/coupons', {
          method: 'GET',
          credentials: 'same-origin',
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
        .then(r => r.json())
        .then(data => {
          if (!data || !data.success) {
            couponModalBody.innerHTML = `
              <div class="empty-coupons">
                <i data-lucide="alert-circle"></i>
                <p class="mb-0">Failed to load coupons</p>
              </div>
            `;
            lucide.createIcons();
            return;
          }

          const coupons = data.coupons || [];
          if (coupons.length === 0) {
            couponModalBody.innerHTML = `
              <div class="empty-coupons">
                <i data-lucide="ticket"></i>
                <h6 style="color: #0f172a; font-weight: 600;">No coupons available</h6>
                <p class="mb-0">Check back later for exclusive offers!</p>
              </div>
            `;
            lucide.createIcons();
            return;
          }

          // Render coupons: available first, redeemed/used last
          const available = [];
          const redeemed = [];
          coupons.forEach(coupon => {
            const used = Number(coupon.times_used || 0) > 0 || (coupon.user_status && (
              String(coupon.user_status).toLowerCase() === 'exhausted' ||
              String(coupon.user_status).toLowerCase() === 'used' ||
              String(coupon.user_status).toLowerCase() === 'redeemed'
            ));
            if (used) redeemed.push(coupon); else available.push(coupon);
          });

          let html = '';
          const renderCard = (coupon) => {
            const code = coupon.coupon_code || '';
            const desc = coupon.description || 'Discount coupon';
            const isUsed = Number(coupon.times_used || 0) > 0 || (coupon.user_status && (
              String(coupon.user_status).toLowerCase() === 'exhausted' ||
              String(coupon.user_status).toLowerCase() === 'used' ||
              String(coupon.user_status).toLowerCase() === 'redeemed'
            ));
            const usedClass = isUsed ? 'used' : '';
            const badgeText = isUsed ? 'Used' : (coupon.is_global ? 'Global' : 'Personal');

            let discountText = '';
            if (coupon.discount_type === 'PERCENTAGE') discountText = `${coupon.discount_value}% OFF`;
            else if (coupon.discount_type === 'FIXED') discountText = `$${Number(coupon.discount_value || 0).toFixed(2)} OFF`;

            const minSpend = coupon.min_spend ? `Min: $${Number(coupon.min_spend).toFixed(2)}` : '';
            const freeDelivery = coupon.is_free_delivery ? 'Free Delivery' : '';

            return `
              <div class="coupon-card ${usedClass}" data-code="${code}" data-used="${isUsed}">
                <span class="coupon-badge">${badgeText}</span>
                <div class="coupon-code">${code}</div>
                <div class="coupon-description">${desc}</div>
                <div class="coupon-details">
                  ${discountText ? `<div class="coupon-detail-item"><i data-lucide="tag" style="width: 14px;"></i> ${discountText}</div>` : ''}
                  ${minSpend ? `<div class="coupon-detail-item"><i data-lucide="shopping-cart" style="width: 14px;"></i> ${minSpend}</div>` : ''}
                  ${freeDelivery ? `<div class="coupon-detail-item"><i data-lucide="truck" style="width: 14px;"></i> ${freeDelivery}</div>` : ''}
                </div>
              </div>
            `;
          };

          available.forEach(c => { html += renderCard(c); });
          if (available.length && redeemed.length) html += `<div class="empty-coupons text-center py-2" style="opacity:0.7">Redeemed / Expired</div>`;
          redeemed.forEach(c => { html += renderCard(c); });

          couponModalBody.innerHTML = html;
          lucide.createIcons();

          // Add click handlers to coupon cards
          const couponCards = couponModalBody.querySelectorAll('.coupon-card');
          couponCards.forEach(card => {
            const isUsed = card.dataset.used === 'true';
            if (!isUsed) {
              card.addEventListener('click', function() {
                const code = this.dataset.code;
                if (code && couponCodeInput) {
                  // If input is disabled (coupon already applied), remove it first
                  const applyCouponBtn = document.getElementById('applyCouponBtn');
                  const appliedChip = document.getElementById('appliedCouponChip');
                  const couponMessageEl = document.getElementById('couponMessage');
                  
                  if (couponCodeInput.disabled) {
                    // Remove current coupon first
                    fetch('/api/coupons/remove', { method: 'POST', credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                      .then(() => {
                        // Reset UI
                        if (appliedChip) appliedChip.style.display = 'none';
                        if (couponMessageEl) { couponMessageEl.style.display = 'none'; couponMessageEl.textContent = ''; }
                        
                        // Re-enable and autofill new code
                        couponCodeInput.disabled = false;
                        couponCodeInput.value = code;
                        if (applyCouponBtn) { applyCouponBtn.disabled = false; applyCouponBtn.textContent = 'Apply'; }
                        couponCodeInput.focus();
                        if (bsCouponModal) bsCouponModal.hide();
                        
                        // Show success message (always show flash)
                        showFlash('✓ New code ready! Click Apply');
                      })
                      .catch(() => {
                        // Even if remove fails, still try to autofill
                        couponCodeInput.disabled = false;
                        couponCodeInput.value = code;
                        if (applyCouponBtn) { applyCouponBtn.disabled = false; applyCouponBtn.textContent = 'Apply'; }
                        couponCodeInput.focus();
                        if (bsCouponModal) bsCouponModal.hide();
                      });
                  } else {
                    // No coupon applied, just autofill
                    couponCodeInput.value = code;
                    couponCodeInput.focus();
                    if (bsCouponModal) bsCouponModal.hide();
                    
                    // Show success message (always show flash)
                    showFlash('✓ Code applied! Click Apply');
                  }
                }
              });
            }
          });
        })
        .catch(err => {
          console.error('Failed to fetch coupons:', err);
          couponModalBody.innerHTML = `
            <div class="empty-coupons">
              <i data-lucide="wifi-off"></i>
              <p class="mb-0">Failed to load coupons. Please try again.</p>
            </div>
          `;
          lucide.createIcons();
        });

        bsCouponModal.show();
      });
    })();
  </script>
</body>
</html>