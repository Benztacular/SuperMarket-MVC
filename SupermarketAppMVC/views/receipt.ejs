<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Invoice - Order #<%= orderId %></title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-body: #f3f4f6;
      --paper: #ffffff;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --accent: #16a34a;
      --border-light: #e5e7eb;
    }

    html, body { height: 100%; margin: 0; }

    body {
      font-family: "Inter", sans-serif;
      background: var(--bg-body);
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    main {
      flex: 1 0 auto;
      padding: 40px 20px;
      display: flex;
      justify-content: center;
    }

    /* ⭐ FIX: Invoice paper container */
    #invoice-paper {
      width: 100%;
      max-width: 800px;
      background: var(--paper);
      box-shadow: 0 4px 6px -1px rgba(0,0,0,.1), 0 2px 4px -1px rgba(0,0,0,.06);
      border-radius: 8px;
      padding: 48px;
      position: relative;
    }

    .invoice-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 48px;
    }

    .brand-section h1 {
      font-size: 24px;
      font-weight: 700;
      color: #111827;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-details {
      margin-top: 16px;
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .invoice-title-block { text-align: right; }

    .invoice-label {
      font-size: 36px;
      font-weight: 700;
      color: #e5e7eb;
      margin: 0 0 8px 0;
    }

    .invoice-id {
      font-size: 14px;
      color: var(--text-muted);
    }

    .info-grid {
      display: grid;
      /* reserve a fixed right column so date/due/order/payment stack neatly */
      grid-template-columns: 1fr 260px;
      gap: 32px;
      margin-bottom: 48px;
      padding-bottom: 48px;
      border-bottom: 1px solid var(--border-light);
      align-items: start;
    }

    /* right column: stack rows and align to the end for consistent layout */
    .info-grid > div:last-child {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      gap: 12px;
    }

    .info-label {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      color: #9ca3af;
      margin-bottom: 8px;
      display: block;
    }

    .info-value { font-size: 15px; font-weight: 500; }
    .info-sub { font-size: 13px; color: var(--text-muted); }

    .date-row {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      width: 100%;
      margin-bottom: 6px;
    }

    .date-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      color: #9ca3af;
      letter-spacing: 0.6px;
      margin-bottom: 4px;
    }

    .date-value {
      font-size: 14px;
      font-weight: 600;
      color: #111827;
      white-space: nowrap;
    }

    /* make sure the title block stays at the top-right and aligns with right column */
    .invoice-title-block { display:flex; flex-direction:column; align-items:flex-end; gap:6px; }

    .invoice-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 48px;
    }

    .invoice-table th {
      background: #f9fafb;
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      border-bottom: 1px solid var(--border-light);
      padding: 12px 16px;
    }

    .invoice-table td {
      padding: 16px;
      border-bottom: 1px dashed var(--border-light);
      font-size: 14px;
    }

    .text-right { text-align: right; }
    .font-mono { font-family: "JetBrains Mono", monospace; }

    .totals-section {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 48px;
    }

    .totals-box { max-width: 300px; width: 100%; }

    .total-row {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 12px;
    }

    .grand-total {
      border-top: 1px solid var(--border-light);
      padding-top: 12px;
      margin-top: 12px;
      display: flex;
      justify-content: space-between;
    }

    .grand-total-label { font-weight: 700; font-size: 16px; }
    .grand-total-value { font-size: 24px; font-weight: 700; }

    .actions { text-align: center; margin-top: 32px; }
    .btn-invoice {
      padding: 12px 24px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-outline {
      border: 1px solid #d1d5db;
      color: var(--text-main);
      background: white;
      margin-right: 12px;
    }

    .btn-print {
      background: var(--accent);
      color: white;
      border: none;
    }

    /* ⭐ FIX: Print isolation */
    @media print {
      body * { visibility: hidden; }
      #invoice-paper, #invoice-paper * {
        visibility: visible;
      }
      #invoice-paper {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        box-shadow: none;
        padding: 24px;
      }
      .actions { display: none !important; }
    }
  </style>
</head>

<body>

<%- include('partials/header') %>

<main>

  <!-- ⭐ FIX: ID added -->
  <div id="invoice-paper">

    <!-- HEADER -->
    <div class="invoice-header">
      <div class="brand-section">
        <h1>
          <i data-lucide="shopping-bag" style="color: var(--accent);"></i>
          FRESHMART
        </h1>
        <div class="brand-details">
          <div>9 Woodlands Ave 9</div>
          <div>Singapore, 738964</div>
          <div>contact@freshmart.com</div>
        </div>
      </div>

      <div class="invoice-title-block">
        <div class="invoice-label">INVOICE</div>
        <div class="invoice-id">#INV-<%= orderId %></div>
      </div>
    </div>

    <!-- INFO -->
    <div class="info-grid">
      <div>
          <span class="info-label">Ship To</span>
          <div class="info-value"><%= (typeof deliveryAddress !== 'undefined' && deliveryAddress && (deliveryAddress.recipient_name || deliveryAddress.full_name)) || (typeof userName !== 'undefined' && userName) || 'Valued Customer' %></div>
          <% const da = (typeof deliveryAddress !== 'undefined' && deliveryAddress) ? deliveryAddress : null; %>
          <div class="info-sub"><%= (da && (da.contact_number || da.phone)) || (typeof userPhone !== 'undefined' && userPhone) || '' %></div>
          <div class="info-sub"><%= da ? ([da.block_number, da.street_name].filter(Boolean).join(' ')) : (typeof userAddress !== 'undefined' ? userAddress : '') %></div>
          <div class="info-sub"><%= da ? (da.unit_number || '') : '' %></div>
          <div class="info-sub"><%= da ? (da.country || '') : '' %></div>
          <div class="info-sub"><%= da ? (da.postal_code || '') : '' %></div>
        </div>

      <div>
        <div class="date-row"><span class="date-label">Date:</span><span class="date-value"><%= new Date(createdAt).toLocaleDateString() %></span></div>
        <div class="date-row"><span class="date-label">Order:</span><span class="date-value">#<%= orderId %></span></div>
        <div class="date-row"><span class="date-label">Payment:</span><span class="date-value"><%= (typeof paymentMethod !== 'undefined' && paymentMethod) || 'Card' %></span></div>
        <div class="date-row"><span class="date-label">Shipping:</span><span class="date-value"><%= (typeof shippingMethod !== 'undefined' && shippingMethod && (shippingMethod.method_name || shippingMethod.name)) || 'Standard' %></span></div>
      </div>
    </div>

    <!-- TABLE -->
    <table class="invoice-table">
      <thead>
        <tr>
          <th>Description</th>
          <th class="text-right">Qty</th>
          <th class="text-right">Unit</th>
          <th class="text-right">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% let computedTotal = 0; %>
        <% items.forEach(it => { 
          const qty = Number(it.quantity || 0);
          const price = Number(it.price || 0);
          const subtotal = qty * price;
          computedTotal += subtotal;
        %>
        <tr>
          <td><%= it.productName %></td>
          <td class="text-right"><%= qty %></td>
          <td class="text-right font-mono">$<%= price.toFixed(2) %></td>
          <td class="text-right font-mono">$<%= subtotal.toFixed(2) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <!-- TOTAL -->
    <div class="totals-section">
      <div class="totals-box">
        <div class="total-row">
          <span>Subtotal</span>
          <span class="font-mono">$<%= computedTotal.toFixed(2) %></span>
        </div>
        <div class="total-row">
          <span>Shipping</span>
          <span class="font-mono">
            <% if (typeof originalShippingFee !== 'undefined' && Number(originalShippingFee) > Number(shippingFee)) { %>
              <s>$<%= Number(originalShippingFee || 0).toFixed(2) %></s>
              &nbsp;<strong style="color:var(--accent)">Free / Discounted</strong>
            <% } else { %>
              $<%= Number((typeof shippingFee !== 'undefined' ? shippingFee : 0)).toFixed(2) %>
            <% } %>
          </span>
        </div>

        <% if (typeof discountAmount !== 'undefined' && Number(discountAmount) > 0) { %>
        <div class="total-row">
          <span>Membership Discount (<%= membershipName || 'Membership' %>)</span>
          <span class="font-mono">- $<%= Number(discountAmount || 0).toFixed(2) %></span>
        </div>
        <% } %>

        <div class="grand-total">
          <span class="grand-total-label">Total</span>
          <span class="grand-total-value font-mono">$<%= (Number(typeof totalAmount !== 'undefined' ? totalAmount : (computedTotal + (typeof shippingFee !== 'undefined' ? shippingFee : 0)))).toFixed(2) %></span>
        </div>
      </div>
    </div>

    <!-- ACTIONS -->
    <div class="actions no-print">
      <a href="/orders" class="btn-invoice btn-outline">Back to Orders</a>

      <!-- ⭐ FIX: PDF download (use query param supported by controller) -->
      <a href="/orders/<%= orderId %>/receipt?download=pdf" class="btn-invoice btn-print">
        <i data-lucide="download"></i>
        Download Invoice
      </a>
    </div>

  </div>
</main>

<%- include('partials/footer') %>

<script>
  lucide.createIcons();
</script>

</body>
</html>
