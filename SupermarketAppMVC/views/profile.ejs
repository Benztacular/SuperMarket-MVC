<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>My Profile</title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  
  <!-- Google Fonts: Plus Jakarta Sans for a tech/modern feel -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* --- THEME VARIABLES --- */
    :root {
      --bg-body: #f8fafc; /* Lighter, cooler gray */
      --primary: #10b981;
      --primary-hover: #059669;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      
      --card-bg: #ffffff;
      --sidebar-bg: #1e293b; /* Dark Slate */
      
      --radius-xl: 24px;
      --radius-lg: 16px;
      --radius-md: 12px;
      
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      
      --header-height: 80px; /* Assumed nav height */
    }

    body {
      background-color: var(--bg-body);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
      /* Refined padding for better visual connection to navbar */
      /* Increased to create more breathing space below header */
      padding-top: calc(var(--header-height) + 80px);
      padding-bottom: 80px;
      background-image: 
        radial-gradient(at 0% 0%, rgba(16, 185, 129, 0.08) 0px, transparent 40%),
        radial-gradient(at 100% 0%, rgba(59, 130, 246, 0.08) 0px, transparent 40%);
      background-attachment: fixed;
    }

    /* --- LAYOUT --- */
    .profile-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      position: relative;
    }

    @media (min-width: 992px) {
      /* Use a two-column flex layout for stable alignment between sidebar and content */
      .profile-container {
        display: flex;
        gap: 3.5rem;
        align-items: start;
      }
      .sidebar-card { flex: 0 0 300px; }
      .content-wrapper { flex: 1 1 0; }
    }

    /* --- LEFT SIDEBAR CARD --- */
    .sidebar-card {
      background: var(--sidebar-bg);
      color: white;
      border-radius: var(--radius-xl);
      padding: 2.5rem 2rem;
      text-align: center;
      box-shadow: var(--shadow-lg);
      position: relative;
      overflow: hidden;
      /* Sticky positioning aligned with content so both cards sit level.
        Use `top: 0` so the sidebar's sticky offset is relative to the
        `.profile-container` (which is already pushed down by body padding).
        This avoids double offsets when JS updates `document.body.style.paddingTop`. */
      position: sticky;
      top: 0;
      z-index: 10;
    }

    /* Decorative blob */
    .sidebar-card::before {
      content: '';
      position: absolute;
      top: -60px; left: -60px;
      width: 200px; height: 200px;
      background: radial-gradient(circle, rgba(16,185,129,0.15) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .avatar-container {
      position: relative;
      width: 120px;
      height: 120px;
      margin: 0 auto 1.5rem;
      border-radius: 50%;
      padding: 4px;
      background: rgba(255,255,255,0.1);
    }

    .avatar-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      background: #fff;
    }
    /* avatar bubble buttons (labelled, clickable) */
    .avatar-bubbles { display:flex; gap:8px; justify-content:center; margin-top:10px; position:relative; z-index:15; }
    .avatar-bubble { padding:6px 10px; border-radius:999px; background: #fff; color: var(--sidebar-bg); font-weight:700; font-size:0.85rem; border: none; cursor: pointer; box-shadow: 0 6px 18px rgba(16,185,129,0.06); transition: transform .12s, background .12s; }
    .avatar-bubble:hover { transform: translateY(-3px); }
    .avatar-bubble.active { background: var(--primary); color: #fff; box-shadow: 0 8px 24px rgba(16,185,129,0.18); }

    /* move bubbles up so they visually sit above the Profile Settings card */
    @media (min-width: 992px) {
      .avatar-bubbles { margin-top: -48px; }
      /* Anchor the floating bubbles to the content card so they move with it */
      .content-card { position: relative; }
        .top-bubbles { position: absolute; top: -44px; right: 28px; left: auto; transform: none; display:flex; gap:8px; z-index:30; }
      .top-bubbles .avatar-bubble { padding:8px 12px; }
    }

      /* Floating add-address FAB (theme color) — when inside .top-bubbles it will sit next to the labelled bubbles */
      .fab-add-address {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        height: 40px;
        min-width: 56px;
        border-radius: 999px;
        background: var(--primary);
        color: #fff;
        box-shadow: 0 8px 18px rgba(16,185,129,0.18);
        border: none;
        cursor: pointer;
        z-index: 35;
        margin-left: 8px;
        font-weight: 700;
        font-size: 0.95rem;
      }
      .fab-add-address:hover { transform: translateY(-2px); }

      /* When layout falls back on small screens, keep FAB absolutely positioned above card */
      @media (max-width: 991px) {
        .fab-add-address { position: absolute; top: -48px; right: 24px; padding: 8px 12px; }
      }

      /* When FAB is placed in the Addresses header, position it above the list
        and align the heading with the card header content for consistent layout */
      .addresses-header { position: relative; padding-left: 0; margin-top: 0.25rem; }
      /* align the Addresses heading text with the Profile header title precisely.
        The card uses 3rem (48px) inner padding; the header title places an icon-box
        (44px) and a 12px gap before the title text. We calculate the total offset
        so the Addresses heading lines up exactly with the Profile header text. */
      .addresses-header h6 { margin: 0; font-size: 1rem; font-weight: 700; color: var(--text-main); padding-left: calc(3rem + 44px + 12px); }
      @media (max-width: 991px) { .addresses-header h6 { padding-left: 0; } }
      .addresses-header .fab-add-address { position: absolute; right: 0; top: -22px; }

      .fab-plus {
        display: inline-flex;
        width: 26px;
        height: 26px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,0.12);
        color: #fff;
        font-weight: 800;
      }

    .user-meta h3 { font-weight: 700; margin-bottom: 0.25rem; font-size: 1.25rem; }
    .user-meta p { color: #94a3b8; font-size: 0.9rem; margin-bottom: 1rem; }

    .role-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 16px;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .role-admin { background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3); }
    .role-user { background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); }

    .btn-photo-upload {
      margin-top: 1.5rem;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.1);
      color: white;
      padding: 0.75rem;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      font-weight: 600;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
    }
    .btn-photo-upload:hover {
      background: var(--primary);
      border-color: var(--primary);
      transform: translateY(-1px);
    }

    .sidebar-menu {
      margin-top: 2.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      border-top: 1px solid rgba(255,255,255,0.1);
      padding-top: 1.5rem;
    }

    .menu-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      color: #cbd5e1;
      text-decoration: none;
      border-radius: var(--radius-md);
      font-size: 0.95rem;
      font-weight: 500;
      transition: all 0.2s;
    }
    .menu-link:hover { background: rgba(255,255,255,0.05); color: white; }
    .menu-link.danger { color: #fca5a5; }
    .menu-link.danger:hover { background: rgba(239, 68, 68, 0.15); color: #fecaca; }

    /* --- RIGHT CONTENT CARD --- */
    .content-card {
      background: var(--card-bg);
      border-radius: var(--radius-xl);
      padding: 3rem; /* Increased inner padding */
      box-shadow: var(--shadow-md);
      border: 1px solid var(--border-color);
    }

    .card-header-styled {
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    .header-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .icon-box {
      width: 44px; height: 44px;
      background: #f0fdf4;
      color: var(--primary);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Modern Inputs */
    .form-label-styled {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .input-styled {
      width: 100%;
      padding: 0.9rem 1.1rem;
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      font-size: 0.95rem;
      color: var(--text-main);
      transition: all 0.2s;
    }
    .input-styled:focus {
      background: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
      outline: none;
    }

    .btn-save-styled {
      background: var(--primary);
      color: white;
      border: none;
      padding: 0.9rem 2rem;
      border-radius: 12px;
      font-weight: 600;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
    }
    .btn-save-styled:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
      color: white;
    }

    /* --- SECURITY GRID (Bento) --- */
    .security-section { margin-top: 4rem; }
    .security-header { margin-bottom: 1.5rem; font-weight: 700; font-size: 1.2rem; }

    .bento-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    @media (min-width: 768px) {
      .bento-grid { grid-template-columns: 1fr 1fr; }
    }

    .bento-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      height: 100%;
    }
    .bento-card:hover {
      border-color: #cbd5e1;
      box-shadow: var(--shadow-lg);
      transform: translateY(-3px);
    }

    .bento-icon {
      width: 42px; height: 42px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.25rem;
    }
    .bg-light-yellow { background: #fffbeb; color: #d97706; }
    .bg-light-green { background: #ecfdf5; color: #059669; }

    .bento-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 0.5rem; }
    .bento-desc { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6; }

    .btn-bento {
      margin-top: auto;
      width: 100%;
      padding: 0.8rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9rem;
      text-align: center;
      border: none;
      cursor: pointer;
      transition: 0.2s;
    }
    .btn-bento-warning { background: #fff7ed; color: #c2410c; border: 1px solid #ffedd5; }
    .btn-bento-warning:hover { background: #ffedd5; border-color: #fed7aa; }

    .btn-bento-success { background: #ecfdf5; color: #047857; border: 1px solid #d1fae5; }
    .btn-bento-success:hover { background: #d1fae5; border-color: #a7f3d0; }

    .btn-bento-danger { background: #fff1f2; color: #be123c; border: 1px solid #ffe4e6; }
    .btn-bento-danger:hover { background: #ffe4e6; }

    /* Char counters */
    .char-count { font-size: 0.75rem; transition: color 0.2s; }
    .char-count.near-limit { color: #f59e0b; }
    .char-count.at-limit { color: #ef4444; }

    /* Modal Styling */
    #changePwdModal .backdrop { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); }
    #changePwdModal .dialog { box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); border: 1px solid #e2e8f0; }

    /* Addresses list items */
    .address-item { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
    .address-item .address-left { max-width: calc(100% - 140px); }
    .address-item .address-left strong { display:block; margin-bottom:6px; }
    .address-item .address-meta { color: var(--text-muted); font-size:0.9rem; line-height:1.4; }
    .address-item .address-postal { color: var(--text-muted); font-size:0.85rem; margin-top:6px; }
    .address-item .address-contact { color: var(--text-muted); font-size:0.85rem; margin-top:6px; }
    .address-actions { min-width:120px; display:flex; flex-direction:column; gap:8px; align-items:flex-end; }
    @media (max-width: 767px) { .address-item { flex-direction: column; } .address-actions { align-items:flex-start; } }
    /* Default addresses body nudge */
    .addresses-body { padding-left: 2rem; }
    @media (max-width: 991px) { .addresses-body { padding-left: 0.75rem; } }

    /* When the Delivery tab is active, switch the content card into
       a left-aligned mode so the addresses line up exactly under the
       header title. We add `addresses-active` to `.content-card` via JS. */
    .content-card.addresses-active .card-header-styled { justify-content: flex-start; gap: 1rem; }
    .content-card.addresses-active .card-header-styled .header-title { margin-right: 1rem; }
    .content-card.addresses-active .addresses-header { padding-left: 0; margin-bottom: 1rem; }
    /* Calculate header text offset: card padding (3rem) + icon-box (44px) + gap (12px) */
    .content-card.addresses-active .addresses-body {
      padding-left: 0;
      margin-left: calc(3rem + 44px + 12px);
      max-width: calc(100% - (calc(3rem + 44px + 12px) + 3rem));
    }
    .content-card.addresses-active .addresses-header .fab-add-address { position: absolute; right: 3rem; top: -22px; }
    @media (max-width: 991px) {
      .content-card.addresses-active .addresses-body { margin-left: 0; max-width: 100%; padding-left: 0.75rem; }
      .content-card.addresses-active .addresses-header .fab-add-address { position: absolute; right: 1rem; }
    }

    /* Membership tier styles (match wallet.ejs colorways) */
    .membership-card { border-radius: 1rem; overflow: hidden; position: relative; }
    .membership-inner { padding: 28px; color: #fff; }

    /* Free: slate gradient (neutral) */
    .membership-free .membership-inner { background: linear-gradient(135deg,#475569 0%, #64748b 50%, #334155 100%); }

    /* Standard: blue / indigo gradient */
    .membership-standard .membership-inner { background: linear-gradient(135deg,#2563eb 0%, #6366f1 50%, #1d4ed8 100%); }

    /* Premium / FreshPlus: amber / yellow gradient */
    .membership-premium .membership-inner { background: linear-gradient(135deg,#d97706 0%, #f59e0b 50%, #b45309 100%); }

    /* Buttons inside membership cards */
    .btn-membership-action{ display:inline-block; width:100%; padding:12px; border-radius:10px; background:rgba(255,255,255,0.12); color:#fff; border:1px solid rgba(255,255,255,0.14); font-weight:700; text-align:center; text-decoration:none; }
    .btn-membership-action.outline{ background:transparent; border:2px solid rgba(255,255,255,0.14); }
  </style>
</head>
<body>

  <%- include('partials/header') %>

  <!-- Main Grid Container -->
  <div class="profile-container">

    <!-- 1. LEFT SIDEBAR (Sticky) -->
    <aside class="sidebar-card">
        <div class="avatar-container">
          <% const avatar = profileUser?.profileImage ? `/images/${profileUser.profileImage}` : '/images/placeholder.png'; %>
          <img src="<%= avatar %>?t=<%= Date.now() %>" class="avatar-img" alt="Avatar">
        
        </div>

      <div class="user-meta">
        <h3><%= profileUser.username %></h3>
        <p><%= profileUser.email %></p>
        
        <div class="mb-4">
          <% if (profileUser.role === 'admin') { %>
            <span class="role-pill role-admin"><i data-lucide="shield" width="12"></i> Admin</span>
          <% } else { %>
            <span class="role-pill role-user"><i data-lucide="user" width="12"></i> User</span>
          <% } %>
        </div>
      </div>

      <!-- Upload Form (Hidden logic maintained) -->
      <form action="/profile" method="post" enctype="multipart/form-data" id="avatarForm" class="w-100">
        <input type="hidden" name="username" value="<%= profileUser.username %>">
        <input type="hidden" name="email" value="<%= profileUser.email %>">
        <input type="hidden" name="address" value="<%= profileUser.address || '' %>">
        <input type="hidden" name="contact" value="<%= profileUser.contact || '' %>">
        <input type="hidden" name="currentProfileImage" value="<%= profileUser.profileImage || '' %>">

        <input type="file" id="avatarInput" name="avatar" accept="image/*" class="d-none" onchange="document.getElementById('avatarForm').submit()">
        
        <button type="button" class="btn-photo-upload" onclick="document.getElementById('avatarInput').click()">
          <i data-lucide="camera" width="16"></i> Change Photo
        </button>
      </form>

      <nav class="sidebar-menu">
        <a href="/shopping" class="menu-link">
          <i data-lucide="shopping-bag" width="18"></i> Return to Shop
        </a>
        <a href="/logout" class="menu-link danger">
          <i data-lucide="log-out" width="18"></i> Sign Out
        </a>
      </nav>
    </aside>

    <!-- 2. RIGHT CONTENT (Scrollable) -->
    <main class="content-wrapper">

      <!-- Alerts -->
      <% if ((typeof error !== 'undefined') && (error||[]).length) { %>
        <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
          <i data-lucide="alert-circle" width="18"></i>
          <div><%- error.join('<br>') %></div>
        </div>
      <% } %>
      <% if ((typeof success !== 'undefined') && (success||[]).length) { %>
        <div class="alert alert-success shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
          <i data-lucide="check-circle" width="18"></i>
          <div><%- success.join('<br>') %></div>
        </div>
      <% } %>

      <div class="content-card">
        <div class="top-bubbles" aria-hidden="false">
          <button type="button" class="avatar-bubble" data-tab="profile">Profile</button>
          <button type="button" class="avatar-bubble" data-tab="addresses">Delivery Address</button>
          <button type="button" class="avatar-bubble" data-tab="membership">Membership</button>
        </div>
        <div class="card-header-styled">
          <div class="header-title">
            <div class="icon-box"><i data-lucide="sliders" width="20"></i></div>
            <span class="header-text">Profile Management</span>
          </div>
        </div>

        <!-- Details Form -->
        <div class="tab-section" data-tab="profile">
          <form action="/profile" method="post" enctype="multipart/form-data" id="detailsForm">
          <div class="row g-4">
            
            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label-styled">
                  Username <span class="char-count" id="usernameCount">0/20</span>
                </label>
                <input name="username" id="usernameInput" class="input-styled" value="<%= profileUser.username %>" maxlength="20">
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label-styled">Email Address</label>
                <input name="email" class="input-styled" value="<%= profileUser.email %>">
              </div>
            </div>

            <div class="col-12">
              <div class="form-group">
                <label class="form-label-styled">Delivery Address</label>
                <input name="address" class="input-styled" value="<%= profileUser.address || '' %>" placeholder="Enter your full address">
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label-styled">
                  Contact Number <span class="char-count" id="contactCount">0/10</span>
                </label>
                <input name="contact" id="contactInput" class="input-styled" value="<%= profileUser.contact || '' %>" maxlength="10" placeholder="0123456789">
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-end mt-4">
            <button class="btn-save-styled" type="submit" id="saveBtn">
              <i data-lucide="save" width="18"></i> Save Changes
            </button>
          </div>
          </form>
        </div>

        <!-- Addresses Tab -->
        <div class="tab-section" data-tab="addresses" style="display:none;">
          <div class="addresses-header d-flex align-items-start mb-3" style="position:relative;">
              <h6 class="mb-0">Saved Delivery Addresses</h6>
              <!-- Ensure button is explicit type and provide a small inline fallback onclick
                   so the modal opens even if event bindings are replaced by other scripts -->
              <button type="button" id="openAddAddressBtn" class="fab-add-address" title="Add address"
                onclick="(function(){const m=document.getElementById('addAddressModal'); if(m){m.style.display='flex'; const f=m.querySelector('input,select,textarea'); if(f) setTimeout(()=>f.focus(),120);} else { const inline=document.getElementById('inlineAddAddress'); if(inline) inline.style.display = inline.style.display === 'block' ? 'none' : 'block'; }})();">
                <span class="fab-plus">+</span> Add new address
              </button>
          </div>
          <div class="addresses-body">
            <div id="addressesList" class="mb-4">
              <!-- Address items will be injected here -->
              <div class="text-muted">Loading addresses...</div>
            </div>

            
          </div>
        </div>

        <!-- Membership Tab -->
        <div class="tab-section" data-tab="membership" style="display:none;">
          <div class="membership-header d-flex align-items-center justify-content-between mb-3">
            <h6 class="mb-0">Membership</h6>
          </div>

          <div class="membership-body p-3">
            <% const tier = Number(userMembership && userMembership.tier_level ? userMembership.tier_level : (userMembership ? 1 : 0)); %>
            <% const tierClass = tier === 3 ? 'membership-premium' : tier === 2 ? 'membership-standard' : 'membership-free'; %>
            <% if (userMembership && tier > 0) { %>
              <div class="membership-card mb-3 <%= tierClass %>">
                <div class="membership-inner">
                  <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px;">
                    <div>
                      <div style="font-size:12px; text-transform:uppercase; opacity:0.85; letter-spacing:1px;">Membership</div>
                      <h2 style="margin:6px 0 0 0; font-size:28px; font-weight:700;"><%= userMembership.plan_name %></h2>
                      <div style="opacity:0.9; font-size:13px; margin-top:6px;">Status: <strong><%= (userMembership.status || 'ACTIVE') %></strong></div>
                      <% if (userMembership.start_date) { %>
                        <div style="font-size:12px; opacity:0.85; margin-top:6px;">Started: <%= new Date(userMembership.start_date).toLocaleDateString() %></div>
                      <% } %>
                      <% if (userMembership.end_date) { %>
                        <div style="font-size:12px; opacity:0.85;">Ends: <%= new Date(userMembership.end_date).toLocaleDateString() %></div>
                      <% } %>
                    </div>
                    <% const memPriceRaw = (userMembership && (userMembership.amount != null ? userMembership.amount : userMembership.plan_price)); %>
                    <% const memPrice = isFinite(Number(memPriceRaw)) ? Number(memPriceRaw) : 0; %>
                    <% const rawPeriod = (userMembership && (userMembership.period || userMembership.billing_period)) ? String(userMembership.period || userMembership.billing_period) : 'MONTHLY'; %>
                    <% const up = rawPeriod.toUpperCase(); %>
                    <% const memPeriod = (up === 'YEARLY' || up === 'ANNUALLY') ? 'Annually' : 'Monthly'; %>
                    <div style="text-align:right;">
                      <div style="font-size:20px; font-weight:700;">$<%= memPrice.toFixed(2) %></div>
                      <div style="font-size:13px; opacity:0.9; margin-top:6px;"><%= memPeriod %></div>
                    </div>
                  </div>

                  <div style="margin-top:18px; display:flex; gap:18px; align-items:flex-start;">
                    <div style="flex:1">
                      <ul style="list-style:none; padding:0; margin:0; color: #eef3fb;">
                        <% if (userMembership.free_standard_delivery) { %>
                          <li style="margin-bottom:8px; display:flex; gap:8px; align-items:center;"><i data-lucide="check-circle" width="16" style="color:#dff3e0;"></i><span>Free standard delivery</span></li>
                        <% } %>
                        <% if (userMembership.points_multiplier) { %>
                          <li style="margin-bottom:8px; display:flex; gap:8px; align-items:center;"><i data-lucide="check-circle" width="16" style="color:#dff3e0;"></i><span>Points multiplier: <%= userMembership.points_multiplier %>x</span></li>
                        <% } %>
                        <% if (userMembership.discount_percent) { %>
                          <li style="margin-bottom:8px; display:flex; gap:8px; align-items:center;"><i data-lucide="check-circle" width="16" style="color:#dff3e0;"></i><span>Discount: <%= userMembership.discount_percent %>%</span></li>
                        <% } %>
                      </ul>
                    </div>
                    <div style="width:220px;">
                      <% if (tier === 2) { %>
                        <form method="POST" action="/profile/membership/cancel" style="margin-bottom:8px;"><button class="btn-membership-action outline" type="submit">Cancel Membership</button></form>
                        <a href="/membership?upgrade=1" class="btn-membership-action" style="display:inline-block;">Upgrade to Premium</a>
                      <% } else if (tier === 3) { %>
                        <form method="POST" action="/profile/membership/cancel"><button class="btn-membership-action outline" type="submit">Cancel Membership</button></form>
                      <% } else { %>
                        <a href="/membership" class="btn-membership-action">Get Membership</a>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% } else { %>
              <div class="membership-card mb-3 membership-free">
                <div class="membership-inner" style="text-align:center;">
                  <div style="font-size:12px; text-transform:uppercase; opacity:0.85; letter-spacing:1px;">Membership</div>
                  <h2 style="margin:8px 0 6px 0; font-size:34px; font-weight:800;">Free</h2>
                  <div style="max-width:720px; margin:8px auto 18px; color: rgba(238,243,251,0.9);">You are currently on the Free plan. Upgrade to get perks like free delivery, higher points multiplier, and exclusive discounts.</div>
                  <a href="/membership" class="btn-membership-action">Upgrade to Premium</a>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Security Section -->
        <div class="security-section">
          <h5 class="security-header">Security & Access</h5>
          
          <div class="bento-grid">
            <!-- Password Card -->
            <div class="bento-card">
              <div class="bento-icon bg-light-yellow"><i data-lucide="key" width="20"></i></div>
              <div class="bento-title">Password</div>
              <div class="bento-desc">Regularly updating your password helps prevent unauthorized access.</div>
              <button id="openChangePwd" class="btn-bento btn-bento-warning">Change Password</button>
            </div>

            <!-- 2FA Card -->
            <div class="bento-card">
              <div class="d-flex justify-content-between align-items-start">
                <div class="bento-icon bg-light-green"><i data-lucide="shield-check" width="20"></i></div>
                <% if (profileUser && profileUser.twoFactorEnabled) { %>
                  <span class="badge bg-success-subtle text-success rounded-pill">ACTIVE</span>
                <% } else { %>
                  <span class="badge bg-secondary-subtle text-secondary rounded-pill">OFF</span>
                <% } %>
              </div>
              
              <div class="bento-title">Two-Factor Auth</div>
              <div class="bento-desc">Secure your account with an additional layer of protection.</div>
              
              <% if (profileUser && profileUser.twoFactorEnabled) { %>
                <form method="POST" action="/profile/2fa/disable" id="disable2faForm" class="mt-auto w-100">
                  <input type="hidden" name="otpCode" id="otpCodeHidden">
                  <button class="btn-bento btn-bento-danger" type="button" id="openDisable2fa">Disable 2FA</button>
                </form>
              <% } else { %>
                <form method="POST" action="/profile/2fa/enable" id="enable2faForm" class="mt-auto w-100">
                  <button class="btn-bento btn-bento-success" type="submit">Enable 2FA</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>

 

  <!-- PASSWORD MODAL (No logic changes) -->
  <div id="changePwdModal" style="position: fixed; inset: 0; display: none; align-items: center; justify-content: center; z-index: 2000;">
    <div class="backdrop" data-close="true" style="position: absolute; inset: 0;"></div>
    <div class="dialog p-4 bg-white rounded-4 w-100" style="position: relative; max-width: 480px;">
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="m-0 fw-bold d-flex align-items-center gap-2">
          <i data-lucide="lock" width="18" class="text-warning"></i> Change Password
        </h5>
        <button id="closeChangePwd" class="btn btn-light btn-sm rounded-circle p-2 lh-1">✕</button>
      </div>
      
      <div id="pwdAlert" class="alert hidden"></div>
      
      <!-- Step 1 -->
      <div class="p-3 mb-3 bg-light rounded-3 border">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge bg-dark rounded-pill">1</span>
          <strong class="small text-uppercase text-muted">Verify Current</strong>
        </div>
        <input id="curPwd" type="password" class="form-control form-control-sm mb-2" placeholder="Enter current password...">
        <button id="verifyPwdBtn" class="btn btn-dark btn-sm w-100">Verify Identity</button>
      </div>

      <!-- Step 2 -->
      <div class="p-3 rounded-3 border">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge bg-warning text-dark rounded-pill">2</span>
          <strong class="small text-uppercase text-muted">Set New</strong>
        </div>
        <input id="newPwd" type="password" class="form-control form-control-sm mb-2" placeholder="New Password" disabled>
        <input id="confirmPwd" type="password" class="form-control form-control-sm mb-3" placeholder="Confirm Password" disabled>
        <button id="submitChangePwd" class="btn btn-warning w-100 fw-bold" disabled>Update Password</button>
      </div>
    </div>
  </div>

  <!-- ADD ADDRESS MODAL -->
  <div id="addAddressModal" style="position: fixed; inset: 0; display: none; align-items: center; justify-content: center; z-index: 2100;">
    <div class="backdrop" data-close="true" style="position: absolute; inset: 0; background: rgba(15,23,42,0.6); backdrop-filter: blur(3px);"></div>
    <div class="dialog p-4 bg-white rounded-4 w-100" style="position: relative; max-width: 640px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); border: 1px solid #e2e8f0;">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="m-0 fw-bold">Add Delivery Address</h5>
        <button type="button" class="btn btn-light btn-sm rounded-circle p-2" id="closeAddAddressModal">✕</button>
      </div>
      <form id="addAddressModalForm">
        <div class="row g-3">
          <div class="col-md-6"><input name="recipient_name" class="input-styled" placeholder="Recipient name" required></div>
          <div class="col-md-6"><input name="contact_number" class="input-styled" placeholder="Contact number (8 digits)" required></div>
          <div class="col-md-4"><input name="block_number" class="input-styled" placeholder="Block number" required></div>
          <div class="col-md-8"><input name="street_name" class="input-styled" placeholder="Street name" required></div>
          <div class="col-md-4"><input name="unit_number" class="input-styled" placeholder="Unit (eg 12-34)" required></div>
          <div class="col-md-4"><input name="postal_code" class="input-styled" placeholder="Postal code (6 digits)" required></div>
          <div class="col-md-4"><select name="country" class="input-styled"><option value="Singapore">Singapore</option></select></div>
        </div>
        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn-save-styled">Save Address</button>
          <button type="button" id="cancelAddAddress" class="btn btn-outline-secondary">Cancel</button>
          <div id="addAddrModalMsg" class="text-muted align-self-center ms-2"></div>
        </div>
      </form>
    </div>
  </div>

  <!-- Disable 2FA Modal -->
  <div id="disable2faModal" style="position: fixed; inset: 0; display: none; align-items: center; justify-content: center; z-index: 2000;">
    <div class="backdrop" data-close="true" style="position: absolute; inset: 0; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px);"></div>
    <div class="dialog p-4 bg-white rounded-4 w-100" style="position: relative; max-width: 420px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); border: 1px solid #e2e8f0;">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="m-0 fw-bold d-flex align-items-center gap-2">
          <i data-lucide="shield-off" width="18" class="text-danger"></i> Confirm Disable
        </h5>
        <button type="button" class="btn btn-light btn-sm rounded-circle p-2 lh-1" id="closeDisable2fa">✕</button>
      </div>
      <p class="text-muted small mb-3">Enter the 6-digit code from your authenticator app to disable two-factor authentication.</p>
      <input type="text" maxlength="6" inputmode="numeric" pattern="\\d{6}" class="form-control fw-semibold text-center tracking-widest" placeholder="000000" id="otpConfirmInput">
      <div id="disable2faError" class="text-danger small mt-2 d-none">Enter a valid 6-digit code.</div>
      <div class="d-flex gap-2 mt-4">
        <button type="button" class="btn btn-outline-secondary w-50" id="cancelDisable2fa">Cancel</button>
        <button type="button" class="btn btn-danger w-50" id="confirmDisable2fa">Disable</button>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    lucide.createIcons();

    // Ensure page content always sits below the site header.
    // This measures the actual header height and applies it to the body padding-top
    // and to the sticky sidebar top so the profile cards never sit beneath the header.
    (function alignBelowHeader(){
      function apply() {
        const header = document.querySelector('header') || document.querySelector('.site-header') || document.querySelector('.navbar');
        const headerH = header ? header.offsetHeight : (parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 80);
        const extra = 90; // breathing room under header
        document.body.style.paddingTop = (headerH + extra) + 'px';
        // Sidebar sticky top is controlled via CSS (top: 0).
        // Avoid setting an explicit `sidebar.style.top` here so the
        // sidebar's initial position remains in-flow with the container.
        const sidebar = document.querySelector('.sidebar-card');
        // ensure headings are adjusted after layout changes
        requestAnimationFrame(() => { if (typeof alignHeaderOffsets === 'function') alignHeaderOffsets(); });
      }
      window.addEventListener('resize', apply);
      document.addEventListener('DOMContentLoaded', apply);
      window.addEventListener('resize', () => { if (typeof alignHeaderOffsets === 'function') alignHeaderOffsets(); });
      document.addEventListener('DOMContentLoaded', () => { if (typeof alignHeaderOffsets === 'function') alignHeaderOffsets(); });
      // run immediately in case script runs after DOM ready
      apply();
    })();

    // 1. Char Count Logic (Preserved)
    function setupCharCount(inputId, countId, max) {
      const input = document.getElementById(inputId);
      const counter = document.getElementById(countId);
      if (!input || !counter) return;

      const updateCount = () => {
        const len = input.value.length;
        counter.textContent = `${len}/${max}`;
        
        counter.classList.remove('near-limit', 'at-limit');
        counter.style.color = '#94a3b8';
        if (len >= max) {
            counter.classList.add('at-limit');
            counter.style.color = ''; // let class handle it
        } else if (len >= max * 0.8) {
            counter.classList.add('near-limit');
            counter.style.color = '';
        }
      };
      input.addEventListener('input', updateCount);
      updateCount();
    }
    setupCharCount('usernameInput', 'usernameCount', 20);
    setupCharCount('contactInput', 'contactCount', 10);

    // Avatar bubble buttons: activate and update hash

    function showTabSection(target) {
      try {
        const card = document.querySelector('.content-card');
        const sections = document.querySelectorAll('.tab-section');
        sections.forEach(s => {
          if (s.dataset && s.dataset.tab === target) s.style.display = 'block';
          else s.style.display = 'none';
        });
        if (card) {
          if (target === 'addresses') {
            card.classList.add('addresses-active');
            if (typeof loadAddresses === 'function') try { loadAddresses(); } catch (e) { console.warn('loadAddresses failed', e); }
          } else {
            card.classList.remove('addresses-active');
          }
        }

        // Hide the Security & Access section when viewing addresses or membership
        try {
          const securitySection = document.querySelector('.security-section');
          if (securitySection) {
            if (target === 'addresses' || target === 'membership') securitySection.style.display = 'none';
            else securitySection.style.display = 'block';
          }
        } catch (e) { /* ignore DOM errors */ }
      } catch (e) { console.warn('showTabSection error', e); }
    }

    (function(){
      const bubbles = document.querySelectorAll('.avatar-bubble');
      if(!bubbles || bubbles.length===0) return;
      bubbles.forEach(btn => btn.addEventListener('click', () => {
        bubbles.forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        const target = btn.dataset.tab;
        if (target) {
          // update URL hash
          location.hash = `#${target}`;
          // show the matching tab section if present
          if (typeof showTabSection === 'function') showTabSection(target);
          // also activate the corresponding tab button if present
          const tabBtn = document.querySelector(`.tab-btn[data-tab="${target}"]`);
          if (tabBtn) tabBtn.click();
        }
      }));

      // If URL has hash on load, activate matching bubble and corresponding tab
      const h = (location.hash||'').replace('#','');
      if (h) {
        const match = Array.from(bubbles).find(b=>b.dataset.tab===h);
        if (match) {
          match.classList.add('active');
          if (typeof showTabSection === 'function') showTabSection(h);
          const tabBtn = document.querySelector(`.tab-btn[data-tab="${h}"]`);
          if (tabBtn) tabBtn.click();
        }
      } else {
        // No hash -> default to `profile` bubble on initial load
        const defaultBubble = Array.from(bubbles).find(b=>b.dataset.tab==='profile');
        if (defaultBubble) {
          defaultBubble.classList.add('active');
          if (typeof showTabSection === 'function') showTabSection('profile');
          const tabBtn = document.querySelector(`.tab-btn[data-tab="profile"]`);
          if (tabBtn) tabBtn.click();
        }
      }
    })();


    // Load addresses via API and render into #addressesList
    async function loadAddresses() {
      const container = document.getElementById('addressesList');
      if (!container) return;
      container.innerHTML = '<div class="text-muted">Loading addresses...</div>';
      try {
        const res = await fetch('/api/delivery-addresses', { credentials: 'same-origin' });
        if (!res.ok) throw new Error('Failed to load');
        const data = await res.json();
        const rows = (data && data.addresses) || [];
        if (rows.length === 0) {
          container.innerHTML = '<div class="text-muted">No saved addresses.</div>';
          return;
        }
        container.innerHTML = '';
        rows.forEach(a => {
          const el = document.createElement('div');
          el.className = 'p-3 mb-2 rounded-3 border address-item';
          el.innerHTML = `
            <div class="address-left">
              <strong>${escapeHtml(a.recipient_name || '')}</strong>
              <div class="address-meta">${escapeHtml(a.block_number || '')} ${escapeHtml(a.street_name || '')} ${escapeHtml(a.unit_number || '')}</div>
              <div class="address-postal">${escapeHtml(a.postal_code || '')}</div>
              <div class="address-contact">${escapeHtml(a.contact_number || '')}</div>
            </div>
            <div class="address-actions">
              ${a.is_default ? '<span class="badge bg-success">Default</span>' : `<button class="btn btn-outline-secondary btn-sm set-default-btn" data-id="${a.id}">Set default</button>`}
            </div>
          `;
          container.appendChild(el);
        });

        // Attach click handlers to Set default buttons to perform AJAX POST
        try {
          const btns = container.querySelectorAll('.set-default-btn');
          btns.forEach(btn => {
            if (btn.__hasHandler) return; // avoid duplicate
            btn.__hasHandler = true;
            btn.addEventListener('click', async function (ev) {
              ev.preventDefault();
              const id = this.dataset.id;
              if (!id) return;
              const origText = this.textContent;
              this.disabled = true;
              this.textContent = 'Setting...';
              try {
                const res = await fetch(`/delivery-addresses/${encodeURIComponent(id)}/default`, {
                  method: 'POST',
                  credentials: 'same-origin',
                  headers: { 'Accept': 'application/json' }
                });
                if (!res.ok) throw new Error('Request failed');
                // Refresh the addresses list to reflect the new default
                if (typeof loadAddresses === 'function') await loadAddresses();
              } catch (e) {
                console.warn('Set default failed', e);
                this.disabled = false;
                this.textContent = origText;
                alert('Unable to set default address. Please try again.');
              }
            });
          });
        } catch (e) { console.warn('attach set-default handlers failed', e); }
      } catch (e) {
        container.innerHTML = '<div class="text-danger">Unable to load addresses.</div>';
      }
    }

    // Add-address modal form handler (AJAX)
    (function(){
      const openBtn = document.getElementById('openAddAddressBtn');
      const modal = document.getElementById('addAddressModal');
      const closeBtn = document.getElementById('closeAddAddressModal');
      const cancelBtn = document.getElementById('cancelAddAddress');
      const backdrop = modal ? modal.querySelector('.backdrop') : null;
      const form = document.getElementById('addAddressModalForm');
      const msg = document.getElementById('addAddrModalMsg');

      function openModal() { if (modal) { modal.style.display = 'flex'; if (msg) msg.textContent = ''; } }
      function closeModal() { if (modal) modal.style.display = 'none'; }

      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (backdrop) backdrop.addEventListener('click', closeModal);

      if (!form) return;
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) { submitBtn.disabled = true; submitBtn.style.opacity = '0.7'; }
        if (msg) msg.textContent = 'Saving...';
        const fd = new FormData(form);
        const payload = {};
        fd.forEach((v,k) => payload[k] = v);
        try {
          const res = await fetch('/api/delivery-addresses', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(payload)
          });
          let data = null;
          try { data = await res.json(); } catch (parseErr) { console.warn('JSON parse failed', parseErr); }
          console.log('POST /api/delivery-addresses', res.status, data);
          if (!res.ok || !(data && data.success)) {
            const message = (data && data.message) || `Server responded with status ${res.status}`;
            if (msg) msg.textContent = message;
            console.error('Failed to save address', message, data);
            if (submitBtn) { submitBtn.disabled = false; submitBtn.style.opacity = ''; }
            return;
          }
          if (msg) msg.textContent = 'Saved';
          form.reset();
          loadAddresses();
          setTimeout(() => { if (msg) msg.textContent = ''; closeModal(); if (submitBtn) { submitBtn.disabled = false; submitBtn.style.opacity = ''; } }, 800);
        } catch (e) {
          console.error('Error saving address', e);
          if (msg) msg.textContent = e.message || 'Error';
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) { submitBtn.disabled = false; submitBtn.style.opacity = ''; }
        }
      });
    })();

    // Robust delegated listener: if the direct binding fails (element replaced
    // by other scripts), ensure clicks on #openAddAddressBtn still open modal.
    document.addEventListener('click', function (ev) {
      const btn = ev.target.closest ? ev.target.closest('#openAddAddressBtn') : null;
      if (!btn) return;
      const modal = document.getElementById('addAddressModal');
      if (modal) {
        modal.style.display = 'flex';
        const first = modal.querySelector('input,select,textarea');
        if (first) setTimeout(() => first.focus(), 120);
      } else {
        // fallback: if modal is not available, toggle inline fallback form
        const inline = document.getElementById('inlineAddAddress');
        if (inline) inline.style.display = inline.style.display === 'block' ? 'none' : 'block';
      }
    });

    function escapeHtml(s) { return String(s || '').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    // 2. Loading State (Preserved)
    function setButtonLoading(btn, text) {
      const originalHtml = btn.innerHTML;
      btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>${text || 'Processing'}`;
      btn.style.opacity = '0.75';
      btn.style.pointerEvents = 'none';
      setTimeout(() => {
        btn.innerHTML = originalHtml;
        btn.style.opacity = '1';
        btn.style.pointerEvents = 'auto';
      }, 5000);
    }

    const saveBtn = document.getElementById('saveBtn');
    if (saveBtn) saveBtn.closest('form').addEventListener('submit', () => setButtonLoading(saveBtn, 'Saving...'));

    const enable2faForm = document.getElementById('enable2faForm');
    if (enable2faForm) enable2faForm.addEventListener('submit', function() {
      setButtonLoading(this.querySelector('button'), 'Enabling...');
    });

    // 3. Modal Logic (Preserved)
    (function () {
      const modal = document.getElementById('changePwdModal');
      const alertEl = document.getElementById('pwdAlert');
      const cur = document.getElementById('curPwd');
      const nw = document.getElementById('newPwd');
      const cf = document.getElementById('confirmPwd');
      const openBtn = document.getElementById('openChangePwd');
      const closeBtn = document.getElementById('closeChangePwd');
      const verifyBtn = document.getElementById('verifyPwdBtn');
      const submitBtn = document.getElementById('submitChangePwd');

      function show(msg, ok) {
        alertEl.textContent = msg;
        alertEl.classList.remove('hidden');
        alertEl.className = ok ? 'alert alert-success' : 'alert alert-danger';
        alertEl.style.display = 'block';
      }
      function hideMsg() { 
        alertEl.classList.add('hidden'); 
        alertEl.style.display = 'none';
      }
      function setStep(isOk) { nw.disabled = cf.disabled = submitBtn.disabled = !isOk; }
      function openModal() { hideMsg(); modal.style.display = 'flex'; cur.value = nw.value = cf.value = ''; setStep(false); }
      function closeModal() { modal.style.display = 'none'; }

      if(openBtn) openBtn.onclick = openModal;
      if(closeBtn) closeBtn.onclick = closeModal;
      if(modal) modal.querySelector('.backdrop').onclick = closeModal;

      if(verifyBtn) verifyBtn.onclick = async () => {
        const pwd = cur.value.trim();
        if (!pwd) return show("Enter current password", false);
        const originalText = verifyBtn.innerText;
        verifyBtn.innerText = "Verifying...";
        try {
          const res = await fetch('/profile/password/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ currentPassword: pwd })
          });
          const data = await res.json();
          if (data.success) {
            show("Verified ✔", true);
            setStep(true);
          } else {
            show(data.message || "Incorrect password", false);
          }
        } catch(e) { show("Error verifying", false); } 
        finally { verifyBtn.innerText = originalText; }
      };

      if(submitBtn) submitBtn.onclick = async () => {
        const newPwd = nw.value.trim();
        const confirm = cf.value.trim();
        const originalText = submitBtn.innerText;
        submitBtn.innerText = "Updating...";
        try {
          const res = await fetch('/profile/password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newPassword: newPwd, confirmPassword: confirm })
          });
          const data = await res.json();
          if (data.success) {
            show("Password updated ✔", true);
            setTimeout(closeModal, 1000);
          } else {
            show(data.message || "Failed", false);
            submitBtn.innerText = originalText;
          }
        } catch(e) { 
          show("Error updating", false); 
          submitBtn.innerText = originalText;
        }
      };
    })();

    (function () {
      const modal = document.getElementById('disable2faModal');
      const openBtn = document.getElementById('openDisable2fa');
      const closeBtn = document.getElementById('closeDisable2fa');
      const cancelBtn = document.getElementById('cancelDisable2fa');
      const confirmBtn = document.getElementById('confirmDisable2fa');
      const backdrop = modal ? modal.querySelector('.backdrop') : null;
      const otpInput = document.getElementById('otpConfirmInput');
      const errorBox = document.getElementById('disable2faError');
      const form = document.getElementById('disable2faForm');
      const hiddenField = document.getElementById('otpCodeHidden');

      if (!modal || !form || !openBtn || !hiddenField) return;

      function showModal() {
        errorBox?.classList.add('d-none');
        otpInput.value = '';
        modal.style.display = 'flex';
        setTimeout(() => otpInput.focus(), 100);
      }
      function hideModal() {
        modal.style.display = 'none';
      }
      function showError(msg) {
        if (!errorBox) return;
        errorBox.textContent = msg;
        errorBox.classList.remove('d-none');
      }

      openBtn.addEventListener('click', showModal);
      closeBtn?.addEventListener('click', hideModal);
      cancelBtn?.addEventListener('click', hideModal);
      backdrop?.addEventListener('click', hideModal);

      confirmBtn?.addEventListener('click', () => {
        const code = otpInput.value.trim();
        if (!/^\d{6}$/.test(code)) {
          showError('Enter a valid 6-digit code.');
          return;
        }
        hiddenField.value = code;
        hideModal();
        setButtonLoading(openBtn, 'Disabling...');
        form.submit();
      });
    })();
  </script>
</body>
</html>