<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;700;800;900&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS (include before Tailwind so utilities can override bootstrap where needed) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome (icons used in sidebar and other views) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Tailwind CSS (Ensure you have this loaded in your project) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* Custom smooth transition for the in-pill label reveal */
        .nav-text {
            display: inline-block;
            max-width: 0;
            opacity: 0;
            overflow: hidden;
            white-space: nowrap;
            vertical-align: middle;
            transform: translateX(-6px);
            transition: max-width 220ms cubic-bezier(0.4,0,0.2,1), opacity 160ms ease, transform 160ms ease;
        }

        /* When hovering (or focused) expand the label inside the pill */
        .nav-item:hover .nav-text,
        .nav-item:focus .nav-text,
        .nav-item.active .nav-text {
            max-width: 160px; /* plenty to display the label */
            opacity: 1;
            transform: translateX(0);
            margin-left: 8px;
        }
        /* small visual tweak to keep dropdown z-order consistent */
        .header-dropdown { z-index: 60; }

        :root {
            --brand-primary: #00dc82; /* fresh neon green */
            --brand-secondary: #059669; /* deeper green */
            --brand-dark: #07281b;
            --brand-surface: rgba(2, 38, 25, 0.92); /* green-tinted glass */
                --nav-height: 92px; /* increased for breathing room */
            --glow: 0 0 28px rgba(0, 220, 130, 0.28);
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
        }

        /* Ensure content is pushed below the fixed navbar immediately (no JS required) */
        html, body { overflow-x: hidden; }
        body { padding-top: var(--nav-height); overflow-x: hidden; }

        .app-navbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            width: 100%;
            height: var(--nav-height);
            z-index: 1030;
            background: var(--brand-surface);
            backdrop-filter: blur(16px) saturate(180%); /* Enhanced glass effect */
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border-bottom: 1px solid rgba(255,255,255,0.08); /*Subtle edge */
            box-shadow: 0 4px 30px rgba(0,0,0,0.1);
            margin: 0;
            padding: 0;
        }

        .navbar-container {
            width: 100%;
            max-width: 100%; /* Ensure full width */
            margin: 0;
            padding: 0 1.5rem; /* Standard horizontal padding */
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .brand-logo-box {
            width: 46px; height: 46px;
            background: linear-gradient(135deg,var(--brand-primary),var(--brand-secondary));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--glow);
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            color: white;
            transform: rotate(-6deg);
            transition: all 0.32s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid rgba(255,255,255,0.06);
        }

        .navbar-brand:hover .brand-logo-box {
            transform: rotate(0deg) scale(1.06);
            box-shadow: 0 8px 30px rgba(0, 220, 130, 0.22);
        }

        .brand-text-wrap {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .brand-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 1.2rem;
            color: #fff;
        }

        .brand-subtitle {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.6px;
            background: linear-gradient(90deg,#34d399,#bbf7d0);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            color: var(--text-muted) !important;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 10px;
            transition: all .22s;
        }

        .nav-link:hover, .nav-link.active {
            color: #fff !important;
            background: rgba(0,220,130,0.10);
            border-color: rgba(0,220,130,0.14);
        }

        /* keep navbar contents on one line and remove underlines */
        .navbar-container,
        .navbar-container > .h-full,
        .app-navbar a,
        #mobile-menu a {
          white-space: nowrap;
          text-decoration: none !important;
        }

        /* allow horizontal scrolling on small screens for mobile menu */
        #mobile-menu .menu-row {
          display: flex;
          gap: 0.75rem;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          padding: 0.5rem 1rem;
          white-space: nowrap;
        }

        /* make mobile anchors inline and prevent wrapping of label */
        #mobile-menu .menu-row a {
          display: inline-flex;
          align-items: center;
          gap: 0.75rem;
          flex: 0 0 auto; /* don't shrink, keep content on single row */
          text-decoration: none;
        }

        /* small-screen tweaks */
        @media(max-width:991px){
            .brand-subtitle { display:none; }
            .navbar-container { padding: 0 1rem; }
        }
    </style>
</head>
<body class="bg-slate-50 font-sans" style="padding-top: var(--nav-height); overflow-x: hidden;">

    <!-- MAIN NAVBAR CONTAINER -->
    <nav class="app-navbar fixed-top w-full">
        <div class="container-fluid navbar-container">
            <div class="w-full h-full">
                <!-- Removed inner capsule styling (rounded, borders, bg) to allow full width flow -->
                <div class="h-full flex items-center justify-between w-full">
                    
                    <!-- LEFT: Logo Area -->
                    <a href="/" class="flex items-center gap-3 w-52 group cursor-pointer no-underline">
                        <!-- Logo Box -->
                        <div class="brand-logo-box">
                            FM
                        </div>
                        
                        <div class="hidden md:flex flex-col leading-tight">
                            <h1 class="text-white font-extrabold text-xl tracking-tight leading-none m-0">Freshmart</h1>
                            <p class="text-[10px] uppercase tracking-[0.12em] font-bold bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent m-0">
                                Premium Groceries
                            </p>
                        </div>
                    </a>

                    <!-- CENTER: Interactive Icon Menu (Hidden on mobile) -->
                    <div class="hidden md:flex items-center justify-center gap-2 bg-white/5 p-1.5 rounded-full border border-white/5">
                        
                        <% 
                        const navItems = [
                            { icon: 'home', label: 'Home', link: '/' },
                            { icon: 'shopping-basket', label: 'Shopping', link: '/shopping' },
                            { icon: 'inbox', label: 'Orders', link: '/orderHistory' },
                            { icon: 'wallet', label: 'Wallet', link: '/wallet' },
                            { icon: 'star', label: 'Membership', link: '/membership' }
                        ];
                        // show admin shortcut for admin users
                        if (typeof user !== 'undefined' && user && String(user.role || '').toLowerCase() === 'admin') {
                            navItems.push({ icon: 'shield', label: 'Admin', link: '/admin' });
                        }
                        %>

                        <% navItems.forEach(function(item) { %>
                            <a href="<%= item.link %>" class="nav-item relative flex items-center gap-2 px-4 py-2 rounded-full transition-all duration-300 ease-out group text-slate-400 hover:text-white hover:bg-white/5 no-underline"
                               title="<%= item.label %>" aria-label="<%= item.label %>" data-tooltip="<%= item.label %>">
                                <!-- Icon -->
                                <i data-lucide="<%= item.icon %>" class="w-5 h-5 transition-transform duration-300 group-hover:scale-110"></i>
                                 <!-- Text Label -->
                                <span class="nav-text w-0 opacity-0 overflow-hidden whitespace-nowrap group-hover:w-auto group-hover:opacity-100 group-hover:ml-2 text-sm font-medium">
                                    <%= item.label %>
                                </span>
                                <!-- Active Indicator (Hidden by default, toggled via JS matches) -->
                                <span class="active-indicator hidden absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-white rounded-full opacity-50"></span>
                            </a>
                        <% }); %>
                    </div>

                    <style>
                        /* Ensure pseudo-tooltips are not used — labels expand inline instead */
                        .nav-item[data-tooltip]::after,
                        .nav-item[data-tooltip]::before { display: none !important; }
                        @media(max-width:991px){
                            /* on mobile keep the expanded labels visible in the menu; hide inline expansion */
                            .nav-text { max-width: none !important; opacity: 1 !important; transform: none !important; margin-left: 8px; }
                        }
                    </style>

                    <!-- RIGHT: Actions & Profile -->
                    <div class="flex items-center justify-end gap-3 w-56">
                        
                        <!-- Cart with Badge -->
                        <a href="/cart" class="relative p-2 text-slate-400 hover:text-emerald-300 hover:bg-emerald-500/10 rounded-full transition-colors group">
                            <i data-lucide="shopping-cart" class="w-5 h-5 group-hover:fill-current transition-all group-hover:-rotate-12 group-hover:scale-110"></i>
                            <span class="absolute top-2.5 right-2.5 w-2.5 h-2.5 bg-rose-500 rounded-full ring-2 ring-[#1a1b2e] animate-pulse">
                                <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
                                    <!-- number badge could be implemented here -->
                                <% } %>
                            </span>
                        </a>

                        <div class="h-8 w-px bg-white/10 mx-1 hidden md:block"></div>

                        <!-- Profile Section -->
                        <% if (typeof user !== 'undefined' && user) { %>
                            <!-- Logged In State -->
                            <div class="relative dropdown-container header-dropdown">
                                <button id="user-menu-btn" class="hidden md:flex items-center gap-3 pl-1 pr-4 py-1 rounded-full border border-white/5 hover:bg-white/5 transition-all">
                                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-emerald-500 to-green-600 p-0.5 shadow-[0_0_12px_rgba(0,220,130,0.18)]">
                                        <% 
                                            const ver = Date.now();
                                            const rawAvatar = user.profileImage || user.profile_image || user.avatar || '';
                                            const avatarFile = rawAvatar.replace(/\\/g, '/').split('/').pop();
                                            const img = /^https?:\/\//i.test(rawAvatar) ? `${rawAvatar}?v=${ver}` : (avatarFile ? `/images/${avatarFile}?v=${ver}` : 'https://api.dicebear.com/7.x/avataaars/svg?seed=Felix');
                                        %>
                                        <img src="<%= img %>" alt="User" class="w-full h-full rounded-full bg-[#1a1b2e] object-cover" onerror="this.onerror=null;this.src='/images/placeholder-pfp-gray.svg'" />
                                    </div>
                                    <div class="flex flex-col items-start">
                                        <span class="text-sm font-medium text-white group-hover:text-emerald-100 transition-colors">
                                            <%= user.username || user.email || 'User' %>
                                        </span>
                                    </div>
                                </button>

                                <!-- Dropdown Menu (Click to Toggle) -->
                                <div id="user-menu-dropdown" class="absolute right-0 top-full mt-2 w-52 bg-[#1a1b2e] border border-white/10 rounded-xl shadow-xl opacity-0 invisible transition-all duration-200 transform origin-top-right z-50 overflow-hidden">
                                    <a href="/profile" class="block px-5 py-3 text-sm text-slate-400 hover:text-white hover:bg-white/5">Profile</a>
                                    <div class="h-px bg-white/10 my-1"></div>
                                    <a href="/logout" class="block px-5 py-3 text-sm text-rose-400 hover:bg-white/5">Sign Out</a>
                                </div>
                            </div>
                        <% } else { %>
                            <!-- Guest State -->
                            <div class="hidden md:flex items-center gap-3">
                                <a href="/login" class="text-sm font-medium text-slate-400 hover:text-white transition-colors">Log In</a>
                                <a href="/register" class="px-4 py-2 bg-gradient-to-r from-emerald-500 to-green-600 text-white text-sm font-bold rounded-full shadow hover:shadow-emerald-400/25 transition-all">
                                    Sign Up
                                </a>
                            </div>
                        <% } %>

                        <!-- Mobile Menu Toggle -->
                        <button id="mobile-menu-btn" class="md:hidden p-2 text-white bg-white/10 rounded-lg hover:bg-white/20 transition-colors">
                            <i data-lucide="menu" id="menu-icon" class="w-6 h-6"></i>
                            <i data-lucide="x" id="close-icon" class="w-6 h-6 hidden"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MOBILE MENU DROPDOWN -->
        <div id="mobile-menu" class="md:hidden absolute top-[70px] left-0 right-0 bg-[#1a1b2e] border-b border-white/10 shadow-2xl overflow-hidden transition-all duration-300 origin-top opacity-0 scale-95 -translate-y-4 pointer-events-none">
            <div class="p-4 space-y-2">
                <div class="menu-row">
                  <% navItems.forEach(function(item) { %>
                      <a href="<%= item.link %>" class="inline-flex items-center gap-4 px-4 py-3 rounded-xl text-slate-400 hover:bg-white/5 hover:text-white transition-all no-underline">
                          <i data-lucide="<%= item.icon %>" class="w-5 h-5"></i>
                          <span class="font-medium text-base"><%= item.label %></span>
                      </a>
                  <% }); %>
                </div>
                
                <div class="h-px bg-white/10 my-2 mx-4"></div>
                
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="px-4 py-3 flex items-center gap-3 text-slate-400">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-violet-600 to-fuchsia-600 p-[1px]">
                            <div class="w-full h-full rounded-full bg-[#1a1b2e] flex items-center justify-center">
                                <i data-lucide="user" class="w-5 h-5 text-violet-400"></i>
                            </div>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-base text-white font-medium"><%= user.username || 'User' %></span>
                            <a href="/profile" class="text-xs text-slate-500 hover:text-violet-400">View Profile</a>
                        </div>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-2 gap-3 px-4 pb-2">
                        <a href="/login" class="text-center py-3 rounded-xl bg-white/5 text-slate-300 hover:bg-white/10 hover:text-white transition-colors">Log In</a>
                        <a href="/register" class="text-center py-3 rounded-xl bg-violet-600 text-white font-medium hover:bg-violet-700 transition-colors">Sign Up</a>
                    </div>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Flash messages (rendered only from this partial) -->
    <div class="container mt-0" style="z-index:1050; position:relative;">
        <% 
           const successList = Array.isArray(typeof success_msg !== 'undefined' ? success_msg : undefined) ? success_msg : (Array.isArray(typeof success !== 'undefined' ? success : undefined) ? success : ((typeof messages !== 'undefined' && messages && Array.isArray(messages.success)) ? messages.success : []));
           const errorList = Array.isArray(typeof error_msg !== 'undefined' ? error_msg : undefined) ? error_msg : (Array.isArray(typeof error !== 'undefined' ? error : undefined) ? error : ((typeof messages !== 'undefined' && messages && Array.isArray(messages.error)) ? messages.error : []));
        %>

        <% if (Array.isArray(successList) && successList.length) { %>
            <% successList.forEach(function(msg) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% }) %>
        <% } %>

        <% if (Array.isArray(errorList) && errorList.length) { %>
            <% errorList.forEach(function(msg) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% }) %>
        <% } %>
    </div>

    <!-- Client-side Logic for Interactions -->
    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // 1. Mobile Menu Logic
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');
        let isMenuOpen = false;

        if(mobileBtn) {
            mobileBtn.addEventListener('click', () => {
                isMenuOpen = !isMenuOpen;
                if (isMenuOpen) {
                    mobileMenu.classList.remove('opacity-0', 'scale-95', '-translate-y-4', 'pointer-events-none');
                    mobileMenu.classList.add('opacity-100', 'scale-100', 'translate-y-0');
                    menuIcon.classList.add('hidden');
                    closeIcon.classList.remove('hidden');
                } else {
                    mobileMenu.classList.add('opacity-0', 'scale-95', '-translate-y-4', 'pointer-events-none');
                    mobileMenu.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
                    menuIcon.classList.remove('hidden');
                    closeIcon.classList.add('hidden');
                }
            });
        }

        // 2. Desktop Profile Dropdown Logic (Added Fix)
        const userMenuBtn = document.getElementById('user-menu-btn');
        const userMenuDropdown = document.getElementById('user-menu-dropdown');

        if (userMenuBtn && userMenuDropdown) {
            userMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = userMenuDropdown.classList.contains('invisible');
                if (isHidden) {
                    userMenuDropdown.classList.remove('invisible', 'opacity-0');
                    userMenuDropdown.classList.add('visible', 'opacity-100');
                } else {
                    userMenuDropdown.classList.add('invisible', 'opacity-0');
                    userMenuDropdown.classList.remove('visible', 'opacity-100');
                }
            });

            // Close when clicking outside
            document.addEventListener('click', (e) => {
                if (!userMenuBtn.contains(e.target) && !userMenuDropdown.contains(e.target)) {
                    userMenuDropdown.classList.add('invisible', 'opacity-0');
                    userMenuDropdown.classList.remove('visible', 'opacity-100');
                }
            });
        }

        // 3. Active Tab Logic
                const currentPath = window.location.pathname;
                const navLinks = document.querySelectorAll('.nav-item');
                const adminHref = '/admin';
        
        navLinks.forEach(link => {
                        const href = link.getAttribute('href') || '';
                        const isAdminLink = href === adminHref;
                        const isActive = (isAdminLink && currentPath.startsWith('/admin'))
                            || (href && href !== '/' && currentPath.startsWith(href))
                            || (href === currentPath);

                        if (isActive) {
                            link.classList.add('bg-emerald-600', 'text-white', 'shadow-lg', 'shadow-emerald-400/25', 'ring-1', 'ring-white/20');
                            link.classList.remove('text-slate-400', 'hover:text-white', 'hover:bg-white/5');
                            const textSpan = link.querySelector('.nav-text');
                            if (textSpan) {
                                textSpan.classList.remove('w-0', 'opacity-0', 'group-hover:w-auto', 'group-hover:opacity-100');
                                textSpan.classList.add('w-auto', 'opacity-100', 'ml-2');
                            }
                            const indicator = link.querySelector('.active-indicator');
                            if (indicator) indicator.classList.remove('hidden');
                            const icon = link.querySelector('i');
                            if (icon) icon.classList.remove('group-hover:scale-110');
                        }
        });
        // Recalculate body spacing when a nav item is clicked (active label expansion may change header size)
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                // allow active classes to apply
                setTimeout(() => {
                    try { if (typeof adjustBodySpacing === 'function') adjustBodySpacing(); } catch(e){}
                    try { if (window.updateChatLayout) window.updateChatLayout(); } catch(e){}
                }, 80);
            });
        });

        // Ensure body padding respects nav & footer heights
        function adjustBodySpacing() {
            const nav = document.querySelector('.app-navbar');
            const footer = document.querySelector('.app-footer');
            const navH = nav ? (parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || nav.offsetHeight) : 0;

            // Only reserve bottom padding when footer is fixed/sticky — if footer is static (in-flow), no extra padding
            let footerH = 0;
            if (footer) {
                const footerPos = getComputedStyle(footer).position || '';
                if (footerPos === 'fixed' || footerPos === 'sticky') {
                    footerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--footer-height')) || footer.offsetHeight || 0;
                } else {
                    footerH = 0;
                }
            }

            document.body.style.paddingTop = navH + 'px';
            document.body.style.paddingBottom = footerH + 'px';
            // also expose CSS vars
            document.documentElement.style.setProperty('--nav-height', navH + 'px');
            document.documentElement.style.setProperty('--footer-height', (footer && footer.offsetHeight) ? (footer.offsetHeight + 'px') : (footerH + 'px'));
        }

        // expose globally so pages (e.g., chat) can call it
        window.adjustBodySpacing = adjustBodySpacing;

        document.addEventListener('DOMContentLoaded', adjustBodySpacing);
        window.addEventListener('resize', adjustBodySpacing);
    </script>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>