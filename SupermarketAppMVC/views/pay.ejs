<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Confirm Payment - FreshMart</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">

  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --brand-primary: #10b981;
      --brand-primary-dark: #059669;
      --brand-primary-light: #d1fae5;
      --brand-dark: #0f172a;
      --bg-body: #f1f5f9;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 24px;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
      --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.01);
      --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
      background-color: var(--bg-body);
      font-family: 'Inter', sans-serif;
      color: var(--text-main);
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--brand-dark);
      font-weight: 700;
      letter-spacing: -0.025em;
    }

    a { text-decoration: none; color: inherit; transition: var(--transition); }

    .cart-page {
      padding-top: 1.25rem;
      padding-bottom: 5rem;
      max-width: 1200px;
      /* ensure page fills available space between header and footer */
      min-height: calc(100vh - var(--nav-height, 92px) - var(--footer-height, 80px) - 32px);
    }

    .checkout-stepper {
      display: flex;
      justify-content: center;
      margin-top: 0;
      margin-bottom: 2rem;
      position: relative;
    }
    .step-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-muted);
      font-weight: 500;
      font-size: 0.9rem;
      position: relative;
      z-index: 2;
    }
    .step-item.active {
      color: var(--brand-dark);
      font-weight: 700;
    }
    .step-item.completed {
      color: var(--brand-primary);
    }
    .step-circle {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #e2e8f0;
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      transition: all 0.3s;
    }
    .step-item.active .step-circle {
      background: var(--brand-dark);
      color: white;
      box-shadow: 0 0 0 4px rgba(30, 41, 59, 0.1);
    }
    .step-item.completed .step-circle {
      background: var(--brand-primary);
      color: white;
    }
    .step-divider {
      width: 60px;
      height: 2px;
      background: #e2e8f0;
      margin: 0 1rem;
      align-self: center;
    }
    .step-item.completed + .step-divider {
      background: var(--brand-primary);
    }

    .checkout-grid {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 28px;
      align-items: start;
    }

    .section-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      margin-bottom: 1.5rem;
    }

    .card-header-custom {
      padding: 1.5rem;
      border-bottom: 1px solid var(--border-color);
      background: #fafafa;
    }

    .order-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    .order-table thead th {
      text-align: left;
      padding: 1rem 1.5rem;
      font-weight: 600;
      color: var(--text-muted);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--border-color);
      background: #f8fafc;
    }
    .order-table tbody tr td {
      padding: 1.1rem 1.5rem;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
    }
    .order-table tbody tr:last-child td { border-bottom: none; }

    .product-cell { display: flex; align-items: center; gap: 1rem; }
    .product-cell img {
      width: 56px;
      height: 56px;
      object-fit: cover;
      border-radius: 10px;
      background: #f8fafc;
      border: 1px solid #f1f5f9;
    }
    .product-cell .name {
      font-weight: 600;
      color: var(--brand-dark);
      font-size: 0.95rem;
    }

    .qty-cell { font-weight: 600; color: var(--text-main); font-size: 0.95rem; }
    .price-cell { font-weight: 500; color: var(--text-muted); font-size: 0.95rem; }
    .subtotal-cell { font-weight: 700; color: var(--brand-dark); font-size: 1rem; }

    .confirm-summary { position: sticky; top: 110px; }

    .summary-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      padding: 1.75rem !important;
    }

    .summary-card h5 {
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px dashed var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .summary-items { margin-bottom: 0.75rem; }
    .summary-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      font-size: 0.95rem;
      padding: 8px 0;
    }
    .summary-item-left { display: flex; align-items: center; gap: 12px; }
    .summary-thumb {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      object-fit: cover;
      background: #f1f5f9;
      border: 1px solid var(--border-color);
    }
    .summary-meta .name { font-weight: 600; color: var(--text-main); font-size: 0.9rem; line-height: 1.2; }
    .summary-meta .qty { font-size: 0.8rem; color: var(--text-muted); }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 1rem;
      font-size: 0.95rem;
      color: var(--text-muted);
    }
    .summary-row.total {
      font-weight: 700;
      color: var(--brand-dark);
      font-size: 1.25rem;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-color);
      align-items: center;
    }

    .summary-note {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 1.5rem;
      text-align: center;
      line-height: 1.5;
      background: #f8fafc;
      padding: 1rem;
      border-radius: 12px;
      border: 1px solid #f1f5f9;
    }

    .btn-actions { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 12px; }

    .btn-back {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      padding: 12px;
      border-radius: 12px;
      width: 100%;
      font-weight: 500;
      text-align: center;
      text-decoration: none;
      transition: var(--transition);
    }
    .btn-back:hover {
      background: #f1f5f9;
      color: var(--text-main);
      border-color: #cbd5e1;
    }

    @media (max-width: 992px) {
      .checkout-grid { grid-template-columns: 1fr; }
      .confirm-summary { position: static; margin-top: 1rem; width: 100%; }
      .step-divider { width: 30px; margin: 0 0.5rem; }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="container cart-page">
    
    <div class="checkout-stepper">
      <div class="step-item completed">
        <div class="step-circle"><i data-lucide="check" style="width: 14px;"></i></div>
        <span>Shopping Cart</span>
      </div>
      <div class="step-divider"></div>
      <div class="step-item completed">
        <div class="step-circle"><i data-lucide="check" style="width: 14px;"></i></div>
        <span>Checkout</span>
      </div>
      <div class="step-divider"></div>
      <div class="step-item active">
        <div class="step-circle">3</div>
        <span>Payment</span>
      </div>
    </div>

    <div class="checkout-grid">
      
      <div class="main-col">
        <% const rows = (cartItems || items || []);
           function price(n){ const v = Number(n||0); return isFinite(v) ? v.toFixed(2) : '0.00'; }
           const sum = rows.reduce((s, it)=> s + Number(it.price||0)*Number(it.quantity||0), 0);
           const addrList = (typeof addresses !== 'undefined' && addresses) ? addresses : [];
           const shipTo = ((typeof selectedAddress !== 'undefined' && selectedAddress) || (typeof address !== 'undefined' && address) || (addrList.find(a => Number(a.id) === Number(selectedAddressId))) || (addrList.find(a => a.is_default)) || (addrList[0]) || {});
        %>

        <div class="d-flex align-items-baseline justify-content-between mb-4">
          <h2 class="mb-0">Shipping Details</h2>
          <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3"><%= rows.length %> items</span>
        </div>

        <div class="section-card">
          <div class="card-header-custom">
            <h5 class="mb-0">Ship To</h5>
          </div>
          <div class="p-4">
            <div id="ship_recipient" class="fw-bold text-dark"><%= shipTo.recipient_name || 'Recipient not provided' %></div>
            <div id="ship_line1" class="text-muted small mt-1"><%= [shipTo.block_number, shipTo.street_name].filter(Boolean).join(' ') || '-' %></div>
            <div id="ship_unit" class="text-muted small mt-1"><%= shipTo.unit_number || '-' %></div>
            <div id="ship_postal" class="text-muted small mt-1"><%= shipTo.postal_code || '-' %></div>
          </div>
        </div>

          <!-- Items Card (show images, name, qty, unit price) -->
          <div class="section-card">
            <div class="card-header-custom">
              <h5 class="mb-0">Items</h5>
            </div>
            <div class="p-4">
              <% if ((rows || []).length) { %>
                <div class="d-flex flex-column gap-3">
                  <% rows.forEach(function(it){ const qtyVal = (typeof it.quantity !== 'undefined' ? it.quantity : (it.qty || 0)); const unit = Number(it.price || it.unit_price || 0); %>
                    <div class="d-flex align-items-center justify-content-between">
                      <div class="d-flex align-items-center gap-3">
                        <% if (it.image) { %>
                          <img src="/images/<%= it.image %>" alt="<%= it.productName %>" style="width:56px;height:56px;object-fit:cover;border-radius:10px;border:1px solid var(--border-color);background:#f8fafc;">
                        <% } else { %>
                          <div style="width:56px;height:56px;border-radius:10px;background:#f8fafc;border:1px solid var(--border-color);display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:0.8rem;">Img</div>
                        <% } %>
                        <div>
                          <div class="fw-semibold"><%= it.productName %></div>
                          <div class="text-muted small">Qty: <%= qtyVal %></div>
                        </div>
                      </div>
                      <div class="text-muted">$<%= (Number(unit) || 0).toFixed(2) %></div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-muted small">No items</div>
              <% } %>
            </div>
          </div>

      </div>
      
      <div class="confirm-summary">
        <div class="summary-card" data-subtotal="<%= price(sum) %>">
          <h5>Order Details <i data-lucide="receipt" style="width: 18px; color: #94a3b8;"></i></h5>

          <div class="summary-items">
            <!-- Item list moved to left column 'Items' card to match checkout layout -->
          </div>

          <div class="summary-row">
            <span>Subtotal</span>
            <span>$<%= price(sum) %></span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span class="text-success fw-bold">$<%= Number(shippingFee || 0).toFixed(2) %></span>
          </div>

          <div class="summary-row total">
            <span>Total</span>
            <span style="font-size: 1.5rem;">$<span id="totalCost"><%= Number(totalWithShipping || (sum + (shippingFee || 0))).toFixed(2) %></span></span>
          </div>

          <div class="btn-actions"></div>

          <div style="margin-top:12px;">
            <form id="nets-qr-form" action="/nets-qr" method="POST" style="margin-bottom:12px;">
              <input type="hidden" name="cartTotal" value="<%= Number(totalWithShipping || (sum + (shippingFee || 0))).toFixed(2) %>">
              <button type="submit" class="nets-qr-btn" style="width:100%; height:44px; padding:8px 12px; border-radius:10px; background:#f6c200; border:1px solid rgba(0,0,0,0.06); font-weight:700; display:flex; align-items:center; justify-content:center;">
                <img src="/images/netsLogo.png" alt="Nets QR" style="height:24px; width:auto; display:block;">
              </button>
            </form>
            
            <button id="stripe-button" class="stripe-btn" style="width:100%; height:44px; padding:8px 16px; border-radius:10px; background:#635bff; border:none; font-weight:600; color:white; display:flex; align-items:center; justify-content:center; margin-bottom:12px; cursor:pointer; transition: all 0.2s;">
              <svg style="width:18px; height:18px; margin-right:8px;" viewBox="0 0 24 24" fill="white">
                <path d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697 0 12.165 0 9.667 0 7.589.654 6.104 1.872 4.56 3.147 3.757 4.992 3.757 7.218c0 4.039 2.467 5.76 6.476 7.219 2.585.92 3.445 1.574 3.445 2.583 0 .98-.84 1.545-2.354 1.545-1.875 0-4.965-.921-6.99-2.109l-.9 5.555C5.175 22.99 8.385 24 11.714 24c2.641 0 4.843-.624 6.328-1.813 1.664-1.305 2.525-3.236 2.525-5.732 0-4.128-2.524-5.851-6.594-7.305h.003z"/>
              </svg>
              Pay with Stripe
            </button>
            
            <div id="paypal-button-container"></div>
          </div>

          <div class="summary-note">
            <div style="display:flex; justify-content:center; gap:8px; margin-bottom:8px; opacity:0.6;">
               <i data-lucide="lock" style="width:14px"></i> <strong>Secure Checkout</strong>
            </div>
            By completing payment, you accept our Terms & Conditions.
          </div>
        </div>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>
  <script>
    (function(){
      const clientId = '<%= paypalClientId || "" %>';
      const currency = '<%= paypalCurrency || "SGD" %>';
      if (!clientId) return console.warn('PayPal Client ID not configured');

      const sdkUrl = `https://www.paypal.com/sdk/js?client-id=${clientId}&currency=${encodeURIComponent(currency)}`;
      const s = document.createElement('script');
      s.src = sdkUrl;
      s.onload = () => {
        if (!window.paypal) return console.error('PayPal SDK failed to load');

        paypal.Buttons({
          createOrder() {
            return fetch('/paypal/create-order', { method: 'POST', credentials: 'same-origin' })
              .then(r => r.json())
              .then(data => {
                if (!data || !data.orderID) throw new Error('No orderID returned');
                return data.orderID;
              });
          },
          onApprove(data) {
            return fetch('/paypal/capture-order', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderID: data.orderID })
            }).then(r => r.json()).then(resp => {
              if (resp && resp.redirect) return window.location = resp.redirect;
              if (resp && resp.success) return window.location = '/orders';
              console.error('Capture failed', resp);
            });
          },
          onError(err) { console.error('PayPal Buttons error', err); }
        }).render('#paypal-button-container');
      };
      document.body.appendChild(s);
    })();
  </script>
  <script>
    (function(){
      function tryPopulateFromCheckout(html){
        try{
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          let sel = doc.querySelector('label.address-card.active');
          if (!sel) sel = doc.querySelector('input[name="address_id"]:checked') && doc.querySelector('input[name="address_id"]:checked').closest('label.address-card');
          if (!sel) return false;
          const nameEl = sel.querySelector('.fw-bold') || sel.querySelector('span');
          const lines = Array.from(sel.querySelectorAll('.text-muted.small')).map(n=>n.textContent.trim()).filter(Boolean);
          if (nameEl) document.getElementById('ship_recipient').textContent = nameEl.textContent.trim();
          if (lines[0]) document.getElementById('ship_line1').textContent = lines[0];
          if (lines[1]) document.getElementById('ship_unit').textContent = lines[1];
          if (lines[2]) document.getElementById('ship_postal').textContent = lines[2];
          return true;
        }catch(e){ return false; }
      }

      fetch('/cart/checkout', { credentials: 'same-origin' }).then(r => r.text()).then(html => {
        if (!tryPopulateFromCheckout(html)) {
          fetch('/api/delivery-addresses', { credentials: 'same-origin' }).then(r => r.json()).then(json => {
            const addrs = (json && json.addresses) || [];
            if (!addrs.length) return;
            const chosen = addrs.find(a => a.is_default) || addrs[0];
            if (!chosen) return;
            document.getElementById('ship_recipient').textContent = chosen.recipient_name || 'Recipient not provided';
            document.getElementById('ship_line1').textContent = [chosen.block_number, chosen.street_name].filter(Boolean).join(' ') || '-';
            document.getElementById('ship_unit').textContent = chosen.unit_number || '-';
            document.getElementById('ship_postal').textContent = chosen.postal_code || '-';
          }).catch(()=>{});
        }
      }).catch(()=>{});
    })();
  </script>
  
  <!-- Stripe Integration -->
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    (function(){
      const stripePublicKey = '<%= process.env.STRIPE_PUBLISHABLE_KEY || "" %>';
      if (!stripePublicKey) {
        console.warn('Stripe Publishable Key not configured');
        document.getElementById('stripe-button').style.display = 'none';
        return;
      }

      const stripe = Stripe(stripePublicKey);
      let elements;
      let paymentIntentId;

      // Add hover effect
      const stripeBtn = document.getElementById('stripe-button');
      stripeBtn.addEventListener('mouseenter', () => {
        stripeBtn.style.background = '#7c73ff';
      });
      stripeBtn.addEventListener('mouseleave', () => {
        stripeBtn.style.background = '#635bff';
      });

      stripeBtn.addEventListener('click', async () => {
        stripeBtn.disabled = true;
        stripeBtn.innerHTML = '<span style="margin-right:8px;">Processing...</span>';

        try {
          // Create Payment Intent
          const response = await fetch('/stripe/create-payment-intent', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' }
          });

          const data = await response.json();
          if (!data || !data.clientSecret) {
            throw new Error('Failed to create payment intent');
          }

          paymentIntentId = data.paymentIntentId;
          const clientSecret = data.clientSecret;

          // Initialize Stripe Elements
          const appearance = {
            theme: 'stripe',
            variables: {
              colorPrimary: '#10b981',
              colorBackground: '#ffffff',
              colorText: '#1e293b',
              colorDanger: '#ef4444',
              fontFamily: 'Inter, system-ui, sans-serif',
              spacingUnit: '4px',
              borderRadius: '12px'
            }
          };

          elements = stripe.elements({ clientSecret, appearance });
          const paymentElement = elements.create('payment');

          // Create modal for Stripe payment form
          const modal = document.createElement('div');
          modal.id = 'stripe-modal';
          modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;';
          
          const modalContent = document.createElement('div');
          modalContent.style.cssText = 'background:white;border-radius:16px;padding:32px;max-width:500px;width:90%;max-height:90vh;overflow-y:auto;';
          
          modalContent.innerHTML = `
            <div style="margin-bottom:24px;">
              <h3 style="margin:0 0 8px 0;color:#1e293b;font-size:24px;">Complete Payment</h3>
              <p style="margin:0;color:#64748b;font-size:14px;">Enter your payment details below</p>
            </div>
            <div id="payment-element" style="margin-bottom:24px;"></div>
            <div style="display:flex;gap:12px;">
              <button id="cancel-stripe" style="flex:1;padding:12px;border-radius:10px;border:1px solid #e2e8f0;background:white;color:#64748b;font-weight:600;cursor:pointer;">Cancel</button>
              <button id="submit-stripe" style="flex:1;padding:12px;border-radius:10px;border:none;background:#10b981;color:white;font-weight:600;cursor:pointer;">Pay $${data.amount.toFixed(2)}</button>
            </div>
            <div id="payment-message" style="margin-top:16px;font-size:14px;"></div>
          `;
          
          modal.appendChild(modalContent);
          document.body.appendChild(modal);

          // Mount payment element
          paymentElement.mount('#payment-element');

          // Handle cancel
          document.getElementById('cancel-stripe').addEventListener('click', () => {
            document.body.removeChild(modal);
            stripeBtn.disabled = false;
            stripeBtn.innerHTML = '<svg style="width:18px; height:18px; margin-right:8px;" viewBox="0 0 24 24" fill="white"><path d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697 0 12.165 0 9.667 0 7.589.654 6.104 1.872 4.56 3.147 3.757 4.992 3.757 7.218c0 4.039 2.467 5.76 6.476 7.219 2.585.92 3.445 1.574 3.445 2.583 0 .98-.84 1.545-2.354 1.545-1.875 0-4.965-.921-6.99-2.109l-.9 5.555C5.175 22.99 8.385 24 11.714 24c2.641 0 4.843-.624 6.328-1.813 1.664-1.305 2.525-3.236 2.525-5.732 0-4.128-2.524-5.851-6.594-7.305h.003z"/></svg>Pay with Stripe';
          });

          // Handle submit
          document.getElementById('submit-stripe').addEventListener('click', async () => {
            const submitBtn = document.getElementById('submit-stripe');
            const messageEl = document.getElementById('payment-message');
            
            submitBtn.disabled = true;
            submitBtn.textContent = 'Processing...';
            messageEl.textContent = '';

            const { error } = await stripe.confirmPayment({
              elements,
              confirmParams: {
                return_url: window.location.origin + '/payment-success'
              },
              redirect: 'if_required'
            });

            if (error) {
              messageEl.textContent = error.message;
              messageEl.style.color = '#ef4444';
              submitBtn.disabled = false;
              submitBtn.textContent = 'Pay $' + data.amount.toFixed(2);
            } else {
              // Payment succeeded, confirm on backend
              const confirmResponse = await fetch('/stripe/confirm-payment', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paymentIntentId: paymentIntentId })
              });

              const confirmData = await confirmResponse.json();
              if (confirmData && confirmData.redirect) {
                window.location = confirmData.redirect;
              } else if (confirmData && confirmData.success) {
                window.location = '/orders';
              } else {
                messageEl.textContent = 'Payment processing failed. Please contact support.';
                messageEl.style.color = '#ef4444';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Pay $' + data.amount.toFixed(2);
              }
            }
          });

        } catch (err) {
          console.error('Stripe error:', err);
          alert('Failed to initialize Stripe payment: ' + err.message);
          stripeBtn.disabled = false;
          stripeBtn.innerHTML = '<svg style="width:18px; height:18px; margin-right:8px;" viewBox="0 0 24 24" fill="white"><path d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697 0 12.165 0 9.667 0 7.589.654 6.104 1.872 4.56 3.147 3.757 4.992 3.757 7.218c0 4.039 2.467 5.76 6.476 7.219 2.585.92 3.445 1.574 3.445 2.583 0 .98-.84 1.545-2.354 1.545-1.875 0-4.965-.921-6.99-2.109l-.9 5.555C5.175 22.99 8.385 24 11.714 24c2.641 0 4.843-.624 6.328-1.813 1.664-1.305 2.525-3.236 2.525-5.732 0-4.128-2.524-5.851-6.594-7.305h.003z"/></svg>Pay with Stripe';
        }
      });
    })();
  </script>
  
  <script>
    lucide.createIcons();
  </script>
</body>
