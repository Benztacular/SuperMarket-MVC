<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://unpkg.com/event-source-polyfill"></script>
    <style>
        :root{
            --bg1: #071029;
            --bg2: #081226;
            --card-glass: rgba(255,255,255,0.035);
            --card-border: rgba(255,255,255,0.06);
            --glass-sheen: rgba(255,255,255,0.06);
            --accent: #ffd166;
            --muted: rgba(255,255,255,0.78);
            --glass-shadow: rgba(3,10,27,0.6);
        }
        html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:var(--muted);background:radial-gradient(1200px 600px at 10% 10%, rgba(10,30,60,0.24), transparent), linear-gradient(135deg,var(--bg1) 0%, var(--bg2) 100%);-webkit-font-smoothing:antialiased}
        .wrap{min-height:100%;display:flex;align-items:center;justify-content:center;padding:24px}
        .bottom-banner{display:flex;justify-content:center;align-items:center;pointer-events:none;margin-top:18px}
        .bottom-banner img{max-width:1400px;width:86%;height:auto;border-radius:8px;box-shadow:0 8px 30px rgba(2,6,23,0.45);margin:6px 0;opacity:0.98}
        .card::before{content:"";display:block;height:6px;width:128px;margin:-30px auto 14px;border-radius:6px;background:linear-gradient(90deg,var(--accent),#ffb84d);box-shadow:0 8px 28px rgba(255,209,102,0.12)}
        .card{width:840px;max-width:94vw;border-radius:22px;padding:36px;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));box-shadow:0 22px 50px var(--glass-shadow), inset 0 1px 0 rgba(255,255,255,0.02);border:1px solid var(--card-border);backdrop-filter: blur(10px);position:relative;overflow:visible}
        .card::after{content:'';position:absolute;left:12%;top:6px;width:76%;height:36%;background:linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.01));transform:skewY(-6deg);filter:blur(6px);opacity:0.45;border-radius:18px;pointer-events:none}
        .card .brand{display:flex;align-items:center;gap:12px;margin-bottom:8px}
        .brand img{height:36px;width:auto;border-radius:8px}
        .brand .title{font-weight:600;color:#fff;font-size:1.05rem}
        .subtitle{color:rgba(255,255,255,0.72);font-size:0.9rem;margin-bottom:18px}
        .qr-wrap{display:flex;align-items:center;justify-content:center;padding:22px;background:linear-gradient(180deg, rgba(255,255,255,0.015), rgba(255,255,255,0.01));border-radius:14px;border:1px solid rgba(255,255,255,0.02);backdrop-filter: blur(6px)}
        .qr-box{position:relative;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(8,14,26,0.24));padding:22px;border-radius:14px;display:flex;align-items:center;justify-content:center;box-shadow:0 14px 36px rgba(2,6,23,0.6), inset 0 6px 24px rgba(0,0,0,0.35)}
        .qr-box::before{content:'';position:absolute;left:40px;right:40px;top:40px;bottom:40px;border-radius:10px;background:linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));filter:blur(10px);z-index:0;pointer-events:none}
        .qr-box img{display:block;max-width:520px;width:100%;height:auto;border-radius:8px;background:#fff;padding:12px;position:relative;z-index:2}
        .info-row{display:flex;justify-content:space-between;align-items:center;margin-top:16px}
        .muted{color:rgba(255,255,255,0.6);font-size:0.9rem}
        .timer{font-weight:600;color:var(--accent)}
        .actions{display:flex;justify-content:space-between;align-items:center;margin-top:18px}
        .cancel{color:rgba(255,255,255,0.8);text-decoration:none;padding:8px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent}
        .hint{font-size:0.88rem;color:rgba(255,255,255,0.65)}
            @media (max-width:900px){.card{width:92vw;padding:22px}.qr-box img{max-width:48vw}}
            @media (max-width:480px){.card{padding:18px}.qr-box img{max-width:200px}}
    </style>
</head>
<body>
    <!-- top banner removed per design request -->

    <div class="wrap">
        <div class="card" role="region" aria-label="NETS QR Payment">
            <div class="brand">
                <div>
                    <div class="title">NETS QR Payment</div>
                    <div class="subtitle">Scan with your banking app to complete payment</div>
                </div>
                </div>

                <div class="bottom-banner" aria-hidden="true">
                    <img src="/images/netsQrInfo.png" alt="NETS info" />
                </div>

            <div class="qr-wrap">
                <div class="qr-box">
                    <img id="netsQrImage" src="<%= qrCodeUrl %>" alt="NETS QR Code" />
                </div>
            </div>

            

            <div class="info-row">
                <div class="hint">Reference: <span id="txnRef" style="color:rgba(255,255,255,0.85)"><%= txnRetrievalRef %></span></div>
                <div id="status" class="muted">Scan to pay</div>
            </div>

            <div class="actions">
                <div class="timer" id="timer">Time remaining: 5:00</div>
                <a class="cancel" href="/">Cancel</a>
            </div>
        </div>
    </div>

    <script>
        // Preserve existing SSE / timer logic
        let s2sNetsTxnStatus;
        if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();

        const txnRetrievalRef = "<%= txnRetrievalRef %>";
        const url = `/sse/payment-status/${txnRetrievalRef}`;
        const headers = {
            "api-key": "<%= apiKey %>",
            "project-id": "<%= projectId %>",
        };

        console.log("NETS REQUEST response:", '<%- JSON.stringify(fullNetsResponse) %>');

        s2sNetsTxnStatus = new EventSourcePolyfill(url, { headers: headers, heartbeatTimeout: 150000 });

        s2sNetsTxnStatus.addEventListener('message', (event) => {
            const data = JSON.parse(event.data);
            console.log('NETS Query Response:', data);
            if (data.success) {
                if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
                const redirect = data.redirect || `/nets-qr/success?txn_retrieval_ref=${txnRetrievalRef}`;
                window.location.href = redirect;
            } else if (data.fail) {
                if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
                const redirect = data.redirect || `/nets-qr/fail?txn_retrieval_ref=${txnRetrievalRef}`;
                window.location.href = redirect;
            }
        });

        // Timer
        const timerElement = document.getElementById('timer');
        const countdownDuration = 300; // 5 minutes
        let remainingTime = countdownDuration;

        const updateTimer = () => {
            const minutes = Math.floor(remainingTime / 60);
            const seconds = remainingTime % 60;
            if (timerElement) timerElement.textContent = `Time remaining: ${minutes}:${seconds.toString().padStart(2,'0')}`;
            remainingTime--;
            if (remainingTime < 0) {
                clearInterval(timerInterval);
                if (timerElement) timerElement.textContent = 'Transaction timed out.';
                if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
                window.location.href = `/nets-qr/fail?txn_retrieval_ref=${txnRetrievalRef}`;
            }
        };
        const timerInterval = setInterval(updateTimer, 1000);
        updateTimer();
    </script>
</body>
</html>