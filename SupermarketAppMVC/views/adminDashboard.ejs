<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
      body { background: #f8fafc; font-family: 'Plus Jakarta Sans', sans-serif; }
      .admin-layout { display:flex; gap:20px; padding:24px; max-width:1200px; margin: 0 auto; }
      .admin-main { flex:1; }
    </style>
  </head>
  <body>
    <%- include('partials/header') %>

    <div class="admin-layout">
      <%- include('partials/sidebar', { user: user }) %>

      <main class="admin-main">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h1 class="h4 fw-bold">Dashboard</h1>
        </div>

        <div class="row g-3">
          <div class="col-md-4">
            <div class="card p-3 shadow-sm">
              <div class="small text-muted">Users</div>
              <div class="h3 fw-bold"><%= stats.users || 0 %></div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card p-3 shadow-sm">
              <div class="small text-muted">Products</div>
              <div class="h3 fw-bold"><%= stats.products || 0 %></div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card p-3 shadow-sm">
              <div class="small text-muted">Orders</div>
              <div class="h3 fw-bold"><%= stats.orders || 0 %></div>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <div class="card p-3 shadow-sm">
            <h6 class="fw-bold">Welcome</h6>
            <p class="mb-0">This is the admin landing page. Use the sidebar to manage users, products, and orders.</p>
          </div>
        </div>
      </main>
    </div>

    <script>lucide.createIcons();</script>
  </body>
</html>
