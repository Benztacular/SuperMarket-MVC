<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Refund Requests</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    * {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    
    body { 
      background: #f8faf9;
      min-height: 100vh;
      padding-top: 92px; /* Match header height */
    }
    
    .main-content {
      margin-left: var(--sidebar-width, 240px);
      padding: 40px 30px;
      min-height: calc(100vh - 92px);
      transition: margin-left 0.3s ease;
    }
    body.sidebar-collapsed .main-content {
      margin-left: var(--sidebar-width-collapsed, 70px);
    }
    
    @media (max-width: 991px) {
      .main-content {
        margin-left: 0;
        padding: 20px 15px;
      }
    }
    
    .admin-container { 
      max-width: 1400px;
      margin: 0 auto;
    }
    
    .page-header {
      margin-bottom: 30px;
    }
    
    .btn-back {
      background: white;
      border: 2px solid #e5e7eb;
      color: #6b7280;
      font-weight: 600;
      padding: 12px 24px;
      border-radius: 12px;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    
    .btn-back:hover {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      border-color: #10b981;
      color: white;
      transform: translateX(-3px);
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
    }
    
    .filter-tabs {
      background: white;
      border-radius: 16px;
      padding: 20px 25px;
      margin-bottom: 30px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    
    .filter-tabs .nav-pills {
      gap: 10px;
    }
    
    .filter-tabs .nav-link {
      border-radius: 10px;
      padding: 10px 20px;
      font-weight: 600;
      color: #6b7280;
      transition: all 0.3s ease;
      border: 2px solid transparent;
    }
    
    .filter-tabs .nav-link:hover {
      background: #f0fdf4;
      color: #10b981;
    }
    
    .filter-tabs .nav-link.active {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
    }
    
    .refund-card { 
      background: white;
      border-radius: 16px;
      margin-bottom: 16px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      border: 1px solid #f0f0f0;
      transition: all 0.3s ease;
      overflow: hidden;
    }
    
    .refund-card:hover {
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
    
    .refund-card-header {
      padding: 20px 30px;
      background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.3s ease;
    }
    
    .refund-card-header:hover {
      background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    }
    
    .refund-card-header.expanded {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }
    
    .refund-card-header.expanded .refund-id,
    .refund-card-header.expanded .collapse-icon {
      color: white;
    }
    
    .refund-card-body {
      padding: 30px;
      display: none;
    }
    
    .refund-card-body.show {
      display: block;
    }
    
    .collapse-icon {
      transition: transform 0.3s ease;
      color: #6b7280;
    }
    
    .collapse-icon.rotated {
      transform: rotate(180deg);
    }
    
    .pagination-container {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      margin-top: 40px;
      padding: 20px;
      background: white;
      border-radius: 16px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    
    .page-btn {
      width: 40px;
      height: 40px;
      border: 2px solid #e5e7eb;
      background: white;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s ease;
      font-weight: 600;
      color: #6b7280;
    }
    
    .page-btn:hover {
      border-color: #10b981;
      color: #10b981;
      background: #f0fdf4;
    }
    
    .page-btn.active {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      border-color: #10b981;
    }
    
    .page-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    
    .page-info {
      font-size: 14px;
      color: #6b7280;
      font-weight: 500;
    }
    
    .refund-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 20px;
      border-bottom: 2px solid #f0f0f0;
    }
    
    .refund-id {
      font-size: 22px;
      font-weight: 700;
      color: #1a1a1a;
      margin: 0;
    }
    
    .status-badge { 
      font-size: 13px;
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    
    .status-pending { 
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      color: white;
    }
    
    .status-approved { 
      background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
      color: white;
    }
    
    .status-denied { 
      background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
      color: white;
    }
    
    .status-processing { 
      background: linear-gradient(135deg, #a78bfa 0%, #8b5cf6 100%);
      color: white;
    }
    
    .status-success { 
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
      color: white;
    }
    
    .status-failed { 
      background: linear-gradient(135deg, #fca5a5 0%, #f87171 100%);
      color: white;
    }
    
    .unified-info-card {
      background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);
      border-left: 4px solid #10b981;
      border-radius: 12px;
      padding: 30px;
      margin-bottom: 25px;
    }
    
    .info-row-unified {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin-bottom: 20px;
    }
    
    .info-row-unified:last-child {
      margin-bottom: 0;
    }
    
    .info-block {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    
    .divider-line {
      height: 2px;
      background: linear-gradient(90deg, #10b981 0%, transparent 100%);
      margin: 25px 0;
      opacity: 0.3;
    }
    
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 25px;
    }
    
    .info-item {
      background: #f9fafb;
      padding: 15px 20px;
      border-radius: 12px;
      border-left: 4px solid #10b981;
    }
    
    .info-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #6b7280;
      font-weight: 600;
      margin-bottom: 6px;
    }
    
    .info-value {
      font-size: 16px;
      font-weight: 600;
      color: #1a1a1a;
    }
    
    .amount-display {
      background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
      padding: 20px;
      border-radius: 12px;
      text-align: center;
      margin: 20px 0;
    }
    
    .amount-label {
      font-size: 14px;
      color: #92400e;
      font-weight: 600;
      margin-bottom: 8px;
    }
    
    .amount-value {
      font-size: 32px;
      font-weight: 700;
      color: #92400e;
    }
    
    .reason-section {
      background: #f0fdf4;
      padding: 20px;
      border-radius: 12px;
      margin: 20px 0;
      border-left: 4px solid #10b981;
    }
    
    .reason-title {
      font-size: 14px;
      font-weight: 700;
      color: #059669;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .reason-text {
      color: #1a1a1a;
      line-height: 1.6;
      margin: 0;
      white-space: pre-wrap;
    }
    
    .additional-notes-section {
      background: #ede9fe;
      padding: 20px;
      border-radius: 12px;
      margin: 20px 0;
      border-left: 4px solid #8b5cf6;
    }
    
    .notes-title {
      font-size: 14px;
      font-weight: 700;
      color: #6d28d9;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .timestamp-info-card {
      background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
      border-left: 4px solid #3b82f6;
      border-radius: 12px;
      padding: 20px;
      margin: 20px 0;
    }
    
    .image-section {
      margin: 20px 0;
    }
    
    .image-title {
      font-size: 14px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .evidence-image {
      width: 100%;
      max-width: 500px;
      height: auto;
      border-radius: 12px;
      border: 2px solid #e5e7eb;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .evidence-image:hover {
      border-color: #10b981;
      box-shadow: 0 4px 20px rgba(16, 185, 129, 0.2);
      transform: scale(1.02);
    }
    
    .no-image {
      background: #f9fafb;
      padding: 30px;
      border-radius: 12px;
      text-align: center;
      color: #9ca3af;
      border: 2px dashed #e5e7eb;
    }
    
    .admin-note {
      background: #dbeafe;
      padding: 20px;
      border-radius: 12px;
      margin: 20px 0;
      border-left: 4px solid #3b82f6;
    }
    
    .admin-note-title {
      font-size: 14px;
      font-weight: 700;
      color: #1e40af;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .refund-actions {
      display: flex;
      gap: 12px;
      margin-top: 25px;
    }
    
    .btn-approve {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      border: none;
      color: white;
      font-weight: 600;
      padding: 14px 28px;
      border-radius: 10px;
      transition: all 0.3s ease;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    
    .btn-approve:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.3);
    }
    
    .btn-deny {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      border: none;
      color: white;
      font-weight: 600;
      padding: 14px 28px;
      border-radius: 10px;
      transition: all 0.3s ease;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    
    .btn-deny:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(239, 68, 68, 0.3);
    }
    
    .timestamp-info {
      background: #f9fafb;
      padding: 15px;
      border-radius: 10px;
      margin-top: 20px;
    }
    
    .timestamp-info p {
      margin: 0;
      font-size: 13px;
      color: #6b7280;
    }
    
    .timestamp-info strong {
      color: #1a1a1a;
    }
    
    .modal-content {
      border-radius: 16px;
      border: none;
    }
    
    .modal-header {
      background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
      border-radius: 16px 16px 0 0;
      padding: 25px;
      border-bottom: none;
    }
    
    .modal-title {
      font-weight: 700;
      color: #1a1a1a;
    }
    
    .modal-body {
      padding: 30px;
    }
    
    .modal-footer {
      padding: 20px 30px;
      border-top: 2px solid #f0f0f0;
    }
    
    .form-control {
      border: 2px solid #e5e7eb;
      border-radius: 10px;
      padding: 12px 16px;
      transition: all 0.3s ease;
    }
    
    .form-control:focus {
      border-color: #10b981;
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
    }
    
    .alert {
      border-radius: 12px;
      border: none;
      padding: 16px 20px;
    }
    
    .alert-info {
      background: #f0fdf4;
      color: #059669;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .alert-warning {
      background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
      color: #92400e;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Utility class to hide elements when rendered server-side */
    .hidden {
      display: none;
    }
    
    @media (max-width: 768px) {
      .page-header {
        flex-direction: column;
        gap: 15px;
        align-items: flex-start;
      }
      
      .refund-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }
      
      .info-grid {
        grid-template-columns: 1fr;
      }
      
      .refund-actions {
        flex-direction: column;
      }
    }

    /* Image Modal */
    .image-modal {
      display: none;
      position: fixed;
      z-index: 9999;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.9);
      cursor: pointer;
    }

    .image-modal-content {
      margin: auto;
      display: block;
      max-width: 90%;
      max-height: 90%;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .image-modal-close {
      position: absolute;
      top: 20px;
      right: 35px;
      color: #f1f1f1;
      font-size: 40px;
      font-weight: bold;
      transition: 0.3s;
      cursor: pointer;
    }

    .image-modal-close:hover,
    .image-modal-close:focus {
      color: #bbb;
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <%- include('partials/sidebar') %>
  
  <div class="main-content">
    <div class="admin-container">
      <div class="page-header">
        <a href="/admin" class="btn-back">
          <i data-lucide="arrow-left"></i> Back
        </a>
      </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
      <ul class="nav nav-pills">
        <li class="nav-item">
          <a class="nav-link <%= !filterStatus ? 'active' : '' %>" href="/admin/refunds">
            All Requests
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= filterStatus === 'PENDING' ? 'active' : '' %>" href="/admin/refunds?status=PENDING">
            Pending
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= filterStatus === 'APPROVED' ? 'active' : '' %>" href="/admin/refunds?status=APPROVED">
            Approved
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= filterStatus === 'DENIED' ? 'active' : '' %>" href="/admin/refunds?status=DENIED">
            Denied
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= filterStatus === 'SUCCESS' ? 'active' : '' %>" href="/admin/refunds?status=SUCCESS">
            Completed
          </a>
        </li>
      </ul>
    </div>

    <% if (refunds && refunds.length === 0) { %>
      <div class="alert alert-info">
        <i data-lucide="info"></i>
        <span>No refund requests found for the selected filter.</span>
      </div>
    <% } %>

    <!-- Refund Cards -->
    <div id="refundCardsContainer">
      <% refunds.forEach((refund, index) => { %>
        <div class="refund-card <%= index < 6 ? '' : 'hidden' %>" data-index="<%= index %>">
          <div class="refund-card-header" onclick="toggleCard(this)">
            <div style="display: flex; align-items: center; gap: 15px;">
              <h5 class="refund-id" style="margin: 0;">Refund Request #<%= refund.id %></h5>
              <span class="status-badge status-<%= refund.status.toLowerCase() %>">
                <i data-lucide="<%= refund.status === 'PENDING' ? 'clock' : refund.status === 'APPROVED' ? 'check-circle' : refund.status === 'DENIED' ? 'x-circle' : refund.status === 'SUCCESS' ? 'check-circle-2' : 'alert-circle' %>"></i>
                <%= refund.status %>
              </span>
            </div>
            <i data-lucide="chevron-down" class="collapse-icon"></i>
          </div>
          <div class="refund-card-body">

        <!-- Single Consolidated Info Card -->
        <div class="unified-info-card">
          <!-- Top Row: Key Info -->
          <div class="info-row-unified">
            <div class="info-block">
              <div class="info-label">ORDER ID</div>
              <div class="info-value">#<%= refund.order_id %></div>
            </div>
            <div class="info-block">
              <div class="info-label">CUSTOMER</div>
              <div class="info-value"><%= refund.username %></div>
            </div>
          </div>
          
          <!-- Second Row: Contact Info -->
          <div class="info-row-unified">
            <div class="info-block">
              <div class="info-label">EMAIL</div>
              <div class="info-value"><%= refund.email %></div>
            </div>
            <div class="info-block">
              <div class="info-label">CONTACT</div>
              <div class="info-value"><%= refund.contact %></div>
            </div>
          </div>
          
          <div class="divider-line"></div>
          
          <!-- Third Row: Order Details -->
          <div class="info-row-unified">
            <div class="info-block">
              <div class="info-label">ORDER DATE</div>
              <div class="info-value"><%= new Date(refund.orderDate).toLocaleDateString() %></div>
            </div>
            <div class="info-block">
              <div class="info-label">ORDER TOTAL</div>
              <div class="info-value">$<%= Number(refund.orderTotal || 0).toFixed(2) %></div>
            </div>
          </div>
          
          <!-- Fourth Row: Payment & Request Info -->
          <div class="info-row-unified">
            <div class="info-block">
              <div class="info-label">PAYMENT METHOD</div>
              <div class="info-value"><%= refund.method || 'N/A' %></div>
            </div>
            <div class="info-block">
              <div class="info-label">REQUEST DATE</div>
              <div class="info-value"><%= new Date(refund.createdAt).toLocaleDateString() %></div>
            </div>
          </div>
        </div>

            <!-- Refund Amount -->
            <div class="amount-display">
              <div class="amount-label">Refund Amount Requested</div>
              <div class="amount-value">$<%= Number(refund.amount || 0).toFixed(2) %></div>
            </div>

            <!-- Customer Reason -->
            <div class="reason-section">
              <div class="reason-title">
                <i data-lucide="message-square" style="width: 16px; height: 16px; display: inline-block; vertical-align: middle;"></i>
                Customer's Reason
              </div>
              <p class="reason-text"><%= refund.reason || 'No reason provided' %></p>
            </div>

            <!-- Additional Notes (if exists) -->
            <% if (refund.additionalNotes) { %>
              <div class="additional-notes-section">
                <div class="notes-title">
                  <i data-lucide="file-text" style="width: 16px; height: 16px; display: inline-block; vertical-align: middle;"></i>
                  Additional Details
                </div>
                <p class="reason-text"><%= refund.additionalNotes %></p>
              </div>
            <% } %>

            <!-- Supporting Image -->
            <div class="image-section">
              <div class="image-title">
                <i data-lucide="image"></i>
                Supporting Evidence
              </div>
              <% if (refund.reasonImage) { %>
                <img 
                  src="/uploads/<%= refund.reasonImage %>" 
                  alt="Refund Evidence" 
                  class="evidence-image"
                  onclick="openImageModal(this.src)"
                >
              <% } else { %>
                <div class="no-image">
                  <i data-lucide="image-off" style="width: 48px; height: 48px; margin: 0 auto 10px; display: block; color: #d1d5db;"></i>
                  <p style="margin: 0;">No image provided</p>
                </div>
              <% } %>
            </div>

            <!-- Admin Note (if exists) -->
            <% if (refund.admin_note) { %>
              <div class="admin-note">
                <div class="admin-note-title">
                  <i data-lucide="shield" style="width: 16px; height: 16px; display: inline-block; vertical-align: middle;"></i>
                  Admin Note
                </div>
                <p class="reason-text"><%= refund.admin_note %></p>
              </div>
            <% } %>

            <!-- Timestamp & Gateway Info for Completed Refunds -->
            <% if (refund.status !== 'PENDING') { %>
              <div class="timestamp-info-card">
                <div class="info-row-unified">
                  <div class="info-block">
                    <div class="info-label">LAST UPDATED</div>
                    <div class="info-value"><%= refund.updatedAt ? new Date(refund.updatedAt).toLocaleString() : 'N/A' %></div>
                  </div>
                  <% if (refund.gateway_ref) { %>
                    <div class="info-block">
                      <div class="info-label">GATEWAY REFERENCE</div>
                      <div class="info-value" style="word-break: break-all; font-size: 13px;"><%= refund.gateway_ref %></div>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>

            <!-- Action Buttons for Pending Refunds -->
            <% if (refund.status === 'PENDING') { %>
              <div class="refund-actions">
                <button 
                  type="button" 
                  class="btn-approve" 
                  data-bs-toggle="modal" 
                  data-bs-target="#approveModal<%= refund.id %>"
                >
                  <i data-lucide="check-circle"></i> Approve
                </button>
                <button 
                  type="button" 
                  class="btn-deny" 
                  data-bs-toggle="modal" 
                  data-bs-target="#denyModal<%= refund.id %>"
                >
                  <i data-lucide="x-circle"></i> Deny
                </button>
              </div>
            <% } %>

        <!-- Approve Modal -->
        <div class="modal fade" id="approveModal<%= refund.id %>" tabindex="-1">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">
                  <i data-lucide="check-circle" style="width: 24px; height: 24px; display: inline-block; vertical-align: middle; color: #10b981;"></i>
                  Approve Refund Request #<%= refund.id %>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <form action="/admin/refunds/<%= refund.id %>/approve" method="POST">
                <div class="modal-body">
                  <div class="info-grid" style="margin-bottom: 20px;">
                    <div class="info-item">
                      <div class="info-label">Order ID</div>
                      <div class="info-value">#<%= refund.order_id %></div>
                    </div>
                    <div class="info-item">
                      <div class="info-label">Customer</div>
                      <div class="info-value"><%= refund.username %></div>
                    </div>
                  </div>
                  
                  <div class="alert alert-warning">
                    <i data-lucide="alert-triangle"></i>
                    <div>
                      <strong>Confirmation Required</strong>
                      <p style="margin: 8px 0 0 0;">This will credit <strong>$<%= Number(refund.amount || 0).toFixed(2) %></strong> to the customer's wallet.</p>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="admin_note_approve<%= refund.id %>" class="form-label" style="font-weight: 600;">
                      Admin Note (Optional)
                    </label>
                    <textarea 
                      class="form-control" 
                      id="admin_note_approve<%= refund.id %>" 
                      name="admin_note" 
                      rows="3"
                      placeholder="Add any notes about this approval decision..."
                    ></textarea>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn-approve" style="width: auto;">
                    <i data-lucide="check"></i>
                    Confirm Approval
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- Deny Modal -->
        <div class="modal fade" id="denyModal<%= refund.id %>" tabindex="-1">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header" style="background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);">
                <h5 class="modal-title">
                  <i data-lucide="x-circle" style="width: 24px; height: 24px; display: inline-block; vertical-align: middle; color: #dc2626;"></i>
                  Deny Refund Request #<%= refund.id %>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <form action="/admin/refunds/<%= refund.id %>/deny" method="POST">
                <div class="modal-body">
                  <div class="info-grid" style="margin-bottom: 20px;">
                    <div class="info-item">
                      <div class="info-label">Order ID</div>
                      <div class="info-value">#<%= refund.order_id %></div>
                    </div>
                    <div class="info-item">
                      <div class="info-label">Customer</div>
                      <div class="info-value"><%= refund.username %></div>
                    </div>
                  </div>
                  
                  <div class="mb-3">
                    <label for="admin_note_deny<%= refund.id %>" class="form-label" style="font-weight: 600;">
                      Reason for Denial <span style="color: #ef4444;">*</span>
                    </label>
                    <textarea 
                      class="form-control" 
                      id="admin_note_deny<%= refund.id %>" 
                      name="admin_note" 
                      rows="4"
                      required
                      placeholder="Explain clearly why this refund request is being denied. This will be visible to the customer."
                    ></textarea>
                    <small style="color: #6b7280; font-size: 13px; margin-top: 8px; display: block;">
                      Be professional and specific. The customer will see this explanation.
                    </small>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn-deny" style="width: auto;">
                    <i data-lucide="x"></i>
                    Confirm Denial
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (refunds && refunds.length > 6) { %>
      <div class="pagination-container">
        <button class="page-btn" id="prevBtn" onclick="changePage(-1)">
          <i data-lucide="chevron-left"></i>
        </button>
        <div id="pageNumbers"></div>
        <button class="page-btn" id="nextBtn" onclick="changePage(1)">
          <i data-lucide="chevron-right"></i>
        </button>
      </div>
    <% } %>
    </div>
  </div>

  <!-- Image Modal -->
  <div id="imageModal" class="image-modal" onclick="closeImageModal()">
    <span class="image-modal-close">&times;</span>
    <img class="image-modal-content" id="modalImage">
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    lucide.createIcons();

    // Collapsible card toggle
    function toggleCard(header) {
      const card = header.closest('.refund-card');
      const body = card.querySelector('.refund-card-body');
      const icon = header.querySelector('.collapse-icon');
      
      body.classList.toggle('show');
      header.classList.toggle('expanded');
      icon.classList.toggle('rotated');
      
      lucide.createIcons();
    }

    // Pagination
    const itemsPerPage = 6;
    let currentPage = 1;
    const cards = document.querySelectorAll('.refund-card');
    const totalPages = Math.ceil(cards.length / itemsPerPage);

    function showPage(page) {
      currentPage = page;
      
      cards.forEach((card, index) => {
        const startIndex = (page - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        
        if (index >= startIndex && index < endIndex) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
      
      updatePagination();
    }

    function changePage(direction) {
      const newPage = currentPage + direction;
      if (newPage >= 1 && newPage <= totalPages) {
        showPage(newPage);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function updatePagination() {
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const pageNumbers = document.getElementById('pageNumbers');
      
      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages;
      
      if (pageNumbers) {
        pageNumbers.innerHTML = '';
        
        for (let i = 1; i <= totalPages; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.className = 'page-btn' + (i === currentPage ? ' active' : '');
          pageBtn.textContent = i;
          pageBtn.onclick = () => showPage(i);
          pageNumbers.appendChild(pageBtn);
        }
      }
      
      lucide.createIcons();
    }

    // Initialize pagination on load
    if (totalPages > 1) {
      updatePagination();
    }

    // Image modal functions
    function openImageModal(src) {
      const modal = document.getElementById('imageModal');
      const modalImg = document.getElementById('modalImage');
      modal.style.display = 'block';
      modalImg.src = src;
    }

        function closeImageModal() {
          const modal = document.getElementById('imageModal');
          const modalImg = document.getElementById('modalImage');
          if (modal) modal.style.display = 'none';
          if (modalImg) modalImg.src = '';
        }
    
        // Close modal when clicking the close icon (×)
        document.querySelectorAll('.image-modal-close').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            closeImageModal();
          });
        });
    
        // Close modal on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeImageModal();
        });
      </script>
    </body>
    </html>