<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Refund Requests</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body { background-color: #f8f9fa; }
    .admin-container { margin: 20px auto; max-width: 1400px; }
    .refund-card { background: white; border-radius: 10px; padding: 20px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .status-badge { font-size: 14px; padding: 6px 14px; border-radius: 20px; font-weight: 500; }
    .status-pending { background: #fff3cd; color: #856404; }
    .status-approved { background: #d1ecf1; color: #0c5460; }
    .status-denied { background: #f8d7da; color: #721c24; }
    .status-processing { background: #cfe2ff; color: #084298; }
    .status-success { background: #d4edda; color: #155724; }
    .status-failed { background: #f8d7da; color: #721c24; }
    .filter-tabs { margin-bottom: 30px; }
    .refund-actions { display: flex; gap: 10px; }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  
  <div class="container admin-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2><i data-lucide="dollar-sign"></i> Refund Requests</h2>
      <a href="/admin/dashboard" class="btn btn-outline-secondary">
        <i data-lucide="layout-dashboard"></i> Dashboard
      </a>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
      <ul class="nav nav-pills">
        <li class="nav-item">
          <a class="nav-link <%= !filterStatus ? 'active' : '' %>" href="/admin/refunds">All</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= filterStatus === 'PENDING' ? 'active' : '' %>" href="/admin/refunds?status=PENDING">Pending</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= filterStatus === 'APPROVED' ? 'active' : '' %>" href="/admin/refunds?status=APPROVED">Approved</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= filterStatus === 'DENIED' ? 'active' : '' %>" href="/admin/refunds?status=DENIED">Denied</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= filterStatus === 'SUCCESS' ? 'active' : '' %>" href="/admin/refunds?status=SUCCESS">Success</a>
        </li>
      </ul>
    </div>

    <% if (refunds && refunds.length === 0) { %>
      <div class="alert alert-info">
        <i data-lucide="info"></i> No refund requests found.
      </div>
    <% } %>

    <!-- Refund Cards -->
    <% refunds.forEach(refund => { %>
      <div class="refund-card">
        <div class="row">
          <div class="col-md-8">
            <div class="d-flex align-items-center mb-2">
              <h5 class="mb-0 me-3">Refund #<%= refund.id %></h5>
              <span class="status-badge status-<%= refund.status.toLowerCase() %>">
                <%= refund.status %>
              </span>
            </div>
            
            <div class="row mt-3">
              <div class="col-md-6">
                <p class="mb-1"><strong>Order ID:</strong> #<%= refund.order_id %></p>
                <p class="mb-1"><strong>Customer:</strong> <%= refund.username %> (<%= refund.email %>)</p>
                <p class="mb-1"><strong>Contact:</strong> <%= refund.contact %></p>
              </div>
              <div class="col-md-6">
                <p class="mb-1"><strong>Order Date:</strong> <%= new Date(refund.orderDate).toLocaleDateString() %></p>
                <p class="mb-1"><strong>Order Total:</strong> $<%= Number(refund.orderTotal || 0).toFixed(2) %></p>
                <p class="mb-1"><strong>Payment Method:</strong> <%= refund.method %></p>
              </div>
            </div>

            <div class="mt-3">
              <p class="mb-1"><strong>Refund Amount:</strong> <span class="text-danger fs-5">$<%= Number(refund.amount || 0).toFixed(2) %></span></p>
              <p class="mb-1"><strong>Request Date:</strong> <%= new Date(refund.createdAt).toLocaleString() %></p>
            </div>

            <div class="mt-3">
              <p class="mb-1"><strong>Customer Reason:</strong></p>
              <div class="alert alert-light mb-2">
                <%= refund.reason %>
              </div>
            </div>

            <% if (refund.admin_note) { %>
              <div class="mt-2">
                <p class="mb-1"><strong>Admin Note:</strong></p>
                <div class="alert alert-info mb-0">
                  <%= refund.admin_note %>
                </div>
              </div>
            <% } %>
          </div>

          <div class="col-md-4">
            <% if (refund.status === 'PENDING') { %>
              <div class="refund-actions">
                <button 
                  type="button" 
                  class="btn btn-success flex-fill" 
                  data-bs-toggle="modal" 
                  data-bs-target="#approveModal<%= refund.id %>"
                >
                  <i data-lucide="check-circle"></i> Approve
                </button>
                <button 
                  type="button" 
                  class="btn btn-danger flex-fill" 
                  data-bs-toggle="modal" 
                  data-bs-target="#denyModal<%= refund.id %>"
                >
                  <i data-lucide="x-circle"></i> Deny
                </button>
              </div>

              <!-- Approve Modal -->
              <div class="modal fade" id="approveModal<%= refund.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Approve Refund #<%= refund.id %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/admin/refunds/<%= refund.id %>/approve" method="POST">
                      <div class="modal-body">
                        <p><strong>Order ID:</strong> #<%= refund.order_id %></p>
                        <p><strong>Customer:</strong> <%= refund.username %></p>
                        <p><strong>Amount:</strong> $<%= Number(refund.amount || 0).toFixed(2) %></p>
                        
                        <div class="alert alert-warning">
                          <i data-lucide="alert-triangle"></i>
                          <strong>This will credit $<%= Number(refund.amount || 0).toFixed(2) %> to the customer's wallet.</strong>
                        </div>

                        <div class="mb-3">
                          <label for="admin_note_approve<%= refund.id %>" class="form-label">Admin Note (Optional)</label>
                          <textarea 
                            class="form-control" 
                            id="admin_note_approve<%= refund.id %>" 
                            name="admin_note" 
                            rows="3"
                            placeholder="Add a note about this approval..."
                          ></textarea>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Confirm Approval</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>

              <!-- Deny Modal -->
              <div class="modal fade" id="denyModal<%= refund.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Deny Refund #<%= refund.id %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/admin/refunds/<%= refund.id %>/deny" method="POST">
                      <div class="modal-body">
                        <p><strong>Order ID:</strong> #<%= refund.order_id %></p>
                        <p><strong>Customer:</strong> <%= refund.username %></p>
                        <p><strong>Amount:</strong> $<%= Number(refund.amount || 0).toFixed(2) %></p>
                        
                        <div class="mb-3">
                          <label for="admin_note_deny<%= refund.id %>" class="form-label">Reason for Denial (Required)</label>
                          <textarea 
                            class="form-control" 
                            id="admin_note_deny<%= refund.id %>" 
                            name="admin_note" 
                            rows="3"
                            required
                            placeholder="Explain why this refund is being denied..."
                          ></textarea>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Confirm Denial</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            <% } else { %>
              <div class="text-muted">
                <p><small>Last Updated:</small></p>
                <p><%= refund.updatedAt ? new Date(refund.updatedAt).toLocaleString() : 'N/A' %></p>
                <% if (refund.gateway_ref) { %>
                  <p><small>Gateway Ref:</small></p>
                  <p class="text-truncate" title="<%= refund.gateway_ref %>"><%= refund.gateway_ref %></p>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
