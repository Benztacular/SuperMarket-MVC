<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Shopping Cart - FreshMart</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">

  <!-- Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* --- MODERN FRESH THEME VARIABLES --- */
    :root {
      /* Brand Colors */
      --brand-primary: #10b981; /* Fresh Mint Green */
      --brand-primary-dark: #059669;
      --brand-primary-light: #d1fae5;
      --brand-dark: #0f172a;    /* Deep Slate */
      
      /* UI Colors */
      --bg-body: #f1f5f9;       /* Light Gray Blue */
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      
      /* Spacing & Shapes */
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 24px;
      
      /* Effects */
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
      --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.01);
      --shadow-button: 0 10px 15px -3px rgba(16, 185, 129, 0.3);
      --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body { 
      background-color: var(--bg-body); 
      font-family: 'Inter', sans-serif; 
      color: var(--text-main); 
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--brand-dark);
      font-weight: 700;
      letter-spacing: -0.025em;
    }

    a { text-decoration: none; color: inherit; transition: var(--transition); }

    /* --- LAYOUT UTILS --- */
    .cart-page {
      min-height: 80vh;
      padding-top: 1.25rem;
      padding-bottom: 4rem;
      max-width: 1200px;
    }

    /* --- STEPPER (MATCHING CONFIRM PAYMENT) --- */
    .checkout-stepper {
      display: flex;
      justify-content: center;
      margin-bottom: 2rem;
      position: relative;
    }
    .step-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-muted);
      font-weight: 500;
      font-size: 0.9rem;
      position: relative;
      z-index: 2;
    }
    .step-item.active {
      color: var(--brand-dark);
      font-weight: 700;
    }
    .step-item.completed {
      color: var(--brand-primary);
    }
    .step-circle {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #e2e8f0;
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      transition: all 0.3s;
    }
    .step-item.active .step-circle {
      background: var(--brand-dark);
      color: white;
      box-shadow: 0 0 0 4px rgba(30, 41, 59, 0.1);
    }
    .step-item.completed .step-circle {
      background: var(--brand-primary);
      color: white;
    }
    .step-divider {
      width: 60px;
      height: 2px;
      background: #e2e8f0;
      margin: 0 1rem;
      align-self: center;
    }
    .step-item.completed + .step-divider {
      background: var(--brand-primary);
    }

    /* --- CART ITEMS LIST --- */
    .list-group { gap: 1rem; border-radius: var(--radius-lg); }

    .cart-item-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg) !important;
      padding: 1.5rem !important;
      transition: var(--transition);
      margin-bottom: 0;
      box-shadow: var(--shadow-sm);
    }
    .cart-item-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md) !important;
      border-color: #cbd5e1;
      z-index: 1;
    }

    .cart-item-img {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: var(--radius-md);
      background-color: #f1f5f9;
      border: 1px solid #f1f5f9;
    }

    .product-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 600;
      color: var(--brand-dark);
      font-size: 1.05rem;
      margin-bottom: 0.25rem;
      display: block;
    }
    .product-title:hover { color: var(--brand-primary); }

    .muted-note {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .price-tag {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      color: var(--brand-dark);
      font-size: 1.1rem;
    }

    /* --- QUANTITY CONTROLS --- */
    .qty-group {
      background: #fff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 4px;
      display: flex;
      align-items: center;
      width: 120px;
    }
    .qty-btn {
      width: 28px;
      height: 28px;
      border: none;
      background: #f1f5f9;
      border-radius: var(--radius-sm);
      color: var(--brand-dark);
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }
    .qty-btn:hover { background: var(--brand-dark); color: white; }
    
    .qty-input {
      border: none;
      width: 100%;
      text-align: center;
      font-weight: 600;
      color: var(--brand-dark);
      background: transparent;
      padding: 0;
    }
    .qty-input:focus { outline: none; }
    /* Hide spinners */
    .qty-input::-webkit-inner-spin-button, .qty-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

    /* --- SUMMARY CARD --- */
    .summary-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      padding: 1.75rem !important;
      position: sticky;
      top: 110px;
    }

    .summary-card h5 { 
      font-size: 1.1rem; 
      margin-bottom: 1.5rem; 
      padding-bottom: 1rem; 
      border-bottom: 1px dashed var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 1rem;
      font-size: 0.95rem;
      color: var(--text-muted);
    }

    .summary-row.total {
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-color);
      color: var(--brand-dark);
      font-weight: 700;
      font-size: 1.25rem;
      align-items: center;
    }

    /* --- BUTTONS --- */
    .btn-checkout {
      background: var(--brand-dark);
      border: none;
      color: #fff;
      padding: 16px;
      border-radius: var(--radius-md);
      font-weight: 600;
      width: 100%;
      font-size: 1rem;
      transition: var(--transition);
      box-shadow: var(--shadow-button);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    .btn-checkout:hover:not(:disabled) {
      background: #000;
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(0,0,0,0.15);
      color: white;
    }
    .btn-checkout:disabled { background: #cbd5e1; cursor: not-allowed; box-shadow: none; }

    .btn-continue {
      color: var(--text-muted);
      font-weight: 500;
      font-size: 0.9rem;
      transition: var(--transition);
    }
    .btn-continue:hover { color: var(--brand-primary); }

    .btn-remove {
      color: #ef4444; 
      font-size: 0.85rem; 
      font-weight: 500;
      opacity: 0.8;
      transition: var(--transition);
      background: none;
      border: none;
      padding: 0;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .btn-remove:hover { opacity: 1; text-decoration: underline; }

    /* Trust Badges */
    .trust-badges {
      display: flex;
      justify-content: space-between;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid #f1f5f9;
      gap: 10px;
    }
    .trust-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.75rem;
      flex: 1;
    }

    @media (max-width: 991px) { 
      .summary-card { position: static; margin-top: 2rem; }
      .step-divider { width: 30px; margin: 0 0.5rem; }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="container cart-page">
    
    <!-- Progress Stepper -->
    <div class="checkout-stepper">
      <div class="step-item active">
        <div class="step-circle">1</div>
        <span>Shopping Cart</span>
      </div>
      <div class="step-divider"></div>
      <div class="step-item">
        <div class="step-circle">2</div>
        <span>Checkout</span>
      </div>
      <div class="step-divider"></div>
      <div class="step-item">
        <div class="step-circle">3</div>
        <span>Payment</span>
      </div>
    </div>

    <div class="row g-4 g-lg-5"> 
      
      <!-- LEFT COLUMN: CART ITEMS -->
      <div class="col-lg-8">
        <div class="d-flex align-items-end justify-content-between mb-4">
          <h2 class="mb-0">My Cart</h2>
          <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3"><%= (cartItems || items || []).length %> items</span>
        </div>

        <%
          const rows = (cartItems || items || []);
          function price(n){ const v = Number(n||0); return isFinite(v) ? v.toFixed(2) : '0.00'; }
          const sum = rows.reduce((s, it)=> s + Number(it.price||0)*Number(it.quantity||0), 0);
        %>

        <div class="list-group border-0">
          <% if (!rows.length) { %>
            <div class="list-group-item text-center text-muted py-5 border rounded-4 bg-white shadow-sm">
              <i data-lucide="shopping-bag" style="width: 48px; height: 48px; opacity: 0.2; margin-bottom: 1rem;"></i>
              <p class="mb-0">Your cart is currently empty.</p>
              <a href="/shopping" class="btn btn-primary mt-3">Start Shopping</a>
            </div>
          <% } else { rows.forEach(it => { %>
            <!-- Modern Card Item -->
            <div class="cart-item-card d-flex flex-column flex-sm-row align-items-sm-center gap-4">
              
              <!-- Image -->
              <% if (it.image) { %>
                <img src="/images/<%= it.image %>" alt="<%= it.productName %>" class="cart-item-img shadow-sm">
              <% } else { %>
                <div class="cart-item-img d-flex align-items-center justify-content-center text-muted small">No Img</div>
              <% } %>

              <!-- Content Area -->
              <div class="flex-grow-1 w-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div>
                    <a href="/product/<%= it.id %>" class="product-title"><%= it.productName %></a>
                    <div class="muted-note">SKU: <%= it.id %></div>
                  </div>
                  <div class="text-end">
                    <div class="price-tag">$<%= price(it.price) %></div>
                  </div>
                </div>

                <!-- Controls Row -->
                <div class="d-flex justify-content-between align-items-end mt-3">
                  
                  <!-- Quantity Control -->
                  <form class="d-flex align-items-center gap-3" action="/cart/update/<%= it.id %>" method="POST">
                    <div class="qty-group">
                      <button type="button" class="qty-btn qty-decrement">−</button>
                      <input class="qty-input" type="number" name="quantity" min="0" value="<%= it.quantity %>">
                      <button type="button" class="qty-btn qty-increment">+</button>
                    </div>
                    <button class="btn btn-sm text-primary fw-semibold p-0" type="submit" style="font-size: 0.8rem; background:none; border:none;">Update</button>
                  </form>

                  <!-- Remove Action -->
                  <form action="/cart/remove/<%= it.id %>" method="POST" style="display:inline">
                    <button class="btn-remove" type="submit">
                      <i data-lucide="trash-2" style="width: 14px;"></i> Remove
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% }) } %>
        </div>

        <!-- Continue Shopping & Clear Cart Links -->
        <div class="mt-4 pt-2 d-flex justify-content-between align-items-center">
          <a href="/shopping" class="btn-continue d-flex align-items-center gap-2">
            <i data-lucide="arrow-left" style="width: 16px;"></i> Continue Shopping
          </a>

          <% if (rows.length > 0) { %>
            <form action="/cart/clear" method="POST" class="d-inline">
              <button type="submit" class="btn btn-link text-danger text-decoration-none d-flex align-items-center gap-2 fw-medium p-0" style="font-size: 0.9rem;" onclick="return confirm('Are you sure you want to clear your entire cart?')">
                Clear Cart
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <!-- RIGHT COLUMN: SUMMARY -->
      <div class="col-lg-4">
        <div class="summary-card">
          <h5>Order Summary <i data-lucide="receipt" style="width: 18px; color: #94a3b8;"></i></h5>
          
          <!-- Product breakdown removed to keep summary concise (subtotal shown below) -->

          <div class="summary-row">
            <span>Subtotal</span>
            <span>$<%= price(sum) %></span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span class="text-success fw-bold">$0.00</span>
          </div>

          <div class="summary-row total">
            <span>Total</span>
            <span>$<%= price(sum) %></span>
          </div>

          <form action="/cart/checkout" method="GET" class="mt-4">
            <button class="btn-checkout" <%= rows.length ? '' : 'disabled' %>>
              Checkout <i data-lucide="arrow-right" style="width: 18px;"></i>
            </button>
          </form>

          <!-- Trust Badges -->
          <div class="trust-badges">
            <div class="trust-item">
              <i data-lucide="shield-check" class="text-success" style="width:20px;"></i>
              <span>Secure Payment</span>
            </div>
            <div class="trust-item">
              <i data-lucide="truck" class="text-primary" style="width:20px;"></i>
              <span>Fast Delivery</span>
            </div>
            <div class="trust-item">
              <i data-lucide="refresh-cw" class="text-warning" style="width:20px;"></i>
              <span>Easy Returns</span>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Qty +/- behaviour (delegated)
    document.addEventListener('click', function (e) {
      const dec = e.target.closest('.qty-decrement');
      const inc = e.target.closest('.qty-increment');
      if (!dec && !inc) return;
      e.preventDefault();
      const group = (dec || inc).closest('.qty-group'); // Updated selector
      if (!group) return;
      const input = group.querySelector('.qty-input');
      if (!input) return;
      let v = parseInt(input.value, 10) || 0;
      if (dec) v = Math.max(0, v - 1);
      if (inc) v = v + 1;
      input.value = v;
    });
  </script>
</body>
</html>