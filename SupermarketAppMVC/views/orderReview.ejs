<%
  // Logic preserved: Ensure itemsList exists
  const itemsList = (typeof items !== 'undefined' && items) ? items : [];
%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Review Order #<%= orderId %></title>
  
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Fonts: Plus Jakarta Sans for a modern look -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      /* Modern Color Palette */
      --primary-color: #4f46e5;       /* Indigo-600 */
      --primary-hover: #4338ca;       /* Indigo-700 */
      --bg-color: #f8fafc;            /* Slate-50 */
      --card-bg: #ffffff;
      --text-main: #0f172a;           /* Slate-900 */
      --text-muted: #64748b;          /* Slate-500 */
      --border-color: #e2e8f0;        /* Slate-200 */
      --star-inactive: #cbd5e1;       /* Slate-300 */
      --star-active: #fbbf24;         /* Amber-400 */
      --focus-ring: rgba(79, 70, 229, 0.25);
    }

    /* Animation Keyframes */
    @keyframes fadeInUp {
      from { 
        opacity: 0; 
        transform: translateY(30px); 
      }
      to { 
        opacity: 1; 
        transform: translateY(0); 
      }
    }

    @keyframes ripple {
      0% { transform: translate(-50%, -50%) scale(0); opacity: 0.5; }
      100% { transform: translate(-50%, -50%) scale(20); opacity: 0; }
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      -webkit-font-smoothing: antialiased;
    }

    /* Page Header */
    .page-header h3 {
      font-weight: 700;
      letter-spacing: -0.5px;
      color: var(--text-main);
    }
    
    .btn-back {
      color: var(--text-muted);
      border: 1px solid var(--border-color);
      background: white;
      transition: all 0.2s ease;
      font-weight: 600;
    }
    .btn-back:hover {
      background: #f1f5f9;
      color: var(--text-main);
      border-color: #cbd5e1;
    }

    /* Card Modernization */
    .review-card {
      background: var(--card-bg);
      border: 1px solid rgba(226, 232, 240, 0.8);
      border-radius: 20px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      margin-bottom: 24px;
      overflow: hidden;
      
      /* Animation Init */
      animation: fadeInUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }

    .review-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
      border-color: rgba(79, 70, 229, 0.1);
    }
    
    .review-card .card-body {
      padding: 0;
    }

    /* Accordion Trigger Styles */
    .card-trigger {
      padding: 1.5rem;
      cursor: pointer;
      background: transparent;
      transition: background-color 0.2s ease;
      user-select: none;
    }

    .card-trigger:hover {
      background-color: #f8fafc;
    }

    /* Chevron Animation */
    .chevron-icon {
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      color: var(--text-muted);
    }

    .card-trigger[aria-expanded="true"] .chevron-icon {
      transform: rotate(180deg);
      color: var(--primary-color);
    }
    
    /* Collapsible Content Area */
    .collapse-content {
      background-color: #fafbfc;
      border-top: 1px solid var(--border-color);
      padding: 1.5rem;
    }

    /* Product Thumbnail */
    .product-thumb-container {
      width: 80px;
      height: 80px;
      flex-shrink: 0;
      background: #f8fafc;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border-color);
      position: relative;
    }

    .product-thumb {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    
    .card-trigger:hover .product-thumb {
      transform: scale(1.05);
    }

    /* Product Details */
    .product-title {
      font-weight: 700;
      color: var(--text-main);
      font-size: 1.1rem;
      letter-spacing: -0.01em;
      margin-bottom: 4px;
    }

    .tap-hint {
      font-size: 0.85rem;
      color: var(--primary-color);
      font-weight: 600;
      opacity: 0;
      transform: translateX(-10px);
      transition: all 0.3s ease;
    }

    .card-trigger:hover .tap-hint {
      opacity: 1;
      transform: translateX(0);
    }

    /* Form Styles */
    .form-label-custom {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 8px;
      display: block;
    }

    /* Interactive Star Rating */
    .star-rating {
      display: inline-flex;
      flex-direction: row-reverse;
      gap: 6px;
    }
    
    .star-rating input { display: none; }
    
    .star-rating label {
      cursor: pointer;
      width: 32px;
      height: 32px;
      color: var(--star-inactive);
      font-size: 26px;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .star-rating input:checked ~ label,
    .star-rating label:hover,
    .star-rating label:hover ~ label {
      color: var(--star-active);
    }
    
    .star-rating label:hover {
      transform: scale(1.2);
    }

    /* Textarea */
    .review-textarea {
      background-color: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 16px;
      font-size: 0.95rem;
      transition: all 0.2s ease;
      color: var(--text-main);
    }

    .review-textarea:focus {
      background-color: #fff;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 4px var(--focus-ring);
      outline: none;
    }

    /* Submit Button */
    .btn-save {
      background-color: var(--primary-color);
      border: none;
      padding: 10px 28px;
      font-weight: 600;
      border-radius: 10px;
      letter-spacing: 0.01em;
      box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2);
      transition: all 0.2s ease;
      position: relative;
      overflow: hidden;
    }

    .btn-save:hover {
      background-color: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
    }

    .btn-save:active {
      transform: translateY(0);
    }

    .btn-save::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 20px;
      height: 20px;
      background: rgba(255, 255, 255, 0.4);
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(0);
      opacity: 0;
      pointer-events: none;
    }

    .btn-save:active::after {
      animation: ripple 0.6s ease-out;
    }

    @media (max-width: 576px) {
      .product-thumb-container { width: 60px; height: 60px; }
      .card-trigger { padding: 1rem; }
      .tap-hint { opacity: 1; transform: none; font-size: 0.75rem; }
    }
    /* Ensure Bootstrap collapse "show" is visible and measurable even when server rendered */
    .collapse.show { display: block !important; height: auto !important; visibility: visible !important; }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="container py-5">
    
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 mx-auto page-header" style="max-width: 800px;">
      <div class="text-center text-md-start">
        <h3 class="mb-1">Write Reviews</h3>
        <p class="text-muted mb-0 fw-medium">Order <span class="text-dark">#<%= orderId %></span></p>
      </div>
      <div class="mt-3 mt-md-0">
        <a href="/orderHistory" class="btn btn-back btn-sm px-3 py-2 rounded-3 text-decoration-none">
          <i class="fas fa-arrow-left me-2"></i>Back to Orders
        </a>
      </div>
    </div>

    <div class="mx-auto" style="max-width: 800px;">
      
      <% if (!itemsList.length) { %>
        <div class="text-center text-muted py-5 card shadow-sm border-0 rounded-4">
          <div class="card-body">
            <i class="fas fa-box-open fa-3x mb-3 text-light-emphasis"></i>
            <p class="mb-0">No items found for this order.</p>
          </div>
        </div>
      <% } %>

      <% itemsList.forEach(function(it, index) { %>
        <% 
           // Pre-calculate rating. Use parseInt to be safe with string types.
           const curRating = it.rating ? parseInt(it.rating) : 0;
           const hasReview = curRating > 0 || (it.text && it.text.trim().length > 0);
        %>
        <!-- Card Start -->
        <div class="review-card" data-delay="<%= index * 150 %>ms">
          <div class="card-body">
            
            <!-- Clickable Header / Accordion Trigger -->
            <div class="card-trigger d-flex align-items-center justify-content-between" 
                 aria-expanded="false">
              
              <div class="d-flex align-items-center gap-3 gap-md-4" style="flex: 1; min-width: 0;">
                <!-- Image -->
                <div class="product-thumb-container shadow-sm">
                   <img src="<%= it.image ? ('/images/' + it.image) : '/images/placeholder.png' %>" 
                        class="product-thumb" 
                        alt="<%= it.productName %>"
                        onerror="this.onerror=null;this.src='/images/placeholder.png'">
                </div>
                
                <!-- Product Info Summary -->
                <div style="flex: 1; min-width: 0;">
                  <h5 class="product-title mb-1 text-truncate"><%= it.productName %></h5>
                  
                  <div class="text-muted small mb-1">
                    <span class="fw-semibold text-dark">$<%= (Number(it.price||0)).toFixed(2) %></span>
                    <span class="mx-2 opacity-50">•</span>
                    Qty: <%= it.quantity || it.qty || 1 %>
                  </div>

                  <!-- Existing Rating Display (If reviewed) -->
                  <% if (curRating > 0) { %>
                    <div class="d-flex align-items-center text-warning small mt-1">
                      <% for (let r=1; r<=5; r++) { %>
                        <i class="<%= r <= curRating ? 'fas' : 'far' %> fa-star"></i>
                      <% } %>
                      <span class="text-muted ms-2 small fw-medium" style="font-size: 0.8em;">Your Rating</span>
                    </div>
                  <% } %>

                  <!-- Existing Review Text Preview (Truncated) -->
                  <% if (it.text && it.text.trim().length > 0) { %>
                    <div class="d-none d-sm-block mt-1 text-muted small text-truncate fst-italic">
                      "<%= it.text %>"
                    </div>
                  <% } %>
                  
                  <!-- Hint text -->
                  <div class="tap-hint d-flex align-items-center mt-2">
                    <i class="far fa-edit me-2"></i> <%= hasReview ? 'Edit Review' : 'Write a review' %>
                  </div>
                </div>
              </div>

              <!-- Chevron Indicator -->
              <div class="ps-3">
                <i class="fas fa-chevron-down chevron-icon fa-lg"></i>
              </div>
            </div>

            <!-- Collapsible Form Section -->
            <div class="collapse" id="collapse-<%= index %>">
              <div class="collapse-content">
                
                <!-- FORM -->
                <form action="/orders/<%= orderId %>/review/<%= it.product_id %>" method="post">
                  
                  <div class="row">
                    <!-- Star Rating Section -->
                    <div class="col-md-12 mb-4">
                      <div class="p-3 bg-white rounded-3 border border-light-subtle d-flex align-items-center justify-content-between">
                        <span class="fw-bold text-dark small text-uppercase"><%= hasReview ? 'Update Rating' : 'Rate Product' %></span>
                        <div class="star-rating">
                          <% for (let r=5; r>=1; r--) { %>
                            <input type="radio" 
                                   id="star<%= r %>-<%= it.product_id %>" 
                                   name="rating" 
                                   value="<%= r %>" 
                                   <%= (r == curRating ? 'checked' : '') %> />
                            <label for="star<%= r %>-<%= it.product_id %>" title="<%= r %> stars">
                              <i class="fas fa-star"></i>
                            </label>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <!-- Review Text Section -->
                    <div class="col-md-12 mb-3">
                      <label class="form-label-custom">
                        <%= hasReview ? 'Your Previous Review' : 'Review Comments' %>
                      </label>
                      <textarea name="review" 
                                class="form-control review-textarea" 
                                rows="4" 
                                placeholder="Share your thoughts on this product... What did you like or dislike?"><%= (it.text || '').trim() %></textarea>
                    </div>
                  </div>

                  <div class="d-flex justify-content-end pt-2">
                    <button type="button" class="btn btn-link text-muted text-decoration-none me-2 btn-cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-save text-white">
                      <%= hasReview ? 'Update Review' : 'Save Review' %>
                    </button>
                  </div>
                </form>
                <!-- End FORM -->

              </div>
            </div>
            <!-- End Collapse -->

          </div>
        </div>
        <!-- Card End -->
      <% }); %>

    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    // Handle Card Trigger Clicks
    const triggers = document.querySelectorAll('.card-trigger');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        toggleAccordion(this);
      });
    });

    // Apply animation delays from data-delay attributes to avoid CSS parser issues with EJS tags
    const reviewCards = document.querySelectorAll('.review-card');
    reviewCards.forEach(card => {
      const delay = card.dataset.delay;
      if (delay) card.style.animationDelay = delay;
    });

    // Handle Cancel Button Clicks
    const cancelBtns = document.querySelectorAll('.btn-cancel');
    cancelBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const collapseEl = this.closest('.collapse');
        const trigger = collapseEl.previousElementSibling;
        toggleAccordion(trigger);
      });
    });

      function toggleAccordion(trigger) {
        const collapseElement = trigger.nextElementSibling;
        if (collapseElement && collapseElement.classList.contains('collapse')) {
          const bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseElement);
          bsCollapse.toggle();
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
          trigger.setAttribute('aria-expanded', !isExpanded);
        }
      }

      // Initialize any collapse elements that were server-rendered with 'show'
      document.querySelectorAll('.collapse.show').forEach(collapseEl => {
        try {
          const bs = bootstrap.Collapse.getOrCreateInstance(collapseEl);
          bs.show();
          // Ensure the trigger aria-expanded is true for the previous sibling
          const trigger = collapseEl.previousElementSibling;
          if (trigger && trigger.classList.contains('card-trigger')) trigger.setAttribute('aria-expanded', 'true');
        } catch (e) {
          // ignore initialization errors
          console.warn('collapse init failed', e);
        }
      });
    });
  </script>
</body>
</html>